---
import PostList from "../components/PostList.astro";
import TaxonomyHeader from "../components/control/TaxonomyHeader.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import Canonical from "../components/misc/Canonical.astro";
---

<MainGridLayout
  title="|#{page.tag.title(${tag.spec.displayName})} - ${site.title}|"
  description="#{page.tag.description(${site.title}, ${tag.spec.displayName})}"
>
  <Fragment slot="head">
    <!-- SEO：canonical（解决带/不带尾斜杠的重复内容） -->
    <Canonical path="${tag.status.permalink}" />
  </Fragment>
  <!-- 页面 <title> 由 Layout.astro 统一输出，此处不再重复定义 -->
  <TaxonomyHeader
    labelExpr="#{page.tags.title}"
    label="标签"
    titleExpr="${tag.spec.displayName}"
    title="Tag"
  />
  <PostList />
</MainGridLayout>
