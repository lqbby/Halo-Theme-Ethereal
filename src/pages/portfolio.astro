---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import FilterTabs from "../components/control/FilterTabs.astro";
import PageHeader from "../components/control/PageHeader.astro";
import PortfolioCard from "../components/PortfolioCard.astro";
---

<MainGridLayout
  title="${(projectFinder.setting().seoTitle ?: #messages.msg('page.portfolio.seoTitle')) + ' - ' + site.title}"
  description="#{page.portfolio.description(${site.title})}"
>
  <!-- 页面 <title> 由 Layout.astro 统一输出，此处不再重复定义 -->
  <div
    th:remove="tag"
    th:with="platformLabels=${projectFinder.platformLabels()},
             typeLabels=${projectFinder.typeLabels()},
             platform=${#strings.isEmpty(param.platform) ? '' : param.platform},
             type=${#strings.isEmpty(param.type) ? '' : param.type},
             tag=${#strings.isEmpty(param.tag) ? '' : param.tag},
             projects=${projectFinder.listBy('', platform, type, tag, 1, 999)}"
  >
    <section class="card-base mb-4 px-6 py-6 md:px-9 onload-animation">
      <!-- 标题区域 -->
      <PageHeader
        containerClass="mb-6 flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between"
        titleExpr="${projectFinder.setting().seoTitle ?: #messages.msg('page.portfolio.seoTitle')}"
        title="作品集"
        iconClass="icon-[material-symbols--inventory-2-rounded]"
        labelExpr="#{page.portfolio.subtitle}"
        label="我的项目"
        subExpr="#{page.portfolio.subtitleCount(${projects.total})}"
        subShowIfExpr="${projects != null}"
        sub="0 个项目"
        filteredExpr="${not #strings.isEmpty(platform) or not #strings.isEmpty(type) or not #strings.isEmpty(tag)}"
      />

      <!-- 平台筛选：计数为 0 的选项不渲染（后台默认选项常含未使用的项，
           全列出来会让这一行在窄内容栏里堆成多排噪声）。
           showIfExpr 与 countExpr 都不能引用彼此——FilterTab 的 th:if 先于
           th:with 执行，故 showIfExpr 里直接调 Finder，不用 withExpr 的变量。 -->
      <FilterTabs
        showIfExpr="${platformLabels != null and not platformLabels.isEmpty()}"
        class="mb-4 flex flex-wrap gap-2"
        allHrefExpr="@{/portfolio(type=${type}, tag=${tag})}"
        allActiveExpr="#strings.isEmpty(platform)"
        allLabelExpr="#{page.portfolio.allPlatforms}"
        allLabel="全部平台"
        eachExpr="entry : ${platformLabels.entrySet()}"
        tabTemplate={{
          hrefExpr:
            "@{/portfolio(platform=${entry.key}, type=${type}, tag=${tag})}",
          activeExpr: "#strings.equals(platform, entry.key)",
          labelExpr: "${entry.value}",
          countExpr: "${platformCount.total}",
          showIfExpr:
            "${projectFinder.listByPlatform(entry.key, 1, 1).total > 0}",
          withExpr:
            "platformCount=${projectFinder.listByPlatform(entry.key, 1, 1)}",
        }}
      />

      <!-- 类型筛选 -->
      <FilterTabs
        showIfExpr="${typeLabels != null and not typeLabels.isEmpty()}"
        class="mb-6 flex flex-wrap gap-2"
        allHrefExpr="@{/portfolio(platform=${platform}, tag=${tag})}"
        allActiveExpr="#strings.isEmpty(type)"
        allLabelExpr="#{page.portfolio.allTypes}"
        allLabel="全部类型"
        eachExpr="entry : ${typeLabels.entrySet()}"
        tabTemplate={{
          hrefExpr:
            "@{/portfolio(platform=${platform}, type=${entry.key}, tag=${tag})}",
          activeExpr: "#strings.equals(type, entry.key)",
          labelExpr: "${entry.value}",
          countExpr: "${typeCount.total}",
          showIfExpr: "${projectFinder.listByType(entry.key, 1, 1).total > 0}",
          withExpr: "typeCount=${projectFinder.listByType(entry.key, 1, 1)}",
        }}
      />

      <!-- 标签筛选生效指示：详情页的技术栈 / 标签 chip 用同一个 `tag` 参数
           （插件对 tags 与 techStacks 做 Or 匹配），点 ✕ 只去掉标签条件、
           保留平台与类型，其余筛选不被牵连 -->
      <div th:if="${not #strings.isEmpty(tag)}" class="pf-active">
        <span class="pf-active__label" th:text="#{page.portfolio.tagFilter}"
          >标签筛选</span
        >
        <a
          th:href="@{/portfolio(platform=${platform}, type=${type})}"
          class="pf-active__chip"
          th:aria-label="${#messages.msg('page.portfolio.clearTagFilter')}"
        >
          <span class="icon-[material-symbols--sell-rounded]"></span>
          <span th:text="${tag}">Tech</span>
          <span class="icon-[material-symbols--close-rounded] pf-active__x"
          ></span>
        </a>
      </div>

      <!-- 页面内网格用容器查询分档：双侧栏布局下内容栏只有约 348px，
           视口媒体查询会误判成"宽屏"而排多列。容器查询挂在 .pf-page 上，
           卡片按「窄栏横向 / 宽栏纵向多列」两种形态自适应（见页面样式）。 -->
      <div class="pf-page">
        <!-- 推荐项目（仅无筛选时展示） -->
        <div
          th:remove="tag"
          th:if="${#strings.isEmpty(platform) and #strings.isEmpty(type) and #strings.isEmpty(tag)}"
        >
          <div
            th:remove="tag"
            th:with="featured=${projectFinder.featured(1, 6)}"
          >
            <div th:if="${featured != null and not featured.items.isEmpty()}">
              <h2 class="pf-sec">
                <span class="pf-sec__bar"></span>
                <span class="pf-sec__title"
                  ><span
                    class="icon-[material-symbols--star-rounded] pf-sec__icon"
                  ></span>
                  <span th:text="#{page.portfolio.featuredProjects}"
                    >推荐项目</span
                  ></span
                >
                <span class="pf-sec__line"></span>
              </h2>
              <div class="pf-grid">
                <div
                  class="contents"
                  th:each="project, stat : ${featured.items}"
                >
                  <PortfolioCard />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 全部项目：带分区标题，避免推荐区与全部区的同一项目看起来像重复渲染 -->
        <div th:if="${projects != null and not projects.items.isEmpty()}">
          <h2
            class="pf-sec"
            th:classappend="${#strings.isEmpty(platform) and #strings.isEmpty(type) and #strings.isEmpty(tag) ? '' : ' pf-sec--first'}"
          >
            <span class="pf-sec__bar"></span>
            <span class="pf-sec__title" th:text="#{page.portfolio.allProjects}"
              >全部项目</span
            >
            <span class="pf-sec__count" th:text="${projects.total}">0</span>
            <span class="pf-sec__line"></span>
          </h2>
          <div class="pf-grid">
            <div class="contents" th:each="project, stat : ${projects.items}">
              <PortfolioCard />
            </div>
          </div>
        </div>

        <!-- 空状态 -->
        <div
          th:if="${projects == null or projects.items.isEmpty()}"
          class="pf-empty"
        >
          <span
            class="icon-[material-symbols--folder-open-rounded] pf-empty__icon"
          ></span>
          <p class="pf-empty__text" th:text="#{page.portfolio.empty}">
            暂无项目
          </p>
          <a
            th:if="${not #strings.isEmpty(platform) or not #strings.isEmpty(type) or not #strings.isEmpty(tag)}"
            th:href="@{/portfolio}"
            class="pf-empty__link"
            th:text="#{page.portfolio.viewAll}">查看全部</a
          >
        </div>
      </div>
    </section>
  </div>
</MainGridLayout>

<style is:global>
  /* ==========================================================================
     项目集列表页
     --------------------------------------------------------------------------
     只有一种卡片形态：**纵向卡**（封面 2:1 置顶 + 正文），列数按内容栏宽度分档：
       手机（视口 < 768px）→ 恒为单列，封面接近满宽，图大且完整。
       >= 420px 内容栏 → 2 列 · >= 720px → 3 列 · >= 1040px → 4 列。
     ⚠️ 手机那一档**必须用视口媒体查询**：实测手机 480/540 视口下内容栏会被撑到
     438/498px，与桌面双侧栏的 482px 几乎重合，容器查询分不出「手机」和
     「桌面窄栏」。
     ⚠️ 曾经做过「窄栏横向卡（封面缩成左侧小色带）」——已废弃：480px 级手机上
     封面只剩 104×52，GitHub OG 图缩到那个尺寸字全糊；而且实测在 482px 下
     2 列纵向卡的行高（3 行 ≈770px）反而比横向卡单列（5 张 ≈808px）更省。
     封面一律 width:100% + height:auto（contain 语义），不裁切：本项目封面
     多为 GitHub OG 图（2:1、白底、图内含仓库名），裁切会把仓库名切碎。
     ========================================================================== */

  .pf-page {
    container-type: inline-size;
  }

  /* ── 标签筛选生效指示（详情页 chip 点进来的落点） ── */
  .pf-active {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.125rem;
  }
  .pf-active__label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: color-mix(in oklab, var(--deep-text) 55%, transparent);
  }
  .pf-active__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2rem;
    padding: 0 0.4375rem 0 0.625rem;
    border-radius: 0.625rem;
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    color: var(--primary);
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease;
  }
  .pf-active__chip:hover {
    background: color-mix(in oklab, var(--primary) 22%, transparent);
  }
  .pf-active__chip:active {
    transform: scale(0.97);
  }
  .pf-active__x {
    font-size: 1rem;
    opacity: 0.75;
  }

  /* ── 分区标题 ── */
  .pf-sec {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.375rem 0 0.75rem;
  }
  .pf-sec--first {
    margin-top: 0;
  }
  .pf-sec__bar {
    flex: 0 0 auto;
    width: 0.1875rem;
    height: 1rem;
    border-radius: 9999px;
    background: var(--primary);
  }
  .pf-sec__title {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--deep-text);
  }
  .pf-sec__icon {
    font-size: 1rem;
    color: var(--primary);
  }
  .pf-sec__count {
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--btn-content);
    background: var(--btn-regular-bg);
    border-radius: 0.375rem;
    padding: 0.0625rem 0.375rem;
  }
  .pf-sec__line {
    flex: 1 1 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--deep-text) 12%, transparent),
      transparent
    );
  }

  .pf-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* ── 卡片：纵向卡（封面 2:1 置顶 + 正文），列数由 .pf-grid 决定 ── */
  .pf-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--deep-text) 8%, transparent);
    border-radius: var(--radius-large);
    background: var(--card-bg);
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.3s ease;
  }
  .pf-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--primary) 40%, transparent);
    box-shadow: 0 16px 34px -24px
      color-mix(in oklab, var(--primary) 55%, transparent);
  }
  .pf-card:active {
    transform: translateY(-1px) scale(0.997);
  }
  .pf-card--featured {
    border-color: color-mix(in oklab, var(--primary) 30%, transparent);
    background: color-mix(in oklab, var(--primary) 3.5%, var(--card-bg));
  }

  /* ── 封面 ──
     一律 width:100% + height:auto（contain 语义），不裁切：本项目封面多为
     GitHub OG 图（2:1、白底、图内含仓库名），裁切会把仓库名切碎。 */
  .pf-card__cover {
    flex: 0 0 auto;
    align-self: stretch;
    aspect-ratio: 2 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklab, var(--primary) 6%, var(--card-bg));
  }
  .pf-card--featured .pf-card__cover {
    background: color-mix(in oklab, var(--primary) 10%, var(--card-bg));
  }
  .pf-card__cover img {
    width: 100%;
    height: auto;
    display: block;
  }
  .pf-card__cover--empty {
    aspect-ratio: 2 / 1;
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary);
  }

  /* ── 正文 ── */
  .pf-card__body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.9375rem 1.125rem 1.0625rem;
  }
  .pf-card__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3125rem;
  }
  .pf-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.1875rem;
    border-radius: 0.375rem;
    padding: 0.0625rem 0.375rem;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .pf-tag--featured {
    background: var(--primary);
    color: var(--on-primary);
  }
  .pf-tag--primary {
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    color: var(--primary);
  }
  .pf-tag--muted {
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    font-weight: 500;
  }
  .pf-card__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--deep-text);
    overflow-wrap: anywhere;
    transition: color 0.25s ease;
  }
  .pf-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .pf-card:hover .pf-card__title {
    color: var(--primary);
  }
  .pf-card__summary {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: color-mix(in oklab, var(--deep-text) 66%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pf-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .pf-tech {
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.6;
    border-radius: 0.375rem;
    padding: 0.0625rem 0.3125rem;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
  }
  .pf-tech--more {
    opacity: 0.7;
  }
  .pf-card__foot {
    margin-top: auto;
    padding-top: 0.4375rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border-top: 1px solid color-mix(in oklab, var(--deep-text) 8%, transparent);
    font-size: 0.6875rem;
    color: color-mix(in oklab, var(--deep-text) 55%, transparent);
  }
  .pf-card__links {
    display: flex;
    gap: 0.625rem;
    flex-shrink: 0;
  }
  .pf-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .pf-card__links a:hover {
    color: var(--primary);
  }

  /* ── 空状态 ── */
  .pf-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 3.5rem 0;
    text-align: center;
  }
  .pf-empty__icon {
    font-size: 3rem;
    color: color-mix(in oklab, var(--deep-text) 25%, transparent);
  }
  .pf-empty__text {
    margin: 0;
    font-size: 0.875rem;
    color: color-mix(in oklab, var(--deep-text) 55%, transparent);
  }
  .pf-empty__link {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
  }
  .pf-empty__link:hover {
    text-decoration: underline;
  }

  /* ── 宽内容栏：多列。列数按容器宽度分档（不能用 auto-fill：
     minmax 一改就会把 900px 挤成 4 列）。 ── */
  @container (min-width: 420px) {
    .pf-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  @container (min-width: 720px) {
    .pf-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @container (min-width: 1040px) {
    .pf-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ── 手机兜底：视口 < 768px 恒为单列大图卡 ──
     必须用视口媒体查询，容器查询在这里不够用：实测手机 480/540 视口下
     内容栏会被撑到 438/498px，与桌面双侧栏的 482px 几乎重合，靠宽度
     分不出「手机」和「桌面窄栏」。本块置于 @container 之后，同特异性
     下后者胜出。 */
  @media (max-width: 767px) {
    .pf-grid {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-card,
    .pf-card__title,
    .pf-card__cover img,
    .pf-active__chip {
      transition: none;
    }
    .pf-card:hover {
      transform: none;
    }
    .pf-active__chip:active {
      transform: none;
    }
  }
</style>
