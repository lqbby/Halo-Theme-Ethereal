---
// 关于我页面模板（Halo 自定义页面，自定义模板选 about）。
// 数据来自主题设置「扩展页面 → 关于我页面」→ theme.config.extendPages.about。
//
// 布局：身份卡（横跨）→ 顶部导航（横跨）→ 两栏
//   主列：关于我 / 本人项目 / 更新摘要 / 最近的提交
//   侧列：我的朋友 / 技术轨迹 / 保持联系 / 服务器状态
// 两栏按**容器宽度**分档（≥880px 才分栏），不跟视口走 —— 见 .about-cols-wrap。
// 多行字段（正文/标签/联系方式/监控指标）由 extend-pages.js 在客户端渲染。
// 友链取自 Halo 友链插件的 groups（按需随机展示 N 个）。
import MainGridLayout from "../layouts/MainGridLayout.astro";
import Canonical from "../components/misc/Canonical.astro";
---

<MainGridLayout
  title="${singlePage.spec.title + ' - ' + site.title}"
  description="#{page.about.description(${site.title})}"
>
  <Fragment slot="head">
    <Canonical path="${singlePage.status.permalink}" />
    <style is:global>
      /* ================= 页头：身份卡 ================= */
      .about-hero-card {
        position: relative;
        overflow: hidden;
        padding: 26.4px;
      }
      /* 顶部一层主题色柔光，呼应个人主页的「身份卡」气质 */
      .about-hero-card::after {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 7rem;
        background: linear-gradient(
          to bottom,
          color-mix(in oklab, var(--primary) 14%, transparent),
          transparent
        );
        pointer-events: none;
      }
      .about-avatar {
        position: relative;
        z-index: 1;
        width: 5.5rem;
        height: 5.5rem;
        border-radius: 1.25rem;
        object-fit: cover;
        background: linear-gradient(
          135deg,
          var(--btn-regular-bg-hover),
          var(--btn-regular-bg)
        );
        box-shadow:
          0 0 0 3px var(--card-bg),
          0 0 0 4px color-mix(in oklab, var(--primary) 35%, transparent);
      }

      /* ================= 页头：身份卡按钮 ================= */
      .about-hero-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 100%;
      }
      @media (min-width: 640px) {
        .about-hero-actions {
          width: auto;
          align-items: stretch;
        }
      }
      .about-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        text-decoration: none;
        transition: all 0.25s ease;
      }
      .about-ico {
        width: 1.05em;
        height: 1.05em;
        flex-shrink: 0;
      }
      .about-ico--xs {
        width: 0.85em;
        height: 0.85em;
        opacity: 0.75;
      }
      /* 主按钮 —— 与「心愿墙」页 .wish-bar-btn 同款 */
      .about-btn--primary {
        background: var(--primary);
        color: #fff;
        border: none;
        box-shadow: 0 2px 8px
          color-mix(in oklab, var(--primary) 40%, transparent);
      }
      :root.dark .about-btn--primary {
        color: rgb(0 0 0 / 0.7);
      }
      .about-btn--primary:hover {
        background: color-mix(in oklab, var(--primary) 85%, #000);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px
          color-mix(in oklab, var(--primary) 50%, transparent);
      }
      :root.dark .about-btn--primary:hover {
        background: color-mix(in oklab, var(--primary) 85%, #fff);
      }
      /* 次按钮 —— 描边 + 半透明底，尺寸与主按钮对齐 */
      .about-btn--ghost {
        background: var(--btn-regular-bg);
        color: var(--btn-content);
        border: 1px solid var(--line-color);
      }
      .about-btn--ghost:hover {
        background: var(--btn-regular-bg-hover);
        color: var(--primary);
        border-color: color-mix(in oklab, var(--primary) 45%, transparent);
        transform: translateY(-1px);
      }

      /* ================= 顶部导航（长条菜单） ================= */
      /* 容器直接用主题的 .card-base：无边框、有底色、有圆角与纹理 */
      .about-subnav {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        gap: 4px;
        overflow-x: auto;
      }
      .about-subnav-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 6.72px;
        padding: 12.48px 14.4px 10.88px;
        border-radius: 11.52px 11.52px 0 0;
        font-size: 12.8px;
        font-weight: 680;
        line-height: 1.5;
        white-space: nowrap;
        text-decoration: none;
        color: color-mix(in oklab, currentColor 60%, transparent);
        transition:
          color 0.18s,
          border-color 0.18s,
          background-color 0.18s;
      }
      .about-subnav-item .about-ico {
        width: 1.12em;
        height: 1.12em;
        opacity: 0.9;
      }
      .about-subnav-item em {
        font-style: normal;
        font-size: 10.5px;
        font-weight: 700;
        line-height: 1;
        padding: 2px 6px;
        border-radius: 999px;
        background: color-mix(in oklab, var(--primary) 16%, transparent);
        color: var(--primary);
      }
      .about-subnav-item:hover {
        color: var(--primary);
        background: color-mix(in oklab, var(--primary) 7%, transparent);
      }
      /* active：主色文字 + 底部 3px 下划线 */
      .about-subnav-item.is-active {
        color: var(--primary);
        background: color-mix(in oklab, var(--primary) 6%, transparent);
      }
      .about-subnav-item.is-active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 3px;
        border-radius: 3px;
        background: var(--primary);
      }
      .about-subnav-item.is-active .about-ico {
        opacity: 1;
      }

      /* ================= 两栏布局（按容器宽度分档） ================= */
      .about-cols-wrap {
        container-type: inline-size;
      }
      .about-cols {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
        align-items: start;
      }
      /* 内容列自身够宽（≥880px）才分两栏 —— 中等宽度下自动单列，卡片不至于挤成一条 */
      @container (min-width: 880px) {
        .about-cols {
          grid-template-columns: minmax(0, 1fr) 288px;
        }
      }
      /* 卡片内边距对齐参考站实测值：主列 23.2px / 侧列 16px / 身份卡 26.4px，圆角 16px */
      .about-col-main > section {
        padding: 23.2px;
      }
      .about-col-side > section {
        padding: 16px;
      }
      .about-cols > .about-col-main > section,
      .about-cols > .about-col-side > section {
        border-radius: 16px;
      }
      .about-col-main,
      .about-col-side {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-width: 0;
      }
      /* 主列卡片头自带分隔线（两列统一观感） */
      .about-col-main > section > .mb-5:first-child {
        padding-bottom: 12px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--line-color);
      }

      /* ================= 小区块标签（kicker） ================= */
      .about-section-label {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--primary);
      }

      /* ================= 引语 ================= */
      .about-quote {
        border-left: 3px solid
          color-mix(in oklab, var(--primary) 55%, transparent);
        background: color-mix(in oklab, var(--primary) 5%, transparent);
        border-radius: 0 0.6rem 0.6rem 0;
      }

      /* ================= 本人项目 ================= */
      .about-proj-grid {
        display: grid;
        gap: 12px;
        /* 主列项目卡固定 2 列 */
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (max-width: 640px) {
        .about-proj-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      .about-proj {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--line-color);
        border-radius: 0.9rem;
        background: color-mix(in oklab, var(--card-bg) 92%, transparent);
        text-decoration: none;
        transition:
          border-color 0.2s,
          transform 0.2s,
          background-color 0.2s;
      }
      .about-proj:hover {
        border-color: color-mix(in oklab, var(--primary) 45%, transparent);
        background: color-mix(in oklab, var(--primary) 4%, transparent);
        transform: translateY(-2px);
      }
      .about-proj__thumb {
        display: block;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--btn-regular-bg);
      }
      .about-proj__thumb img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .about-proj__body {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 12px 14px 14px;
        min-width: 0;
      }
      .about-proj__title {
        font-size: 15px;
        font-weight: 700;
        line-height: 1.3;
      }
      .about-proj__desc {
        font-size: 12.5px;
        line-height: 1.6;
      }
      .about-proj__tech {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 2px;
      }
      .about-proj__tech i {
        font-style: normal;
        font-size: 10.5px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 999px;
        background: var(--btn-regular-bg);
        color: var(--btn-content);
      }

      /* ================= 更新摘要条目 / 动态条目通用抬升 ================= */
      .about-tile {
        border: 1px solid var(--line-color);
        border-radius: 0.9rem;
        transition:
          border-color 0.2s ease,
          transform 0.2s ease,
          background-color 0.2s ease;
      }
      .about-tile:hover {
        border-color: color-mix(in oklab, var(--primary) 45%, transparent);
        background: color-mix(in oklab, var(--primary) 4%, transparent);
        transform: translateY(-2px);
      }

      /* ================= 侧列卡片头（图标 + 标题 + 可选尾标） ================= */
      .about-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 12px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--line-color);
      }
      .about-head-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        flex-shrink: 0;
        font-size: 20px;
        line-height: 1;
      }
      .about-card-title {
        font-size: 16px;
        font-weight: 700;
        line-height: 1.3;
      }

      /* ================= 我的朋友 ================= */
      .about-friends {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
      }
      .about-friend {
        display: block;
        max-width: 100%;
        padding: 5px 4px;
        border-radius: 999px;
        border: 1px solid color-mix(in oklab, var(--primary) 38%, transparent);
        background: color-mix(in oklab, var(--primary) 8%, transparent);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.35;
        text-align: center;
        color: var(--primary);
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition:
          color 0.2s,
          border-color 0.2s,
          background-color 0.2s;
      }
      .about-friend:hover {
        border-color: color-mix(in oklab, var(--primary) 70%, transparent);
        background: color-mix(in oklab, var(--primary) 16%, transparent);
      }
      /* 侧列其它卡的标签统一成同款观感（标签是主色） */
      .about-col-side [data-lines-render="tags"] > * {
        border-color: color-mix(
          in oklab,
          var(--primary) 38%,
          transparent
        ) !important;
        background: color-mix(
          in oklab,
          var(--primary) 8%,
          transparent
        ) !important;
        color: var(--primary) !important;
      }

      /* ================= 保持联系：社交入口 ================= */
      .about-contact-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }
      .about-contact {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
        padding: 9px 10px;
        border-radius: 10px;
        border: 1px solid color-mix(in oklab, var(--primary) 30%, transparent);
        background: color-mix(in oklab, var(--primary) 7%, transparent);
        color: var(--primary);
        font-size: 12.5px;
        font-weight: 600;
        line-height: 1.2;
        text-decoration: none;
        transition:
          color 0.2s,
          border-color 0.2s,
          background-color 0.2s,
          transform 0.2s;
      }
      .about-contact:hover {
        border-color: color-mix(in oklab, var(--primary) 55%, transparent);
        background: color-mix(in oklab, var(--primary) 14%, transparent);
        transform: translateY(-1px);
      }
      .about-contact-icon {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        line-height: 1;
      }
      .about-contact-name {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
      }
      .about-card-foot {
        margin: 12px 0 0;
        font-size: 11.5px;
        line-height: 1.5;
        opacity: 0.6;
      }

      /* ================= 服务器状态（占位） ================= */
      .about-stub-chip {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 999px;
        color: color-mix(in oklab, currentColor 55%, transparent);
        background: var(--btn-regular-bg);
      }
      .about-stub-chip--end {
        margin-left: auto;
      }
      .about-stub-row {
        padding: 10px 12px;
        border-radius: 10px;
        background: var(--btn-regular-bg);
      }
      .about-stub-head {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12.5px;
        color: color-mix(in oklab, currentColor 62%, transparent);
      }
      .about-stub-head > span:first-child {
        flex-shrink: 0;
      }
      .about-stub-bar {
        flex: 1;
        height: 6px;
        border-radius: 999px;
        background: color-mix(in oklab, currentColor 12%, transparent);
        overflow: hidden;
      }
      .about-stub-bar > i {
        display: block;
        height: 100%;
        border-radius: 999px;
        background: var(--primary);
      }
      .about-stub-val {
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
        opacity: 0.7;
      }
    </style>
  </Fragment>

  <div th:with="cfg=${theme.config?.extendPages?.about}" th:remove="tag">
    <!-- ================= ① 身份卡 ================= -->
    <section class="card-base about-hero-card onload-animation mb-4">
      <div class="relative z-1 flex flex-col gap-5 sm:flex-row sm:items-center">
        <img
          class="about-avatar shrink-0"
          th:if="${cfg?.avatar != null and !#strings.isEmpty(cfg?.avatar)}"
          th:src="${cfg?.avatar}"
          th:alt="${cfg?.name ?: site.title}"
          src=""
          alt="avatar"
        />
        <div class="min-w-0 flex-1">
          <h1
            class="mb-1.5 text-3xl font-bold text-90 md:text-4xl"
            th:text="${cfg?.name != null and !#strings.isEmpty(cfg?.name) ? cfg?.name : site.title}"
          >
            关于我
          </h1>
          <p
            class="mb-3 text-sm font-bold text-(--primary)"
            th:if="${cfg?.roles != null and !#strings.isEmpty(cfg?.roles)}"
            th:text="${cfg?.roles}"
          >
            身份
          </p>
          <p
            class="mb-2 text-base leading-relaxed text-75 md:text-lg"
            th:if="${cfg?.tagline != null and !#strings.isEmpty(cfg?.tagline)}"
            th:text="${cfg?.tagline}"
          >
            一句话简介
          </p>
          <p
            class="inline-flex items-center gap-1.5 text-xs text-50"
            th:if="${cfg?.status != null and !#strings.isEmpty(cfg?.status)}"
          >
            <span
              class="icon-[material-symbols--bolt-rounded] text-sm text-(--primary)"
              aria-hidden="true"></span>
            <span th:text="${cfg?.status}">状态</span>
          </p>
        </div>

        <div
          class="about-hero-actions"
          th:if="${(cfg?.actionPrimaryLabel != null and !#strings.isEmpty(cfg?.actionPrimaryLabel) and cfg?.actionPrimaryUrl != null and !#strings.isEmpty(cfg?.actionPrimaryUrl)) or (cfg?.actionSecondaryLabel != null and !#strings.isEmpty(cfg?.actionSecondaryLabel) and cfg?.actionSecondaryUrl != null and !#strings.isEmpty(cfg?.actionSecondaryUrl))}"
        >
          <a
            class="about-btn about-btn--primary"
            th:if="${cfg?.actionPrimaryLabel != null and !#strings.isEmpty(cfg?.actionPrimaryLabel) and cfg?.actionPrimaryUrl != null and !#strings.isEmpty(cfg?.actionPrimaryUrl)}"
            th:href="${cfg?.actionPrimaryUrl}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="icon-[mdi--github] about-ico" aria-hidden="true"
            ></span>
            <span th:text="${cfg?.actionPrimaryLabel}">查看 GitHub</span>
            <span
              class="icon-[material-symbols--open-in-new-rounded] about-ico about-ico--xs"
              aria-hidden="true"></span>
          </a>
          <a
            class="about-btn about-btn--ghost"
            th:if="${cfg?.actionSecondaryLabel != null and !#strings.isEmpty(cfg?.actionSecondaryLabel) and cfg?.actionSecondaryUrl != null and !#strings.isEmpty(cfg?.actionSecondaryUrl)}"
            th:href="${cfg?.actionSecondaryUrl}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span
              class="icon-[material-symbols--star-rounded] about-ico"
              aria-hidden="true"></span>
            <span th:text="${cfg?.actionSecondaryLabel}">查看心愿墙</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= ② 顶部导航（长条菜单） ================= -->
    <nav
      class="card-base about-subnav onload-animation mb-4"
      aria-label="关于我相关页面"
    >
      <a
        class="about-subnav-item is-active"
        th:href="${singlePage.status.permalink}"
        aria-current="page"
      >
        <span
          class="icon-[material-symbols--person-rounded] about-ico"
          aria-hidden="true"></span>
        <span
          th:text="${cfg?.navProfileLabel != null and !#strings.isEmpty(cfg?.navProfileLabel) ? cfg?.navProfileLabel : '个人资料'}"
          >个人资料</span
        >
      </a>
      <a
        class="about-subnav-item"
        th:if="${cfg?.navChangelogUrl != null and !#strings.isEmpty(cfg?.navChangelogUrl)}"
        th:href="${cfg?.navChangelogUrl}"
      >
        <span
          class="icon-[material-symbols--history-rounded] about-ico"
          aria-hidden="true"></span>
        <span
          th:text="${cfg?.navChangelogLabel != null and !#strings.isEmpty(cfg?.navChangelogLabel) ? cfg?.navChangelogLabel : '博客日志'}"
          >博客日志</span
        >
      </a>
      <a
        class="about-subnav-item"
        th:if="${cfg?.navLinksUrl != null and !#strings.isEmpty(cfg?.navLinksUrl)}"
        th:href="${cfg?.navLinksUrl}"
      >
        <span
          class="icon-[material-symbols--link-rounded] about-ico"
          aria-hidden="true"></span>
        <span
          th:text="${cfg?.navLinksLabel != null and !#strings.isEmpty(cfg?.navLinksLabel) ? cfg?.navLinksLabel : '友链'}"
          >友链</span
        >
        <em
          th:if="${cfg?.navLinksCount != false and groups != null and !#lists.isEmpty(groups)}"
          th:text="${#aggregates.sum(groups.![links.size()])}">0</em
        >
      </a>
      <a
        class="about-subnav-item"
        th:if="${cfg?.navFriendsUrl != null and !#strings.isEmpty(cfg?.navFriendsUrl)}"
        th:href="${cfg?.navFriendsUrl}"
      >
        <span
          class="icon-[material-symbols--rss-feed-rounded] about-ico"
          aria-hidden="true"></span>
        <span
          th:text="${cfg?.navFriendsLabel != null and !#strings.isEmpty(cfg?.navFriendsLabel) ? cfg?.navFriendsLabel : '朋友圈'}"
          >朋友圈</span
        >
      </a>
    </nav>

    <!-- ================= ③ 两栏正文 ================= -->
    <div class="about-cols-wrap">
      <div class="about-cols">
        <!-- ---------- 主列 ---------- -->
        <div class="about-col-main">
          <!-- 关于我 -->
          <section class="card-base onload-animation">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
              <div>
                <h2 class="mt-1 text-xl font-bold text-90">关于我</h2>
              </div>
              <span
                class="text-xs text-50"
                th:if="${cfg?.introSubtitle != null and !#strings.isEmpty(cfg?.introSubtitle)}"
                th:text="${cfg?.introSubtitle}">公开 · 持续更新</span
              >
            </div>
            <blockquote
              class="about-quote mb-4 px-4 py-3 text-sm leading-relaxed text-75 italic"
              th:if="${cfg?.quote != null and !#strings.isEmpty(cfg?.quote)}"
              th:text="${cfg?.quote}"
            >
              引语
            </blockquote>
            <div
              class="about-paragraphs"
              th:if="${cfg?.intro != null and !#strings.isEmpty(cfg?.intro)}"
              th:data-lines="${cfg?.intro}"
              data-lines-render="paragraphs"
            >
            </div>
          </section>

          <!-- 本人项目 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.projects?.items != null and !#lists.isEmpty(cfg?.projects?.items)}"
          >
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
              <div>
                <p class="about-section-label">
                  <span
                    class="icon-[material-symbols--widgets-outline-rounded]"
                    aria-hidden="true"></span>
                  <span>MY PROJECTS</span>
                </p>
                <h2 class="mt-1 text-xl font-bold text-90">本人项目</h2>
              </div>
              <a
                class="text-xs font-bold text-(--primary) transition-opacity hover:opacity-80"
                th:if="${cfg?.projects?.moreUrl != null and !#strings.isEmpty(cfg?.projects?.moreUrl)}"
                th:href="${cfg?.projects?.moreUrl}"
              >
                <span
                  th:text="${cfg?.projects?.moreLabel != null and !#strings.isEmpty(cfg?.projects?.moreLabel) ? cfg?.projects?.moreLabel : '全部项目 →'}"
                  >全部项目 →</span
                >
              </a>
            </div>
            <div class="about-proj-grid">
              <a
                class="about-proj"
                th:each="p : ${cfg?.projects?.items}"
                th:href="${p?.link != null and !#strings.isEmpty(p?.link) ? p?.link : null}"
                th:target="${p?.link != null and !#strings.isEmpty(p?.link) ? '_blank' : null}"
                rel="noopener noreferrer"
              >
                <span
                  class="about-proj__thumb"
                  th:if="${p?.thumb != null and !#strings.isEmpty(p?.thumb)}"
                >
                  <img th:src="${p?.thumb}" alt="" loading="lazy" />
                </span>
                <span class="about-proj__body">
                  <span class="about-proj__title text-90" th:text="${p?.title}"
                    >项目名</span
                  >
                  <span
                    class="about-proj__desc text-75"
                    th:if="${p?.description != null and !#strings.isEmpty(p?.description)}"
                    th:text="${p?.description}">说明</span
                  >
                  <span
                    class="about-proj__tech"
                    th:if="${p?.tags != null and !#strings.isEmpty(p?.tags)}"
                    th:data-lines="${p?.tags}"
                    data-lines-render="projTech"></span>
                </span>
              </a>
            </div>
          </section>

          <!-- 更新摘要 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.highlights?.items != null and !#lists.isEmpty(cfg?.highlights?.items)}"
          >
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
              <div>
                <p class="about-section-label">
                  <span
                    class="icon-[material-symbols--update-rounded]"
                    aria-hidden="true"></span>
                  <span>LATEST CHANGES</span>
                </p>
                <h2 class="mt-1 text-xl font-bold text-90">更新摘要</h2>
              </div>
              <a
                class="text-xs font-bold text-(--primary) transition-opacity hover:opacity-80"
                th:if="${cfg?.highlights?.moreUrl != null and !#strings.isEmpty(cfg?.highlights?.moreUrl)}"
                th:href="${cfg?.highlights?.moreUrl}"
              >
                <span
                  th:text="${cfg?.highlights?.moreLabel != null and !#strings.isEmpty(cfg?.highlights?.moreLabel) ? cfg?.highlights?.moreLabel : '按日查看 →'}"
                  >按日查看 →</span
                >
              </a>
            </div>
            <div class="flex flex-col gap-3">
              <a
                class="about-tile block px-4 py-4"
                th:each="h : ${cfg?.highlights?.items}"
                th:href="${h?.link != null and !#strings.isEmpty(h?.link) ? h?.link : null}"
                th:target="${h?.link != null and !#strings.isEmpty(h?.link) ? '_blank' : null}"
                rel="noopener noreferrer"
              >
                <div class="mb-1.5 flex flex-wrap items-center gap-2">
                  <h3 class="text-base font-bold text-90" th:text="${h?.title}">
                    标题
                  </h3>
                  <span
                    class="rounded-md bg-(--btn-regular-bg) px-1.5 py-0.5 font-mono text-[0.7rem] font-bold text-(--btn-content)"
                    th:if="${h?.version != null and !#strings.isEmpty(h?.version)}"
                    th:text="${h?.version}">v0.0.0</span
                  >
                </div>
                <p
                  class="mb-3 text-sm leading-relaxed text-75"
                  th:if="${h?.description != null and !#strings.isEmpty(h?.description)}"
                  th:text="${h?.description}"
                >
                  说明
                </p>
                <div
                  class="flex flex-wrap gap-1.5"
                  th:if="${h?.tags != null and !#strings.isEmpty(h?.tags)}"
                  th:data-lines="${h?.tags}"
                  data-lines-render="chips"
                >
                </div>
              </a>
            </div>
          </section>

          <!-- 最近的提交 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.activity?.items != null and !#lists.isEmpty(cfg?.activity?.items)}"
          >
            <div class="mb-5">
              <p class="about-section-label">
                <span
                  class="icon-[material-symbols--history-rounded]"
                  aria-hidden="true"></span>
                <span>RECENT ACTIVITY</span>
              </p>
              <h2 class="mt-1 text-xl font-bold text-90">最近的提交</h2>
              <p
                class="mt-1 text-xs text-50"
                th:if="${cfg?.activity?.subtitle != null and !#strings.isEmpty(cfg?.activity?.subtitle)}"
                th:text="${cfg?.activity?.subtitle}"
              >
                写下来的，才会留下
              </p>
            </div>
            <ul class="flex flex-col gap-2">
              <li
                class="flex items-start gap-2.5"
                th:each="a : ${cfg?.activity?.items}"
              >
                <span
                  class="mt-0.5 shrink-0 rounded-md bg-(--btn-regular-bg) px-1.5 py-0.5 text-[0.7rem] font-bold text-(--btn-content)"
                  th:text="${a?.type != null and !#strings.isEmpty(a?.type) ? a?.type : '动态'}"
                  >类型</span
                >
                <a
                  class="min-w-0 flex-1 text-sm text-75 transition-colors hover:text-(--primary)"
                  th:href="${a?.link != null and !#strings.isEmpty(a?.link) ? a?.link : null}"
                  th:target="${a?.link != null and !#strings.isEmpty(a?.link) ? '_blank' : null}"
                  rel="noopener noreferrer"
                  th:text="${a?.title}"
                >
                  标题
                </a>
              </li>
            </ul>
          </section>
        </div>

        <!-- ---------- 侧列 ---------- -->
        <div class="about-col-side">
          <!-- 我的朋友（数据取自本站友情链接，可随机） -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.friendsEnable != false and groups != null and !#lists.isEmpty(groups)}"
          >
            <div class="about-card-head">
              <span class="about-head-icon">
                <span
                  class="icon-[material-symbols--group-rounded]"
                  aria-hidden="true"></span>
              </span>
              <h2 class="about-card-title text-90">我的朋友</h2>
            </div>
            <div
              class="about-friends"
              th:attr="data-shuffle=${cfg?.friendsShuffle != false ? 'true' : null},data-count=${cfg?.friendsCount != null ? cfg?.friendsCount : 6}"
            >
              <div th:each="g : ${groups}" th:remove="tag">
                <a
                  class="about-friend"
                  th:each="l : ${g?.links}"
                  th:href="${l?.spec?.url != null and (l?.spec?.url.startsWith('http') or l?.spec?.url.startsWith('//') or l?.spec?.url.startsWith('/')) ? l?.spec?.url : null}"
                  th:title="${l?.spec?.description != null and !#strings.isEmpty(l?.spec?.description) ? l?.spec?.description : l?.spec?.displayName}"
                  target="_blank"
                  rel="noopener noreferrer"
                  th:text="${l?.spec?.displayName}">链接</a
                >
              </div>
            </div>
            <p
              class="mt-3 text-xs text-50"
              th:if="${cfg?.friendsNote != null and !#strings.isEmpty(cfg?.friendsNote)}"
              th:text="${cfg?.friendsNote}"
            >
              各自折腾，互相串门。
            </p>
          </section>

          <!-- 技术轨迹 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.trajectory != null and !#strings.isEmpty(cfg?.trajectory)}"
          >
            <div class="about-card-head">
              <span class="about-head-icon">
                <span
                  class="icon-[material-symbols--terminal-rounded]"
                  aria-hidden="true"></span>
              </span>
              <h2 class="about-card-title text-90">技术轨迹</h2>
            </div>
            <div
              class="flex flex-wrap gap-2"
              th:data-lines="${cfg?.trajectory}"
              data-lines-render="tags"
            >
            </div>
            <p class="mt-3 text-xs text-50">
              工具会变化，解决问题的方式会留下。
            </p>
          </section>

          <!-- 保持联系 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.contact != null and !#strings.isEmpty(cfg?.contact)}"
          >
            <div class="about-card-head">
              <span class="about-head-icon">
                <span
                  class="icon-[material-symbols--handshake-rounded]"
                  aria-hidden="true"></span>
              </span>
              <h2 class="about-card-title text-90">保持联系</h2>
            </div>
            <div
              class="about-contact-grid"
              th:data-lines="${cfg?.contact}"
              data-lines-render="contacts"
            >
            </div>
            <p class="about-card-foot">欢迎来串门，一起交流。</p>
          </section>

          <!-- 服务器状态（占位，数据待接入） -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.serverEnable != false and cfg?.serverRows != null and !#strings.isEmpty(cfg?.serverRows)}"
          >
            <div class="about-card-head">
              <span class="about-head-icon">
                <span
                  class="icon-[material-symbols--dns-rounded]"
                  aria-hidden="true"></span>
              </span>
              <h2 class="about-card-title text-90">服务器状态</h2>
              <span
                class="about-stub-chip about-stub-chip--end"
                th:if="${cfg?.serverBadge != null and !#strings.isEmpty(cfg?.serverBadge)}"
                th:text="${cfg?.serverBadge}">待接入</span
              >
            </div>
            <div
              class="flex flex-col gap-4"
              th:data-lines="${cfg?.serverRows}"
              data-lines-render="stubRows"
            >
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- ================= ④ 页脚卡 ================= -->
    <section
      class="card-base onload-animation mb-4 flex flex-col gap-4 px-6 py-6 sm:flex-row sm:items-center sm:justify-between md:px-9"
      th:if="${(cfg?.footerMotto != null and !#strings.isEmpty(cfg?.footerMotto)) or (cfg?.footerLinks != null and !#strings.isEmpty(cfg?.footerLinks))}"
    >
      <div class="min-w-0">
        <p
          class="about-section-label"
          th:if="${cfg?.footerEyebrow != null and !#strings.isEmpty(cfg?.footerEyebrow)}"
          th:text="${cfg?.footerEyebrow}"
        >
          OPEN SOURCE, OPEN CHANNEL
        </p>
        <p
          class="mt-1.5 text-base font-bold text-90"
          th:if="${cfg?.footerMotto != null and !#strings.isEmpty(cfg?.footerMotto)}"
          th:text="${cfg?.footerMotto}"
        >
          页脚一句话
        </p>
      </div>
      <div
        class="flex flex-wrap gap-2"
        th:if="${cfg?.footerLinks != null and !#strings.isEmpty(cfg?.footerLinks)}"
        th:data-lines="${cfg?.footerLinks}"
        data-lines-render="links"
      >
      </div>
    </section>
  </div>

  <!-- 多行字段渲染（正文 / 项目技术栈 / 联系方式 / 监控指标 / 标签）+ 友链随机 -->
  <script
    is:inline
    src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/extend-pages.js?v=${ASSET_VERSION}`}
    defer></script>
</MainGridLayout>
