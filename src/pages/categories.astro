---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="|#{page.categories.title} - ${site.title}|"
  description="#{page.categories.description(${site.title})}"
>
  <!-- 页面 <title> 由 Layout.astro 统一输出，此处不再重复定义 -->
  <h1 class="sr-only" th:text="#{page.categories.title}">分类</h1>

  <!-- 段一：头部卡片（分类 + 共 N 个分类，与 tags 页同款简洁风格） -->
  <div class="card-base px-8 py-6 mb-4">
    <div
      class="text-2xl font-bold text-(--primary) mb-2"
      th:text="#{page.categories.title}"
    >
      分类
    </div>
    <p
      class="text-30 text-sm"
      th:text="#{page.categories.subtitleCount(${#lists.size(categories)})}"
    >
      共 0 个分类
    </p>
  </div>

  <!-- 段二：分类胶囊墙卡片（错峰入场 + 文章数数字滚动） -->
  <div class="card-base onload-animation flex flex-wrap gap-3 px-9 py-6">
    <a
      th:each="category, stat : ${categories}"
      th:href="@{${category.status.permalink}}"
      th:attr="data-name=${category.spec.displayName},data-count=${category.postCount ?: 0}"
      th:aria-label="|${category.spec.displayName} - ${category.postCount ?: 0}|"
      th:style="|animation-delay: min(calc(var(--content-delay) + ${stat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
      class="cat-pill group relative overflow-hidden rounded-full px-4 py-2.5 text-sm font-bold transition duration-300 active:scale-95"
    >
      <!-- 主题色小圆点 -->
      <span class="cat-pill-dot" aria-hidden="true"></span>
      <!-- 名称 -->
      <span class="cat-pill-name" th:text="${category.spec.displayName}"
        >分类</span
      >
      <!-- 文章数徽章（JS 数字滚动） -->
      <span
        class="cat-pill-count"
        th:attr="data-count=${category.postCount ?: 0}"
        th:text="${category.postCount ?: 0}">0</span
      >
    </a>
  </div>

  <!-- 互动脚本：文章数数字滚动 -->
  <script is:inline>
    (function () {
      var counts = document.querySelectorAll(".cat-pill-count[data-count]");
      function animate(el, target) {
        var dur = 550;
        var start = null;
        function tick(now) {
          if (start == null) start = now;
          var p = Math.min((now - start) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased);
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }
      if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                animate(
                  en.target,
                  Number(en.target.getAttribute("data-count")) || 0,
                );
                io.unobserve(en.target);
              }
            });
          },
          { threshold: 0.4 },
        );
        counts.forEach(function (c) {
          io.observe(c);
        });
      } else {
        counts.forEach(function (c) {
          c.textContent = c.getAttribute("data-count") || 0;
        });
      }
    })();
  </script>

  <style is:global>
    /* ── 分类胶囊（半透明毛玻璃 + 统一主题色，对齐 Firefly 风格） ── */
    .cat-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      /* 半透明毛玻璃：主题色淡底 + backdrop 模糊，深浅色均通透精致 */
      background: color-mix(in srgb, var(--primary) 7%, transparent);
      -webkit-backdrop-filter: blur(12px) saturate(140%);
      backdrop-filter: blur(12px) saturate(140%);
      color: var(--btn-content);
      border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
      transition:
        transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease;
    }
    .cat-pill:hover {
      transform: translateY(-3px);
      color: #fff;
      border-color: transparent;
      background: linear-gradient(
        135deg,
        var(--primary),
        color-mix(in srgb, var(--primary) 72%, black)
      );
      box-shadow:
        0 10px 24px -8px color-mix(in srgb, var(--primary) 55%, transparent),
        0 3px 8px -3px rgb(0 0 0 / 0.14);
    }
    /* 主题色小圆点 */
    .cat-pill-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 9999px;
      flex-shrink: 0;
      background: var(--primary);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent);
      transition: box-shadow 0.25s ease;
    }
    .cat-pill:hover .cat-pill-dot {
      box-shadow: 0 0 0 3px rgb(255 255 255 / 0.3);
    }
    /* 名称 */
    .cat-pill-name {
      line-height: 1.2;
    }
    /* 文章数徽章：默认主题色淡底 → hover 白底反色 */
    .cat-pill-count {
      font-size: 0.75rem;
      font-weight: 700;
      line-height: 1;
      padding: 0.25rem 0.5rem;
      border-radius: 9999px;
      font-variant-numeric: tabular-nums;
      background: color-mix(in srgb, var(--primary) 13%, transparent);
      color: var(--primary);
      transition:
        background 0.25s ease,
        color 0.25s ease;
    }
    .cat-pill:hover .cat-pill-count {
      background: rgb(255 255 255 / 0.22);
      color: #fff;
    }
    /* 可访问性 */
    .cat-pill:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }
  </style>
</MainGridLayout>
