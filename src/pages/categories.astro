---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="|#{page.categories.title} - ${site.title}|"
  description="#{page.categories.description(${site.title})}"
>
  <!-- ===== 分类页（UI 重设计 v2：Firefly 风格分类胶囊墙） =====
       参考 firefly.cuteleaf.cn/categories 的胶囊导航语言：
       - 主体 = 分类胶囊（pill）墙，flex-wrap 自动换行
       - 默认 outline 态 → hover 填充分类色相渐变 + 上浮 + 光晕
       - 保留 Ethereal 动效：色相 hash / 鼠标光效 / 数字滚动 / 错峰入场 -->

  <!-- ── Hero：简洁标题 + 统计 + 装饰光晕 ── -->
  <section
    class="cat-hero card-base onload-animation relative mb-5 overflow-hidden px-6 py-7 md:px-9"
  >
    <span class="cat-hero-glow cat-hero-glow-a" aria-hidden="true"></span>
    <span class="cat-hero-glow cat-hero-glow-b" aria-hidden="true"></span>
    <div class="relative flex items-center gap-4">
      <div class="cat-hero-icon">
        <span
          class="icon-[material-symbols--folder-open-rounded] text-[1.625rem]"
        ></span>
      </div>
      <div class="min-w-0">
        <h1
          class="cat-hero-title text-3xl font-bold text-90 md:text-4xl"
          th:text="#{page.categories.title}"
        >
          分类
        </h1>
        <div class="mt-1.5 flex flex-wrap items-center gap-x-2 text-sm">
          <span class="font-bold text-(--primary)" th:text="#{page.categories.subtitle}"
            >文章分类</span
          >
          <span class="text-30">·</span>
          <span class="cat-hero-stats text-50" id="cat-hero-stats">–</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 分类胶囊墙 ── -->
  <section
    class="card-base onload-animation flex flex-wrap gap-3 px-6 py-6 md:px-9"
  >
    <a
      th:each="category, stat : ${categories}"
      th:href="@{${category.status.permalink}}"
      th:attr="data-name=${category.spec.displayName},data-count=${category.postCount ?: 0}"
      th:aria-label="|${category.spec.displayName} - ${category.postCount ?: 0}|"
      th:style="|animation-delay: min(calc(var(--content-delay) + ${stat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
      class="cat-pill group relative overflow-hidden rounded-full px-4 py-2.5 text-sm font-bold transition duration-300 active:scale-95"
    >
      <!-- 鼠标跟随光效 -->
      <span class="cat-pill-spot" aria-hidden="true"></span>
      <!-- 分类色相小圆点 -->
      <span class="cat-pill-dot" aria-hidden="true"></span>
      <!-- 名称 -->
      <span class="cat-pill-name" th:text="${category.spec.displayName}">分类</span>
      <!-- 文章数徽章（JS 数字滚动） -->
      <span
        class="cat-pill-count"
        th:attr="data-count=${category.postCount ?: 0}"
        th:text="${category.postCount ?: 0}"
        >0</span
      >
    </a>
  </section>

  <!-- ── 互动脚本：色相 / 光效 / 数字滚动 / Hero 统计 ── -->
  <script is:inline>
    (function () {
      var pills = document.querySelectorAll(".cat-pill");

      // 1) 分类色相（名称 hash）+ 鼠标跟随光效
      pills.forEach(function (pill) {
        var name = pill.getAttribute("data-name") || "";
        var hue = 7;
        for (var i = 0; i < name.length; i++) {
          hue = (hue * 31 + name.charCodeAt(i)) % 360;
        }
        pill.style.setProperty("--cat-hue", hue);
        pill.addEventListener("mousemove", function (e) {
          var r = pill.getBoundingClientRect();
          pill.style.setProperty("--mx", e.clientX - r.left + "px");
          pill.style.setProperty("--my", e.clientY - r.top + "px");
        });
      });

      // 2) 文章数数字滚动（进入视口，easeOutCubic）
      var counts = document.querySelectorAll(".cat-pill-count[data-count]");
      function animate(el, target) {
        var dur = 550;
        var start = null;
        function tick(now) {
          if (start == null) start = now;
          var p = Math.min((now - start) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased);
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }
      if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                animate(en.target, Number(en.target.getAttribute("data-count")) || 0);
                io.unobserve(en.target);
              }
            });
          },
          { threshold: 0.4 },
        );
        counts.forEach(function (c) {
          io.observe(c);
        });
      } else {
        counts.forEach(function (c) {
          c.textContent = c.getAttribute("data-count") || 0;
        });
      }

      // 3) Hero 统计：分类数 + 文章总数
      var stats = document.getElementById("cat-hero-stats");
      if (stats) {
        var n = counts.length;
        var sum = 0;
        counts.forEach(function (c) {
          sum += Number(c.getAttribute("data-count")) || 0;
        });
        if (n > 0) {
          var i18n = window.i18nResources || {};
          var tpl = i18n["page.categories.subtitleCount"];
          var catTxt =
            tpl && tpl.indexOf("#{") === -1
              ? tpl.replace("{0}", n)
              : "共 " + n + " 个分类";
          stats.textContent = catTxt + " · " + sum + " 篇文章";
        } else {
          stats.textContent = "";
        }
      }
    })();
  </script>

  <style is:global>
    /* ── Hero ── */
    .cat-hero-glow {
      position: absolute;
      border-radius: 9999px;
      filter: blur(56px);
      opacity: 0.5;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }
    .cat-hero-glow-a {
      width: 13rem;
      height: 13rem;
      right: -3rem;
      top: -4rem;
      background: color-mix(in srgb, var(--primary) 45%, transparent);
      animation: cat-glow-float 9s ease-in-out infinite alternate;
    }
    .cat-hero-glow-b {
      width: 8rem;
      height: 8rem;
      right: 7rem;
      bottom: -4rem;
      background: color-mix(in srgb, var(--primary) 26%, transparent);
      animation: cat-glow-float 12s ease-in-out infinite alternate-reverse;
    }
    .cat-hero:hover .cat-hero-glow {
      opacity: 0.72;
    }
    @keyframes cat-glow-float {
      from {
        transform: translate3d(0, 0, 0) scale(1);
      }
      to {
        transform: translate3d(-1.5rem, 1rem, 0) scale(1.12);
      }
    }
    .cat-hero-icon {
      display: grid;
      place-items: center;
      width: 3.25rem;
      height: 3.25rem;
      flex-shrink: 0;
      border-radius: 1rem;
      color: white;
      background: linear-gradient(135deg, var(--primary), color-mix(in srgb, var(--primary) 62%, black));
      box-shadow: 0 8px 20px -6px color-mix(in srgb, var(--primary) 55%, transparent);
      transform: rotate(-4deg);
      transition: transform 0.3s ease;
    }
    .cat-hero:hover .cat-hero-icon {
      transform: rotate(0deg) scale(1.05);
    }

    /* ── 分类胶囊 ── */
    .cat-pill {
      --cat-hue: 250;
      --mx: 50%;
      --my: 50%;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--btn-regular-bg);
      color: var(--btn-content);
      border: 1px solid color-mix(in srgb, currentColor 8%, transparent);
      transition:
        transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease;
    }
    .cat-pill:hover {
      transform: translateY(-3px);
      color: #fff;
      border-color: transparent;
      background: linear-gradient(
        135deg,
        hsl(var(--cat-hue) 78% 60%),
        hsl(var(--cat-hue) 72% 44%)
      );
      box-shadow:
        0 10px 24px -8px hsl(var(--cat-hue) 72% 50% / 0.55),
        0 3px 8px -3px rgb(0 0 0 / 0.14);
    }
    /* 鼠标跟随光斑 */
    .cat-pill-spot {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s ease;
      background: radial-gradient(
        150px circle at var(--mx) var(--my),
        rgb(255 255 255 / 0.35),
        transparent 70%
      );
    }
    .cat-pill:hover .cat-pill-spot {
      opacity: 1;
    }
    /* 分类色相小圆点 */
    .cat-pill-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 9999px;
      flex-shrink: 0;
      background: hsl(var(--cat-hue) 78% 58%);
      box-shadow: 0 0 0 3px hsl(var(--cat-hue) 78% 58% / 0.18);
      transition: box-shadow 0.25s ease;
    }
    .cat-pill:hover .cat-pill-dot {
      box-shadow: 0 0 0 3px rgb(255 255 255 / 0.3);
    }
    /* 名称 */
    .cat-pill-name {
      line-height: 1.2;
    }
    /* 文章数徽章：默认主题色淡底 → hover 白底反色 */
    .cat-pill-count {
      font-size: 0.75rem;
      font-weight: 700;
      line-height: 1;
      padding: 0.25rem 0.5rem;
      border-radius: 9999px;
      font-variant-numeric: tabular-nums;
      background: color-mix(in srgb, var(--primary) 13%, transparent);
      color: var(--primary);
      transition:
        background 0.25s ease,
        color 0.25s ease;
    }
    .cat-pill:hover .cat-pill-count {
      background: rgb(255 255 255 / 0.22);
      color: #fff;
    }
    /* 可访问性 */
    .cat-pill:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }
  </style>
</MainGridLayout>
