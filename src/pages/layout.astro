---
// Halo 2.26+ 页面布局契约模板：供插件自有前台页面（如插件模板通过
// `th:replace="~{layout :: html(head=..., content=...)}"` 调用）复用主题外壳。
// 契约声明见 <html th:fragment="html (head, content)">，构建后输出 templates/layout.html。
// 该模板仅作为插件页的兜底外壳，复用全局样式 + 导航栏 + 页脚；侧边栏小组件、
// banner、Swup 过渡、访客样式覆盖等不在契约范围内（契约只传 head / content 两个槽位）。
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
// ⚠️「两个外壳」纪律（本地 1.5.66 起沿用）：导航栏内的访客样式面板与首帧访客样式
// 都依赖这两个组件，主题页外壳（src/layouts/Layout.astro）挂什么这里就挂什么，
// 失步会让插件页与主题页行为不一致。
import ConfigCarrier from "../components/ConfigCarrier.astro";
import VisitorStyleBoot from "../components/VisitorStyleBoot.astro";
// 半截页面自救：与 src/layouts/Layout.astro 同款（「两个外壳」纪律）
import PageTruncationGuard from "../components/misc/PageTruncationGuard.astro";
import {
  DEFAULT_THEME,
  LIGHT_MODE,
  DARK_MODE,
  AUTO_MODE,
  PAGE_WIDTH,
} from "../constants/constants";
import {
  speedCustomStyleThWith,
  speedCustomStyleThExpr,
} from "../utils/speed-style";

// 引入全局样式：顺序与 src/scripts/app.ts 的相对顺序保持一致（CSS 级联覆盖
// 依赖导入顺序），仅省略插件页用不到的小组件样式（comment-widget /
// external-link-modal / link-apply-modal / profile-status）。改顺序先对照 app.ts
import "../styles/global.css";
import "../styles/utilities.css";
import "../styles/variables.css";
import "../styles/content-widgets.css";
import "../styles/statistics.css";
import "../styles/base.css";
import "../styles/theme-transition.css";
import "../styles/components.css";
import "../styles/markdown.css";
import "../styles/portfolio-card.css";
import "../styles/transition.css";
import "../styles/speed.css";
import "../styles/scrollbar.css";

// ⚠️ 维护点：settings.yaml 新增顶层 group 时**必须**同步加进下面的白名单，否则客户端读不到该配置。
const themeConfigKeys = [
  "mods",
  "layout",
  "style",
  "sidebar",
  "post",
  "footer",
  "links",
  "external_link",
  "performance",
  "auth",
  "friends",
  "base",
];
const themeConfigMap = themeConfigKeys
  .map((k) => `'${k}': theme.config?.${k}`)
  .join(", ");
const themeSettingScript = `<script type="application/json" id="theme-config" data-swup-theme th:inline="javascript">
       /*[[\${ { ${themeConfigMap} } }]]*/
    </script>
    <script>
      /* ⚠️ 本脚本必须紧跟上面的 #theme-config（同一 <head> 内联脚本按文档顺序执行），别挪走。
         Halo 把每个配置分组序列化成 { realNode: { …真实字段 } }，而主题的客户端读者一律按
         「扁平分组」取值 ⇒ 不拆这一层就恒为 undefined，且**完全静默**。
         服务端 Thymeleaf 读同一路径是正常的，只有 JSON 序列化后多这一层。
         ⚠️ 元素上的 data-swup-theme 是**必须的**：主题开了 updateHead:true，Swup 的 head 插件
         按 outerHTML 全等做增删 —— 被本脚本改写过的 #theme-config 与「新页面的原始 JSON」永不
         相等 ⇒ 每次换页都会把改写过的删掉、把带 realNode 的原始元素插回来。打了 data-swup-theme
         后 head 插件对该元素既不删也不加（shouldKeepTag = localName!=="title" && !matches("[data-swup-theme]")）。
         ⚠️ 两外壳（src/layouts/Layout.astro 与 src/pages/layout.astro）必须保持一致。 */
      (function () {
        var el = document.getElementById("theme-config");
        if (!el || !el.textContent) return;
        try {
          var cfg = JSON.parse(el.textContent);
          var changed = false;
          for (var k in cfg) {
            var v = cfg[k];
            if (v && typeof v === "object" && v.realNode && typeof v.realNode === "object") {
              cfg[k] = v.realNode;
              changed = true;
            }
          }
          if (changed) el.textContent = JSON.stringify(cfg);
        } catch (e) {}
      })();
    </script>`;

// th:block 无法作为 Astro JSX 标签（含冒号），按 halo:comment 惯例用字符串注入
const headSlot = `<th:block th:if="\${head != null}">
      <th:block th:replace="\${head}" />
    </th:block>`;
const contentSlot = `<th:block th:replace="\${content}" />`;
---

<!doctype html>
<html
  th:lang="${#locale.toLanguageTag}"
  th:data-hue="${theme.config?.style?.themeColor?.hue}"
  th:data-hue-fixed="${theme.config?.layout?.mobileMenu?.visitorStyle?.enable == false or theme.config?.layout?.mobileMenu?.visitorStyle?.appearance == false}"
  th:data-theme-anim-style="${theme.config?.layout?.mobileMenu?.enable_change_color_scheme == false ? 'none' : theme.config?.style?.colorScheme?.colorSchemeAnimation?.style}"
  th:data-theme-anim-easing="${theme.config?.style?.colorScheme?.colorSchemeAnimation?.easing}"
  th:data-theme-anim-angle="${theme.config?.style?.colorScheme?.colorSchemeAnimation?.angle}"
  th:data-speed="${theme.config?.style?.animationSpeed?.speedTier}"
  th:with={speedCustomStyleThWith()}
  th:style={speedCustomStyleThExpr()}
  th:classappend="${(theme.config?.mods?.enable == null ? true : theme.config?.mods?.enable) and (theme.config?.mods?.pageWidth == null ? true : theme.config?.mods?.pageWidth) ? ' mods-page-wide' : ''} + ${(theme.config?.mods?.enable == null ? true : theme.config?.mods?.enable) and theme.config?.mods?.cardShell == true ? ' mods-card-shell' : ''} + ${(theme.config?.mods?.enable == null ? true : theme.config?.mods?.enable) and (theme.config?.mods?.pagePattern == null ? true : theme.config?.mods?.pagePattern) ? ' mods-page-pattern' : ''}"
  th:fragment="html (head, content)"
  class="bg-(--page-bg) text-[14px] transition md:text-[16px]"
>
  <head>
    <meta charset="UTF-8" />
    <!-- 访问计数守卫（本地 1.5.48 独有）：halo-tracker 会包装 history.pushState 在每次
         Swup 软导航后再上报一次，而它的包装会叠加 ⇒ 每换一页就再叠加一层 hook ⇒
         每次导航把**所有历史文章**各自再 +1（浏览 A→B→C 的上报序列为 A,A,B,B,A,C）。
         这里把 pushState / replaceState 定义成「读走原生、吞掉赋值」的访问器 ⇒ tracker
         只剩「脚本执行时上报一次」这条通道，换页重建的新 script 带的正是当前文章
         ⇒ 每次进入一篇文章恰好计 1 次。
         ⚠️ 必须内联且尽量靠前：要早于 Halo 注入的 tracker。
         ⚠️ 两外壳必须保持一致。 -->
    <script is:inline data-visit-guard>
      (function () {
        var hist = window.history;
        var natives = {
          pushState: hist.pushState,
          replaceState: hist.replaceState,
        };
        Object.keys(natives).forEach(function (name) {
          try {
            Object.defineProperty(hist, name, {
              configurable: true,
              get: function () {
                return natives[name];
              },
              set: function () {
                /* 吞掉第三方（halo-tracker）对 pushState 的包装 */
              },
            });
          } catch (e) {
            /* 环境不支持时静默降级，不影响导航 */
          }
        });
      })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" th:content="${theme.config?.sidebar?.profile?.name}" />
    <meta property="og:site_name" th:content="${site.title}" />
    <title th:text="${site.title}"></title>
    <link rel="icon" th:href="${site.favicon}" />

    <Fragment set:html={themeSettingScript} />
    <script th:inline="javascript" is:inline>
      // @ts-nocheck 本脚本组多处使用 define:vars 注入常量，检查器无法感知（构建期注入）
      // 后台配色配置（与 Layout.astro 同式，供下方暗色模式初始化读取）
      var __ecs =
        /*[[${theme.config?.style?.colorScheme?.color_scheme}]]*/ "auto";
      var __eecs = /*[[${theme.config?.layout?.mobileMenu?.enable_change_color_scheme ?: theme.config?.style?.colorScheme?.enable_change_color_scheme}]]*/ true;
    </script>
    <script
      is:inline
      define:vars={{
        DEFAULT_THEME,
        LIGHT_MODE,
        DARK_MODE,
        AUTO_MODE,
        PAGE_WIDTH,
      }}
    >
      (() => {
        const configHue = document.documentElement.dataset.hue || "250";
        const fixedHue = document.documentElement.dataset.hueFixed === "true";

        var defaultScheme = DEFAULT_THEME;
        if (
          typeof __ecs !== "undefined" &&
          __ecs !== null &&
          (__ecs === LIGHT_MODE || __ecs === DARK_MODE || __ecs === AUTO_MODE)
        ) {
          defaultScheme = __ecs;
        }
        var enableChange =
          typeof __eecs !== "undefined" && __eecs !== null ? __eecs : true;
        var storedTheme;
        if (enableChange && localStorage.getItem("__user_chose_theme")) {
          storedTheme = localStorage.getItem("theme") || defaultScheme;
        } else {
          storedTheme = defaultScheme;
        }

        const preferredDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;

        if (
          storedTheme === DARK_MODE ||
          (storedTheme === AUTO_MODE && preferredDark)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }

        const hue = fixedHue
          ? configHue
          : localStorage.getItem("hue") || configHue;
        document.documentElement.style.setProperty("--hue", hue);
        document.documentElement.style.setProperty(
          "--page-width",
          `${PAGE_WIDTH}rem`,
        );
      })();
    </script>
    <!-- 插件页自身的 head 片段（title / meta / 样式等） -->
    <Fragment set:html={headSlot} />
    <!-- 半截页面自救：与 src/layouts/Layout.astro 同款（「两个外壳」纪律）。
         插件页同样走 Halo 的 chunked 流式输出、同样会被 EdgeOne 缓存成坏对象。 -->
    <PageTruncationGuard />
    <!-- 侧栏小组件「视口懒加载」助手（本地 1.5.66 独有）。
         ⚠️🔴 上游 v2.0.0 的 Layout 没有它，而下列组件会 `window.__themeLazyInit(...)`
         调用它：MoeCounter（访客计数）、RecentComments（最近评论）。缺定义 ⇒ 调用即抛
         TypeError ⇒ **整段初始化不执行且完全静默**：计数图片永远拿不到 src（显示空白）、
         最近评论永远停在占位。
         语义：容器进入视口（提前 300px）才执行 init，避免首屏一次性跑掉所有侧栏 widget
         的请求；不支持 IntersectionObserver / 容器不存在 / initFn 非函数时退化为立即执行。
         换页后（Swup 替换容器）若元素已在可视区则同步立即初始化，避免「加载中」闪现。
         必须早于侧栏组件内的调用脚本 ⇒ 放在 <head> 内联。 -->
    <script is:inline>
      (function () {
        if (window.__themeLazyInit) return;
        window.__themeLazyInit = function (elId, initFn) {
          var el =
            typeof elId === "string" ? document.getElementById(elId) : elId;
          if (!el) {
            initFn();
            return;
          }
          if (typeof initFn !== "function") return;
          if (!("IntersectionObserver" in window)) {
            initFn();
            return;
          }
          var cs = window.getComputedStyle(el);
          if (cs.display !== "none" && cs.visibility !== "hidden") {
            var rect = el.getBoundingClientRect();
            var vh =
              window.innerHeight || document.documentElement.clientHeight;
            if (rect.top < vh + 300 && rect.bottom > -300) {
              initFn();
              return;
            }
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  io.disconnect();
                  initFn();
                }
              });
            },
            { rootMargin: "300px" },
          );
          io.observe(el);
        };
      })();
    </script>
  </head>
  <body
    class="relative min-h-screen transition"
    th:classappend="${(theme.config?.style?.styleSwitches?.navbar_blur ? ' navbar-blur-enabled' : '') + (theme.config?.style?.styleSwitches?.card_hover_lift != false ? ' card-hover-lift-enabled' : '')}"
    th:style="|--page-pattern-strength: ${theme.config?.mods?.pagePatternOpacity ?: 0.42};|"
  >
    <!-- 与主题页外壳同款「两个外壳」挂载：ConfigCarrier + 魔改轴覆盖启动脚本。
         顺序不可调换（VisitorStyleBoot 要读 ConfigCarrier 的 data-*）。 -->
    <ConfigCarrier />
    {/* Swup 换页播报区（route-change announcement，本地独有）。
         @swup/a11y-plugin 启动时先找页面里已存在的 #swup-announcer，找到就复用不自建，
         所以预置可拿回两件事：① aria-live="polite"（插件自建的是 assertive，会打断读屏
         正在念的内容）；② sr-only 视觉隐藏，且不必等 JS 才存在。
         ⚠️ 必须留在 Swup 容器之外：换页不替换本节点，播报区才能常驻复用。 */}
    <p
      id="swup-announcer"
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
    ></p>
    <VisitorStyleBoot />
    <!-- 与 MainGridLayout 同款导航栏外壳：顶部行 + 导航栏 -->
    <div
      id="top-row"
      class="pointer-events-none relative z-50 mx-auto w-full max-w-(--page-width) px-0 transition md:px-4"
    >
      <div
        id="navbar-wrapper"
        class="pointer-events-auto sticky top-0 transition-transform duration-[var(--dur-scroll,700ms)]"
      >
        <Navbar />
      </div>
    </div>

    <!-- 插件页正文 -->
    <div id="main-panel-wrapper" class="relative z-30">
      <div class="relative mx-auto w-full max-w-(--page-width) px-4 py-6 md:px-4">
        <main id="main-grid" class="min-w-0">
          <div id="content-wrapper" class="onload-animation">
            <Fragment set:html={contentSlot} />
          </div>
        </main>
      </div>
    </div>

    <div class="mx-auto w-full max-w-(--page-width) px-4">
      <Footer />
    </div>

    <!-- Halo 核心页脚注入（备案/统计等）；halo: 前缀元素无法直接写 JSX，按
         halo:comment 惯例用字符串注入，避免 Astro 把 <halo:footer /> 改写为 <halo :footer> -->
    <Fragment set:html={"<halo:footer />"} />
    <!-- 页面完整性哨兵：文档最末元素，与 <head> 的 PageTruncationGuard 配对。
         ⚠️ 必须与 src/layouts/Layout.astro 的同款哨兵保持同一个 id。 -->
    <div id="ethereal-page-end" hidden></div>
  </body>
</html>
