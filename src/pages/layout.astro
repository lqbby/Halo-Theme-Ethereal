---
// Halo 2.26+ 页面布局契约模板：供插件自有前台页面（如插件模板通过
// `th:replace="~{layout :: html(head=..., content=...)}"` 调用）复用主题外壳。
// 契约声明见 <html th:fragment="html (head, content)">，构建后输出 templates/layout.html。
// 该模板仅作为插件页的兜底外壳，复用全局样式 + 导航栏 + 页脚；侧边栏小组件、
// banner、Swup 过渡、访客样式覆盖等不在契约范围内（契约只传 head / content 两个槽位）。
// ⚠️ 必须挂 ConfigCarrier：导航栏内的访客样式面板（DisplaySettings）与首帧访客样式
// 覆盖脚本都以 #config-carrier 的 data-* 为「后台默认值」唯一来源；缺了它，
// getVisitorSwitches() 全部走 fallback true（后台关了照样显示），「恢复默认」判定也会错乱。
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ConfigCarrier from "../components/ConfigCarrier.astro";
import PageTruncationGuard from "../components/misc/PageTruncationGuard.astro";
import VisitorStyleBoot from "../components/VisitorStyleBoot.astro";
import {
  DEFAULT_THEME,
  LIGHT_MODE,
  DARK_MODE,
  AUTO_MODE,
  PAGE_WIDTH,
} from "../constants/constants";
import {
  speedCustomStyleThWith,
  speedCustomStyleThExpr,
} from "../utils/speed-style";

// 引入全局样式：顺序与 src/scripts/app.ts 的相对顺序保持一致（CSS 级联覆盖
// 依赖导入顺序），仅省略插件页用不到的小组件样式（comment-widget /
// external-link-modal / link-apply-modal / profile-status）。改顺序先对照 app.ts
import "../styles/global.css";
import "../styles/utilities.css";
import "../styles/variables.css";
import "../styles/content-widgets.css";
import "../styles/base.css";
import "../styles/theme-transition.css";
import "../styles/components.css";
import "../styles/statistics.css";
import "../styles/markdown.css";
import "../styles/portfolio-card.css";
import "../styles/transition.css";
import "../styles/speed.css";
import "../styles/scrollbar.css";

// 🚀 性能：同 src/layouts/Layout.astro —— 剔除 extendPages 那份只在服务端消费的大块内容数据
// （实测占整份 JSON 的 52%）。两个外壳必须保持一致，否则插件页仍会背全量配置。
// ⚠️ 维护点：settings.yaml 新增顶层 group 时两处白名单都要同步。
const themeConfigKeys = [
  "mods",
  "layout",
  "style",
  "sidebar",
  "post",
  "footer",
  "links",
  "external_link",
  "performance",
  "auth",
  "friends",
  "base",
];
const themeConfigMap = themeConfigKeys
  .map((k) => `'${k}': theme.config?.${k}`)
  .join(", ");
const themeSettingScript = `<script type="application/json" id="theme-config" data-swup-theme th:inline="javascript">
       /*[[\${ { ${themeConfigMap} } }]]*/
    </script>
    <script>
      /* ⚠️ 本脚本必须紧跟上面的 #theme-config（同一 <head> 内联脚本按文档顺序执行），别挪走。
         Halo 把每个配置分组序列化成 { realNode: { …真实字段 } }，而主题的客户端读者一律按
         「扁平分组」取值（cfg.sidebar.widgetsConfig / cfg.style.bannerStyle / cfg.performance.imageProcessing …）
         ⇒ 不拆这一层就恒为 undefined，且**完全静默**。实锤（2026-09-18，两个 origin 两版主题均复现）：
         sidebar.realNode.widgetsConfig.rightWidgets[1].tencent_key 里明明存着 Key，天气组件却一直显示
         「请配置腾讯地图 Key」；同一原因还静默关掉 WelcomePopup（layout.welcome 读不到）、
         post 页图片处理（performance.imageProcessing 读不到）、banner 轮播配置等。
         服务端 Thymeleaf 读同一路径（theme.config?.sidebar?.widgetsConfig）是正常的，
         只有 JSON 序列化后多这一层 —— 所以修在这里，一处生效、后面所有读者都拿到扁平结构。
         ⚠️ 两外壳（src/layouts/Layout.astro 与 src/pages/layout.astro）必须保持一致。
         实测只在「分组根」包一层、组内子对象不再包，故只拆一层；未包时原样不动（两态兼容）。
         ⚠️ 元素上的 data-swup-theme 是**必须的**，别删：主题开了 updateHead:true，Swup 的
         head 插件按 outerHTML 全等做增删 —— 被本脚本改写过的 #theme-config 与「新页面的原始
         JSON」永不相等 ⇒ 每次换页都会把改写过的删掉、把带 realNode 的原始元素插回来
         （天气 Key 在软导航后复发）。打了 data-swup-theme 后 head 插件对该元素既不删也不加
         （源码 shouldKeepTag = localName!=="title" && !matches("[data-swup-theme]")），
         改写结果得以常驻。另有一道自愈：@swup/astro 默认 reloadScripts:true，
         SwupScriptsPlugin 的作用域是**整个 document**（head+body），换页后会重执行全部内联
         脚本 —— 本脚本因此会再跑一次（幂等），即便元素被换回也能立刻拆平。 */
      (function () {
        var el = document.getElementById("theme-config");
        if (!el || !el.textContent) return;
        try {
          var cfg = JSON.parse(el.textContent);
          var changed = false;
          for (var k in cfg) {
            var v = cfg[k];
            if (
              v &&
              typeof v === "object" &&
              v.realNode &&
              typeof v.realNode === "object"
            ) {
              cfg[k] = v.realNode;
              changed = true;
            }
          }
          if (changed) el.textContent = JSON.stringify(cfg);
        } catch (e) {}
      })();
    </script>`;

// th:block 无法作为 Astro JSX 标签（含冒号），按 halo:comment 惯例用字符串注入
const headSlot = `<th:block th:if="\${head != null}">
      <th:block th:replace="\${head}" />
    </th:block>`;
const contentSlot = `<th:block th:replace="\${content}" />`;
---

<!doctype html>
<html
  th:lang="${#locale.toLanguageTag}"
  th:data-hue="${theme.config?.style?.themeColor?.hue}"
  th:data-hue-fixed="${theme.config?.layout?.mobileMenu?.visitorStyle?.enable == false or theme.config?.layout?.mobileMenu?.visitorStyle?.hue == false}"
  th:data-theme-anim-style="${theme.config?.layout?.mobileMenu?.enable_change_color_scheme == false ? 'none' : theme.config?.style?.colorScheme?.colorSchemeAnimation?.style}"
  th:data-theme-anim-easing="${theme.config?.style?.colorScheme?.colorSchemeAnimation?.easing}"
  th:data-theme-anim-angle="${theme.config?.style?.colorScheme?.colorSchemeAnimation?.angle}"
  th:data-speed="${theme.config?.style?.animationSpeed?.speedTier}"
  th:with={speedCustomStyleThWith()}
  th:style={speedCustomStyleThExpr()}
  th:fragment="html (head, content)"
  class="bg-(--page-bg) text-[14px] transition md:text-[16px]"
>
  <head>
    <meta charset="UTF-8" />
    <!-- 访问量去重守卫：Halo 核心的 /halo-tracker.js（注入在主题 head 之后）在执行时会
         用 `history.pushState = 包装(原方法)` 挂一个「SPA 换页补上报」的 hook。但它的
         group/plural/name 是**本次脚本执行时**读到的 data-name，闭包固定不变 ⇒ Swup 换页
         触发 pushState 时，上报的仍是被离开的那篇文章。又因为主题开了 updateHead:true，
         @swup/head-plugin 每次换页都会 cloneNode 重建这个 halo-tracker 的 script 标签
         ⇒ 每换一页就再叠加一层 hook ⇒ 每次导航把**所有历史文章**各自再 +1。
         桩测 scripts/test-visit-tracker.mjs 复现：浏览 A→B→C 的上报序列是 A,A,B,B,A,C。
         这里把 pushState / replaceState 定义成「读走原生、吞掉赋值」的访问器：
           · Swup 自身调用照常（getter 返回原生实现）；
           · tracker 的包装赋值被静默吞掉（setter 存在即合法，严格模式下也不会抛错，
             因此它随后的「执行时立即上报」仍会正常发出）。
         于是 tracker 只剩「脚本执行时上报一次」这条通道，而换页重建的新 script 带的正是
         当前文章的 data-name ⇒ 每次进入一篇文章恰好计 1 次。
         ⚠️ 必须内联且尽量靠前：要早于 Halo 注入的 tracker。
         ⚠️ 两外壳（src/layouts/Layout.astro 与 src/pages/layout.astro）必须保持一致。 -->
    <script is:inline data-visit-guard>
      (function () {
        var hist = window.history;
        var natives = {
          pushState: hist.pushState,
          replaceState: hist.replaceState,
        };
        Object.keys(natives).forEach(function (name) {
          try {
            Object.defineProperty(hist, name, {
              configurable: true,
              get: function () {
                return natives[name];
              },
              set: function () {
                /* 吞掉第三方（halo-tracker）对 pushState 的包装 */
              },
            });
          } catch (e) {
            /* 环境不支持时静默降级，不影响导航 */
          }
        });
      })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" th:content="${theme.config?.sidebar?.profile?.name}" />
    <meta property="og:site_name" th:content="${site.title}" />
    <title th:text="${site.title}"></title>
    <link rel="icon" th:href="${site.favicon}" />

    <Fragment set:html={themeSettingScript} />
    <script th:inline="javascript">
      // 后台配色配置（与 Layout.astro 同式，供下方暗色模式初始化读取）
      var __ecs =
        /*[[${theme.config?.style?.colorScheme?.color_scheme}]]*/ "auto";
      var __eecs = /*[[${theme.config?.layout?.mobileMenu?.enable_change_color_scheme ?: theme.config?.style?.colorScheme?.enable_change_color_scheme}]]*/ true;
    </script>
    <script
      is:inline
      define:vars={{
        DEFAULT_THEME,
        LIGHT_MODE,
        DARK_MODE,
        AUTO_MODE,
        PAGE_WIDTH,
      }}
    >
      (() => {
        // localStorage 安全访问：禁存储环境（Safari 无痕 / 站点存储被浏览器或扩展拦截）
        // 读取会抛 SecurityError，裸调会中断主题初始化、导致整站主题错乱。读取失败按未设置处理。
        var lsGet = (k) => {
          try {
            return localStorage.getItem(k);
          } catch (e) {
            return null;
          }
        };

        const configHue = document.documentElement.dataset.hue || "250";
        const fixedHue = document.documentElement.dataset.hueFixed === "true";

        var defaultScheme = DEFAULT_THEME;
        if (
          typeof __ecs !== "undefined" &&
          __ecs !== null &&
          (__ecs === LIGHT_MODE || __ecs === DARK_MODE || __ecs === AUTO_MODE)
        ) {
          defaultScheme = __ecs;
        }
        var enableChange =
          typeof __eecs !== "undefined" && __eecs !== null ? __eecs : true;
        var storedTheme;
        if (enableChange && lsGet("__user_chose_theme")) {
          storedTheme = lsGet("theme") || defaultScheme;
        } else {
          storedTheme = defaultScheme;
        }

        const preferredDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;

        if (
          storedTheme === DARK_MODE ||
          (storedTheme === AUTO_MODE && preferredDark)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }

        const hue = fixedHue ? configHue : lsGet("hue") || configHue;
        document.documentElement.style.setProperty("--hue", hue);
        document.documentElement.style.setProperty(
          "--page-width",
          `${PAGE_WIDTH}rem`,
        );
      })();
    </script>

    <!-- 插件页自身的 head 片段（title / meta / 样式等） -->
    <Fragment set:html={headSlot} />
    <!-- 半截页面自救：与 src/layouts/Layout.astro 同款（「两个外壳」纪律）。
         插件页（如 /bangumis、/schedule-calendar）同样走 Halo 的 chunked 流式输出、
         同样会被 EdgeOne 缓存成坏对象，故这里也必须有守卫 + 正文末尾哨兵。 -->
    <PageTruncationGuard />
  </head>
  <body
    class="relative min-h-screen transition"
    th:classappend="${(theme.config?.style?.styleSwitches?.navbar_blur ? ' navbar-blur-enabled' : '') + (theme.config?.style?.styleSwitches?.card_hover_lift != false ? ' card-hover-lift-enabled' : '')}"
  >
    <!-- 配置载体（body 首元素）：访客样式面板与首帧访客样式覆盖脚本的默认值来源。
         必须与导航栏同为「插件页外壳」的一部分，否则面板门控失效 -->
    <ConfigCarrier />
    <!-- 访客样式覆盖启动脚本：与主题页外壳同款，紧跟 ConfigCarrier、在可见内容
         解析前应用 body/html 类与壁纸变量，无 FOUC -->
    <VisitorStyleBoot />
    <!-- 与 MainGridLayout 同款导航栏外壳：顶部行 + 导航栏 -->
    <div
      id="top-row"
      class="pointer-events-none relative z-50 mx-auto w-full max-w-(--page-width) px-0 transition md:px-4"
    >
      <div
        id="navbar-wrapper"
        class="pointer-events-auto sticky top-0 transition-transform duration-[var(--dur-scroll,700ms)]"
      >
        <Navbar />
      </div>
    </div>

    <!-- 插件页正文 -->
    <div id="main-panel-wrapper" class="relative z-30">
      <div
        class="relative mx-auto w-full max-w-(--page-width) px-4 py-6 md:px-4"
      >
        <main id="main-grid" class="min-w-0">
          <div id="content-wrapper" class="onload-animation">
            <Fragment set:html={contentSlot} />
          </div>
        </main>
      </div>
    </div>

    <div class="mx-auto w-full max-w-(--page-width) px-4">
      <Footer />
    </div>

    {
      /* 页脚友链随机渲染（源码 src/scripts/assets/footer-friends.ts）。
         🔴🔴 插件页外壳**也必须挂**：本外壳同样渲染 <Footer />（上面的友链块），
         但**不走** MainGridLayout ⇒ 漏了这里，插件页（如 /bangumis、/schedule-calendar）
         页脚的友链会永远是空的（「两个外壳」老坑，对照 ConfigCarrier）。
         门控条件必须与 MainGridLayout / FooterFriendLinks 的 <nav> th:if 完全一致。
         ⚠️ 插件页不加载 Swup，所以本脚本在这里只在 DOMContentLoaded 跑一次，无需幂等顾虑。 */
    }
    <script
      th:if="${pluginFinder.available('PluginLinks') && pluginFinder.available('ethereal-companion') && theme.config?.footer?.friendLinks?.enable_friend_links == true}"
      src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/footer-friends.js?v=${ASSET_VERSION}`}
      defer></script>

    <!-- Halo 核心页脚注入（备案/统计等）；halo: 前缀元素无法直接写 JSX，按
         halo:comment 惯例用字符串注入，避免 Astro 把 <halo:footer /> 改写为 <halo :footer> -->
    <Fragment set:html={"<halo:footer />"} />
    <!-- 页面完整性哨兵：文档最末元素，与 <head> 的 PageTruncationGuard 配对。
         ⚠️ 必须与 src/layouts/Layout.astro 的同款哨兵保持同一个 id。 -->
    <div id="ethereal-page-end" hidden></div>
  </body>
</html>
