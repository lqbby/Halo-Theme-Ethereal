---
/**
 * 首页「系列」卡片条（1.5.32 新增；1.5.33 改为「按系列切换 + 展示该系列全部文章」）
 *
 * 参考站 https://daily.yybb.us/ 首页那条（他站标题「喜欢哪一期周刊呢~」）：一条横向
 * scroll-snap 轨道，放的是**某一个系列的全部期数**，一行 4 张、点 ‹ › 往右翻。
 * 本站比参考站多一层：LQ 有多个系列 ⇒ 标题下方加一排**系列切换按钮**，切换后换个面板，
 * 每个面板就是「那个系列的全部文章」。
 *
 * 数据来源（纯 SSR，前端零取数）：
 *   `recentCommentsSeriesFinder.listLatest(n)` —— Ethereal 配套插件 1.1.0 提供。
 *   返回按「系列内最新一篇文章的发布时间」倒序的若干 SeriesView，**每个 SeriesView 里
 *   带着该系列的全部 posts**（`SeriesPostView`：name/title/permalink/order/publishTime/cover）。
 *   所以一次调用就同时拿到「标签顺序」「每个系列的全部文章」和「封面」，不用第二次查库。
 *
 * 🔴 版本门控（必须保留）：`listLatest` 与 `SeriesPostView.cover` 都只有插件 1.1.0+ 才有。
 *    若主题先发、插件还是 1.0.3，直接调它 → SpEL 找不到方法 → **整页 500/截断**。
 *    因此最外层用 `pluginFinder.available('ethereal-companion', '>=1.1.0')` 兜住
 *    （第二参是 Semantic Version Range，Halo 2.17+）。插件没升级时整块不渲染，首页照常。
 *
 * 结构刻意做成「守卫层 / 取数层 / 内容层」三层：
 *   ① 最外层 div：只放**不依赖 finder 结果**的守卫（插件版本 / 后台开关 / 首页第一页）。
 *      —— `th:if`(优先级 3) 早于 `th:with`(4)，同标签里 th:if 读不到 th:with 的变量（会短路），
 *         所以 finder 调用必须放在 th:if **之后**的层，否则插件缺失时照样会去调它。
 *   ② 第二层 div：`th:with` 里才真正调 finder。
 *   ③ `<section>`：判空 + 渲染（标签 / 面板 / 卡片）。
 *
 * 交互（脚本在 src/scripts/assets/series-strip.ts）：
 *   · 系列切换：点击标签或 ←/→/Home/End 键切换面板（WAI-ARIA tablist 模式，roving tabindex）；
 *   · ‹ › 按「一张卡」为步长滚动**当前面板**的轨道；用 `scrollLeft` 边界判定「到头了没」并置灰
 *     —— 不做「卡片数 ≤ 可见数就整块隐藏」（那样 LQ 系列只有 4 篇时按钮会凭空消失）。
 *   · 卡片宽度用容器查询算（`100cqi`），与参考站同款公式，无需 JS 量宽度。
 *
 * ⚠️ 期号（`第 N 期`）取值优先级：`post.order`（文章注解 `seriesOrder`）→ 没填就按该系列内的
 *    时间顺序倒推 `#lists.size(posts) - 下标`（插件对「未填序号」的排法是「按发布时间倒序」，
 *    所以 下标 0 = 最新 = 总篇数）。LQ 目前 8 篇文章都没填 `seriesOrder`，走的就是后一条。
 */
import { imageSuffixThWith } from "../utils/image-suffix";

/** 封面取图宽度（16:9 小卡，480 足够） */
const COVER_WIDTH = "480";
/** 一行可见卡片数：桌面 4 / 平板 3 / 手机 2（写进 style 的自定义属性，供 CSS 读） */
const VISIBLE_DESKTOP = 4;
const VISIBLE_TABLET = 3;
const VISIBLE_MOBILE = 2;
/**
 * 单个系列最多渲染多少张卡。防御性上限：系列再长也不能把首页首屏撑爆。
 * 30 对个人博客的系列而言等于「全部」（LQ 现在每个系列 4 篇）。
 */
const MAX_POSTS_PER_SERIES = 30;
---

<!-- ① 只放「不依赖 finder 结果」的静态守卫：插件版本 / 后台开关 / 首页第一页。
     th:if(3) 早于 th:with(4)，同层读不到 th:with 的变量（会短路）⇒ finder 调用必须下一层。 -->
<div
  th:remove="tag"
  th:if="${pluginFinder != null
    and pluginFinder.available('ethereal-companion', '>=1.1.0')
    and (theme.config?.layout?.postList?.seriesEnable == null or theme.config?.layout?.postList?.seriesEnable)
    and posts != null and posts.page == 1}"
>
  <div
    th:remove="tag"
    th:with="seriesLimit=${theme.config?.layout?.postList?.seriesCount != null ? #conversions.convert(theme.config?.layout?.postList?.seriesCount, 'java.lang.Integer') : 4}, seriesList=${recentCommentsSeriesFinder.listLatest(seriesLimit)}"
  >
    <!-- ② 空态：连 <section> 本体一起不输出。
         若把判空写在 section 内层，一个系列都没有时会留下空的 <section>（带 margin-bottom 的
         1rem 死空白 + 白跑一次入场动画），所以判空必须罩在 section 外面。 -->
    <section
      id="series-strip"
      class="series-strip onload-animation"
      style={`--series-visible-desktop:${VISIBLE_DESKTOP};--series-visible-tablet:${VISIBLE_TABLET};--series-visible-mobile:${VISIBLE_MOBILE};animation-delay:calc(var(--content-delay) + 60ms)`}
      th:if="${not #lists.isEmpty(seriesList)}"
    >
      <!-- 段头：图标 + 标题（左）／‹ › 箭头（右） -->
      <div class="series-strip__head">
        <h2 class="series-strip__title">
          <span
            class="icon-[material-symbols--layers] text-[1.125rem] leading-none"
            aria-hidden="true"></span>
          <span class="leading-none" th:text="#{seriesStrip.title}">系列</span>
        </h2>
        <div class="series-strip__navs" data-series-navs>
          <button
            type="button"
            class="series-strip__nav series-strip__nav--prev"
            data-series-dir="prev"
            th:aria-label="#{seriesStrip.navPrev}"
          >
            <span
              class="icon-[material-symbols--chevron-left-rounded] text-xl leading-none"
              aria-hidden="true"></span>
          </button>
          <button
            type="button"
            class="series-strip__nav series-strip__nav--next"
            data-series-dir="next"
            th:aria-label="#{seriesStrip.navNext}"
          >
            <span
              class="icon-[material-symbols--chevron-right-rounded] text-xl leading-none"
              aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <!-- 系列切换（只有一个系列时不渲染：没得切） -->
      <div
        class="series-strip__tabs"
        role="tablist"
        data-series-tabs
        th:if="${#lists.size(seriesList) > 1}"
        th:aria-label="#{seriesStrip.tabsAria}"
      >
        <button
          th:each="s, st : ${seriesList}"
          type="button"
          role="tab"
          class="series-strip__tab btn-card"
          th:id="|series-tab-${st.index}|"
          th:data-series-tab="${st.index}"
          th:aria-controls="|series-panel-${st.index}|"
          th:aria-selected="${st.index == 0 ? 'true' : 'false'}"
          th:tabindex="${st.index == 0 ? '0' : '-1'}"
          th:text="${s.name}"
        >
          系列名
        </button>
      </div>

      <!-- 每个系列一个面板；首屏只显示第 0 个。
           ⚠️ 用 class 而不是 hidden 属性做显隐：`th:attr` 求值为 null 时 Thymeleaf 会写空属性
              （实测 3.1.5），语义不确定；class + CSS display:none 是死的、可断言。 -->
      <div
        th:each="s, st : ${seriesList}"
        class="series-strip__panel"
        th:classappend="${st.index != 0 ? ' is-hidden' : ''}"
        role="tabpanel"
        th:id="|series-panel-${st.index}|"
        th:aria-labelledby="|series-tab-${st.index}|"
        th:data-series-panel="${st.index}"
      >
        <!-- 横向轨道：SSR 渲染该系列的全部卡片，脚本只负责接线 -->
        <div class="series-strip__viewport" data-series-viewport>
          <div class="series-strip__track" data-series-track>
            <!-- ⚠️ th:each 与 th:if 同层：each(2) 先于 if(3)，逐条判定。
                 · 封顶写成 `not (ps.index >= N)` 而不是 `ps.index < N` —— `>` 会被 Astro
                   转义成 `&gt;` 再由 attoparser 还原（实测可用），裸 `<` 在属性里更易踩坑。
                 · permalink 拿不到就整卡不输出：th:href 求值为 null 时 Thymeleaf 写出 `href=""`
                   （不是删属性！实测 3.1.5.RELEASE），空 href 点一下等于刷新当前页。 -->
            <a
              th:each="post, ps : ${s.posts}"
              th:if={`\${not (ps.index >= ${MAX_POSTS_PER_SERIES}) and post.permalink != null}`}
              class="series-strip-card card-base"
              th:href="${post.permalink}"
            >
              <!-- 封面：无封面用主题色渐变 + 占位图标 -->
              <span
                class="series-strip-card__cover"
                th:classappend="${#strings.isEmpty(post.cover) ? 'is-empty' : ''}"
              >
                <!-- ⚠️ alt 空 + aria-hidden：标题就在同一张卡里，图片再念一遍会让读屏重复；
                     链接的可访问名 = 标题 + 期号，够用。 -->
                <img
                  class="series-strip-card__img"
                  th:if="${not #strings.isEmpty(post.cover)}"
                  th:src="${post.cover + suffix}"
                  alt=""
                  aria-hidden="true"
                  th:with={imageSuffixThWith(COVER_WIDTH)}
                  loading="lazy"
                  decoding="async"
                />
                <span class="series-strip-card__placeholder" aria-hidden="true">
                  <span
                    class="icon-[material-symbols--article-outline-rounded] text-5xl leading-none text-(--primary)"
                  ></span>
                </span>
                <!-- 期号胶囊：挂在封面左上角。order 优先，没填就按系列内时间倒推。 -->
                <span
                  class="series-strip-card__issue"
                  aria-hidden="true"
                  th:text="#{seriesStrip.issue(${post.order != null ? post.order : #lists.size(s.posts) - ps.index})}"
                  >第 1 期</span
                >
              </span>

              <span class="series-strip-card__body">
                <span class="series-strip-card__title" th:text="${post.title}"
                  >文章标题</span
                >
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- 行为脚本（经典脚本产物）：系列切换 + 横向滚动导航 -->
<script
  is:inline
  src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/series-strip.js?v=${ASSET_VERSION}`}
  defer></script>

<style is:global>
  /* ===== 首页「系列」卡片条 =====
     ⚠️ 一行可见数、卡片宽度公式（100cqi 容器查询）都与参考站 .home-list-featured 一致，
        改一处要回看配平；`-1px` 是参考站原式里的取整余量，别当废项删掉。
     ⚠️ `.series-strip__viewport` 的 container-type 是 `100cqi` 生效的前提，
        去掉它卡片宽度会退化成 0。 */
  #series-strip {
    --series-gap: 0.75rem;
    --series-edge: 2px;
    --series-visible: var(--series-visible-desktop, 4);
    width: 100%;
    min-width: 0;
    /* 1rem → 0.75rem：与 .series-strip__viewport 的 padding-bottom(0.625rem) 合计 ≈ 22px，
       原来合计 30px —— 比主题任何相邻区块之间的距离都宽一倍（2026-09-18 LQ 圈出）。 */
    margin-bottom: 0.75rem;
  }
  /* 平板 / 手机降档：只改可见数，卡片宽度公式自适应 */
  @media (max-width: 1023.98px) {
    #series-strip {
      --series-visible: var(--series-visible-tablet, 3);
    }
  }
  @media (max-width: 767.98px) {
    #series-strip {
      --series-visible: var(--series-visible-mobile, 2);
    }
  }

  .series-strip__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    /* 0.5rem → 0.375rem：段头与系列切换按钮之间收紧 */
    margin-bottom: 0.375rem;
  }
  .series-strip__title {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    color: var(--primary);
  }

  /* ===== 系列切换标签 ===== */
  .series-strip__tabs {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    /* 0.625rem → 0.375rem：与 viewport 的 padding-top(0.375rem) 合计 12px（原 18px） */
    margin-bottom: 0.375rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .series-strip__tabs::-webkit-scrollbar {
    display: none;
  }
  .series-strip__tab {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem 0.625rem;
    /* 描边与底色都改走「主题按钮」那一套：原来 border 用 --line-divider(8%)、
       background 用 --card-bg —— 暗色下卡片底与页面底几乎同色 ⇒ 胶囊看起来「没有描边、
       也不受卡片外壳影响」（2026-09-18 LQ 反馈）。--btn-regular-bg 在两套模式下都与页面底
       拉开层次，且与 --btn-content 是主题既有的按钮对比度组合。 */
    border: 1px solid
      color-mix(in oklab, var(--primary) 20%, var(--line-divider));
    border-radius: 9999px;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .series-strip__tab:hover {
    color: var(--primary);
    background: var(--btn-regular-bg-hover);
    border-color: color-mix(in oklab, var(--primary) 45%, var(--line-divider));
  }
  .series-strip__tab:active {
    background: var(--btn-regular-bg-active);
  }
  .series-strip__tab[aria-selected="true"] {
    color: var(--primary);
    border-color: color-mix(in oklab, var(--primary) 55%, transparent);
    background: color-mix(in oklab, var(--primary) 14%, var(--btn-regular-bg));
  }
  .series-strip__tab:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* ===== 面板 ===== */
  .series-strip__panel {
    display: block;
    min-width: 0;
  }
  /* 非当前系列的面板（脚本切 class） */
  .series-strip__panel.is-hidden {
    display: none;
  }

  .series-strip__navs {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }
  .series-strip__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.875rem;
    height: 1.875rem;
    padding: 0;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: var(--btn-content);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      opacity 0.2s ease;
  }
  .series-strip__nav:not(:disabled):hover {
    color: var(--primary);
    background: color-mix(in oklab, var(--primary) 12%, transparent);
  }
  /* 到头 / 没得滚：置灰而不是整块隐藏 —— 控件一直在，用户知道「还有这个东西」 */
  .series-strip__nav:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .series-strip__nav:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .series-strip__viewport {
    container-type: inline-size;
    width: 100%;
    min-width: 0;
    /* 上下只留「悬浮上移 2px + 焦点环 2px + 投影」所需的最小余量：
       原 padding-bottom 0.875rem + 区块 margin-bottom 1rem = 卡片下方 30px 空白。 */
    padding-top: 0.375rem;
    padding-bottom: 0.625rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    touch-action: pan-x pan-y;
  }
  .series-strip__viewport::-webkit-scrollbar {
    display: none;
  }

  .series-strip__track {
    display: flex;
    gap: var(--series-gap);
    box-sizing: border-box;
    width: max-content;
    min-width: 100%;
    padding-inline: var(--series-edge);
  }

  .series-strip-card {
    --series-card-w: calc(
      (
          100cqi - (var(--series-visible) - 1) * var(--series-gap) - 2 *
            var(--series-edge) - 1px
        ) /
        var(--series-visible)
    );
    flex: 0 0 var(--series-card-w);
    flex-shrink: 0;
    width: var(--series-card-w);
    min-width: 0;
    box-sizing: border-box;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    /* 基线描边（= 卡片外壳关闭时）；外壳开启由下方规则置透明，让位给外壳的 outline */
    border: 1px solid var(--line-divider);
    border-radius: var(--radius-large);
    background: var(--card-bg);
    /* .card-base 的纹理 ::before 用 z-index:-1 定位，需要一个层叠上下文；
       ⚠️ 顺手把 .card-base 的 will-change:transform 打回 auto —— 系列条一行 4 张、
          且每个系列一个面板全部常驻 DOM，全量提升合成层不划算（isolation 已够用）。 */
    isolation: isolate;
    will-change: auto;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  /* 基线投影：**只在卡片外壳关闭时声明**。
     ⚠️ 本组样式是未分层(unlayered)的全局样式，优先级天然高于 components.css 的
        @layer components ⇒ 若无条件声明 box-shadow，会把
        `:root.mods-card-shell .card-base` 的外侧暗晕顶掉（外壳开关就白开了）。 */
  :root:not(.mods-card-shell) .series-strip-card {
    box-shadow:
      0 3px 8px color-mix(in srgb, #000 8%, transparent),
      0 1px 3px color-mix(in srgb, #000 5%, transparent);
  }
  :root:not(.mods-card-shell) .series-strip-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--primary) 45%, var(--line-divider));
    box-shadow:
      0 5px 12px color-mix(in srgb, #000 10%, transparent),
      0 1px 4px color-mix(in srgb, #000 6%, transparent);
  }
  /* 卡片外壳开启：外描边 / 暗晕 / 底部 hover 阴影全部交给外壳规则，
     只保留「上移 + 描边转主色」这两个属于交互的反馈。 */
  :root.mods-card-shell .series-strip-card {
    border-color: transparent;
  }
  :root.mods-card-shell .series-strip-card:hover {
    transform: translateY(-2px);
    outline-color: color-mix(in oklab, var(--primary) 45%, var(--line-divider));
  }
  .series-strip-card:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .series-strip-card__cover {
    position: relative;
    flex: none;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 0;
    overflow: hidden;
    background: color-mix(in oklab, var(--primary) 8%, var(--card-bg));
  }
  .series-strip-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* 无封面：模板已不输出 <img>，这里只管露出渐变 + 图标 */
  .series-strip-card__placeholder {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--btn-regular-bg-hover),
      var(--btn-regular-bg)
    );
  }
  .series-strip-card__cover.is-empty .series-strip-card__placeholder {
    display: flex;
  }

  /* 期号胶囊：左上角，半透明底 + 毛玻璃，压住再花的封面也读得清 */
  .series-strip-card__issue {
    position: absolute;
    top: 0.375rem;
    left: 0.375rem;
    z-index: 1;
    padding: 0.0625rem 0.375rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.5;
    color: #fff;
    background: color-mix(in srgb, #000 42%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .series-strip-card__body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 0.5rem 0.625rem 0.625rem;
    min-width: 0;
