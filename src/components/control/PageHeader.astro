---
// 分组页页头统一组件（上游 ca00c2e「全站统一仪表条」形态）。
//
// 形态（V3 仪表条）：眉题（图标 + 英文大写设计词）→ 大标题（左侧悬空主色竖线）
//   → 右侧统计方片组 + 动作槽（贴底对齐）→ 大图标水印（右下角）
//
// 约定（Thymeleaf 表达式字符串传 props）：
// - titleExpr / filteredExpr / filteredClearExpr 传完整表达式（含 ${} 或 #{}／@{}）
//   ⚠️ 必须带 ${} / #{} / @{} 包裹：裸 `#utility(...)` 在 th:* 上是非法值（validate-th 已加护栏）
// - titleExpr 缺省时 h1 内容改由默认 slot 渲染（wishes 用嵌套 span）
// - iconClass 只传 Iconify 类名**字面量**（Tailwind/Iconify 内容扫描才能生成图标规则，
//   勿动态拼接）；眉题内用 0.9rem，水印由 .ph-watermark 控制
// - eyebrow：静态英文大写设计词（ARCHIVES / MOMENTS …），不走 i18n
// - stats：数值 + 词条（valueExpr 数值表达式 / labelExpr 词条表达式）；无数字可展示的
//   页面不传 ⇒ 整个右区不输出。
//   🔴 stats 的 valueExpr **没有 th:if 短路保护**（旧版靠 subShowIfExpr 保护过变量），
//      引用可能为 null 的变量时必须写 `x == null ? 0 : 原表达式`。
// - 右侧按钮/徽章放 slot="right"
// - 容器契约：页头应由页面包在 `.page-head-card`（提供水印定位 / 氛围渐变 / 自带内边距）
//   里，页面本身不再加 px/py，`containerClass` 一般传空串
interface HeaderStat {
  valueExpr: string;
  value: string;
  labelExpr: string;
  label: string;
}

interface Props {
  containerClass: string;
  titleExpr?: string;
  title?: string;
  iconClass: string;
  /** 英文大写眉题：静态设计词（如 ARCHIVES / MOMENTS），不走 i18n */
  eyebrow?: string;
  filteredExpr?: string;
  /** 「已筛选」徽章的清除链接（Thymeleaf @{} 表达式） */
  filteredClearExpr?: string;
  /** 统计方片组（数值 + 词条） */
  stats?: HeaderStat[];
}

const {
  containerClass,
  titleExpr,
  title = "",
  iconClass,
  eyebrow,
  filteredExpr,
  filteredClearExpr,
  stats,
} = Astro.props;

// 右侧区（统计片 + 动作槽）是否有内容渲染：都没有时整个右区不输出
const hasRight = Astro.slots.has("right");
---

<div class={`page-head-modern ${containerClass}`.trim()}>
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
    <div class="min-w-0">
      <div
        class="inline-flex items-center gap-1.5 text-[0.72rem] font-extrabold tracking-[0.12em] text-(--primary)"
      >
        <span class={`${iconClass} text-[0.9rem]`}></span>
        <span>{eyebrow}</span>
      </div>
      <h1
        class="mt-1.5 text-[1.7rem] leading-[1.2] font-extrabold tracking-tight text-90 md:text-[1.95rem]"
        th:text={titleExpr}
      >
        {titleExpr ? title : <slot />}
      </h1>
    </div>
    {
      (stats && stats.length > 0) || hasRight ? (
        <div class="flex flex-wrap items-end gap-2.5">
          {stats?.map((st) => (
            <div class="stat">
              <b th:text={st.valueExpr}>{st.value}</b>
              <span th:text={st.labelExpr}>{st.label}</span>
            </div>
          ))}
          <slot name="right" />
        </div>
      ) : null
    }
  </div>
  {
    filteredExpr && (
      <a
        th:if={filteredExpr}
        th:href={filteredClearExpr}
        th:title="#{common.clearFilter}"
        class="ph-filter-chip"
      >
        <span th:text="#{common.filtered}">已筛选</span>
        <span
          class="icon-[material-symbols--close-rounded] text-[0.8rem]"
          aria-hidden="true"
        />
      </a>
    )
  }
  <span class={`ph-watermark ${iconClass}`} aria-hidden="true"></span>
</div>
