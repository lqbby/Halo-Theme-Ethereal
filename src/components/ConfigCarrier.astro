<!-- data-banner-title-default 只跟 bannerText.enable 走（2026-11-19）：
     原式还要求 title 或 subtitles 非空才判「启用」，但 HomeHeroCard 已改为自带
     硬编码标题、不再读这两项 ⇒ 标题留空的站点会被误判 disabled、整卡被
     visibility:hidden 隐藏（新装/重置配置必中）。 -->
<div
  id="config-carrier"
  th:data-hue="${theme.config?.style?.themeColor?.hue}"
  th:data-hue-fixed="${theme.config?.layout?.mobileMenu?.visitorStyle?.enable == false or theme.config?.layout?.mobileMenu?.visitorStyle?.appearance == false}"
  th:data-theme-name="${theme.metadata.name}"
  th:data-visitor-enable="${theme.config?.layout?.mobileMenu?.visitorStyle?.enable != false}"
  th:data-visitor-appearance="${theme.config?.layout?.mobileMenu?.visitorStyle?.appearance != false}"
  th:data-masonry-default="${theme.config?.layout?.postList?.grid?.masonry == true}"
  th:data-layout-default="${#strings.defaultString(theme.config?.layout?.postList?.defaultMode, 'list')}"
  th:data-visitor-wallpaper="${theme.config?.layout?.mobileMenu?.visitorStyle?.wallpaper != false}"
  th:data-visitor-fullscreen-layout="${theme.config?.layout?.mobileMenu?.visitorStyle?.fullscreenLayout != false}"
  th:data-banner-display-default="${#strings.defaultString(theme.config?.layout?.bannerLayout?.displayMode, 'banner')}"
  th:data-fullscreen-layout-default="${theme.config?.layout?.bannerLayout?.fullscreenLayout ?: 'classic'}"
  th:data-visitor-effects="${theme.config?.layout?.mobileMenu?.visitorStyle?.effects != false}"
  th:data-banner-title-default="${theme.config?.style?.bannerText?.enable != false}"
  th:data-wave-default="${theme.config?.style?.styleSwitches?.banner_wave != false and theme.config?.style?.styleSwitches?.banner_wave != 'disabled'}"
  th:data-card-hover-lift="${theme.config?.style?.styleSwitches?.card_hover_lift != false}"
  th:data-sakura-default="${theme.config?.style?.styleSwitches?.sakura == true}"
  th:data-navbar-blur="${theme.config?.style?.styleSwitches?.navbar_blur == true}"
  th:data-navbar-scroll-default="${theme.config?.layout?.mobileMenu?.navbarScroll == 'always' ? 'always' : 'auto_hide'}"
  th:data-page-wide-default="${(theme.config?.mods?.enable == null ? true : theme.config?.mods?.enable) and (theme.config?.mods?.pageWidth == null ? true : theme.config?.mods?.pageWidth)}"
  th:data-card-pattern-default="${(theme.config?.mods?.enable == null ? true : theme.config?.mods?.enable) and (theme.config?.mods?.cardPattern == null ? true : theme.config?.mods?.cardPattern)}"
  th:data-card-shell-default="${(theme.config?.mods?.enable == null ? true : theme.config?.mods?.enable) and (theme.config?.mods?.cardShell == true)}"
  th:data-wallpaper-opacity="${theme.config?.layout?.bannerLayout?.wallpaperOpacity ?: 0.8}"
  th:data-wallpaper-blur="${theme.config?.layout?.bannerLayout?.wallpaperBlur ?: 10}"
  th:data-wallpaper-card-alpha="${theme.config?.layout?.bannerLayout?.cardOpacity ?: 0.6}"
>
</div>
