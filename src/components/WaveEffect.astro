<!-- 波浪背景动画：CSS transform 平移实现（1.3.37 起移除 wave.js 的 rAF 改 viewBox 方案）。
     原 JS 每帧 setAttribute("viewBox") 触发主线程 layout/paint（移动端 TBT 主因，Lighthouse
     wave.js 主线程 ~2.2s）；现改为 3 层 SVG 各画 N 个重复周期、用 CSS @keyframes
     translateX 平移一个周期无缝循环——transform 走合成器线程、不占主线程，两端均流畅。
     周期密度与原版一致：三层周期 1440/960/720 逻辑 px（对应 1/0.667/0.5 视口宽），
     统一 viewBox 宽 2880（2×1440=3×960=4×720 的公倍数）保证各层平移整数周期无缝。
     时长 9s/4s/2s 与原 speeds[18,12,8] 的周期频率一致。
     三选开关渲染门：旧布尔 false 与 'disabled' 均不渲染；'desktop_only' 的移动端隐藏
     改用 @media(pointer:coarse) + data-wave-mode 属性（替代原 wave.js 运行时 matchMedia，
     因 Thymeleaf 无法判断 UA）。 -->
<div
  th:if="${theme.config?.style?.styleSwitches?.banner_wave != false && theme.config?.style?.styleSwitches?.banner_wave != 'disabled'}"
  th:attr="data-wave-mode=${theme.config?.style?.styleSwitches?.banner_wave}"
  id="wave-container"
  class="pointer-events-none absolute z-20 block left-0 right-0 h-32 sm:h-28 md:h-32 lg:h-36 overflow-hidden"
>
  <!-- 第1层：纯色背景波浪（2 周期，1440/周期） -->
  <svg
    id="wave-svg-1"
    viewBox="0 0 2880 200"
    preserveAspectRatio="none"
    class="wave-layer wave-layer-1 absolute bottom-0 left-0 h-full"
  >
    <path
      d="M0,120 Q360,160 720,120 T1440,120 T2160,120 T2880,120 L2880,200 L0,200 Z"
      fill="var(--page-bg)"></path>
  </svg>
  <!-- 第2层：半透明波浪（3 周期，960/周期） -->
  <svg
    id="wave-svg-2"
    viewBox="0 0 2880 200"
    preserveAspectRatio="none"
    class="wave-layer wave-layer-2 absolute bottom-0 left-0 h-full"
    style="opacity:0.75"
  >
    <defs>
      <linearGradient id="wg2" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--page-bg)" stop-opacity="0.15"
        ></stop>
        <stop offset="100%" stop-color="var(--page-bg)" stop-opacity="0.75"
        ></stop>
      </linearGradient>
    </defs>
    <path
      d="M0,80 Q240,120 480,80 T960,80 T1440,80 T1920,80 T2400,80 T2880,80 L2880,200 L0,200 Z"
      fill="url(#wg2)"></path>
  </svg>
  <!-- 第3层：半透明波浪（4 周期，720/周期） -->
  <svg
    id="wave-svg-3"
    viewBox="0 0 2880 200"
    preserveAspectRatio="none"
    class="wave-layer wave-layer-3 absolute bottom-0 left-0 h-full"
    style="opacity:0.6"
  >
    <defs>
      <linearGradient id="wg3" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--page-bg)" stop-opacity="0.12"
        ></stop>
        <stop offset="100%" stop-color="var(--page-bg)" stop-opacity="0.65"
        ></stop>
      </linearGradient>
    </defs>
    <path
      d="M0,60 Q180,95 360,60 T720,60 T1080,60 T1440,60 T1800,60 T2160,60 T2520,60 T2880,60 L2880,200 L0,200 Z"
      fill="url(#wg3)"></path>
  </svg>
</div>

<style is:global>
  /* 波浪层：宽度 200%（2×视口），viewBox 2880 拉伸到 200%，故 1 周期（1440 逻辑）
     仍映射 1 视口宽，与原 viewBox 1440+w-full 的密度一致。translateX 平移量为
     各层一个周期对应的百分比（50%/33.333%/25%），平移后图案无缝衔接。 */
  #wave-container .wave-layer {
    width: 200%;
  }

  #wave-container .wave-layer-1 {
    animation: ethereal-wave-1 9s linear infinite;
  }

  #wave-container .wave-layer-2 {
    animation: ethereal-wave-2 4s linear infinite;
  }

  #wave-container .wave-layer-3 {
    animation: ethereal-wave-3 2s linear infinite;
  }

  @keyframes ethereal-wave-1 {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes ethereal-wave-2 {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.333%);
    }
  }

  @keyframes ethereal-wave-3 {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }

  /* desktop_only：移动端（触屏）隐藏波浪容器（替代原 wave.js 的
     matchMedia("(pointer:coarse)") 运行时守卫）。桌面端 pointer:fine 不受影响。 */
  @media (pointer: coarse) {
    #wave-container[data-wave-mode="desktop_only"] {
      display: none !important;
    }
  }
</style>
