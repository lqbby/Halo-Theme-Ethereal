---
/**
 * 列表页顶部「两张精选卡片」（1.5.29 首版 → 1.5.31 按参考站 https://daily.yybb.us/ 逐条对齐）
 *
 *   左「随机一篇」= 参考站的 home-desktop-spotlight__random：
 *     · 图标群装在 rotate(-30deg) 的容器里、整行 translate3d(0→-33.33%) 以 50s linear infinite
 *       循环 ⇒ 视觉上就是 LQ 要的「斜着往下（左下）一直缓慢流动」；
 *     · 点击**不再**是「方块整组转一圈」，而是拉开**全屏 3D 转盘**把一篇文章「转」出来
 *       （参考站的 random-post-carousel，见 src/scripts/assets/_random-post-carousel.ts）。
 *
 *   右「热门 / 最近」= 参考站的 home-desktop-spotlight__pins：
 *     · 多张卡绝对定位叠在一起，靠 is-front / is-mid / is-back 三档 transform 区分
 *       （translate3d(5px,4px,-12px) rotate(1.4deg) scale(.985) 等，全抄参考站），
 *       `.featured-stack` 给 perspective:900px 才有立体错位感；
 *     · 左右两枚圆形箭头（‹ ›）在 hover / focus-within 时浮现 ⇒ 就是 LQ 说的「下一页的切换」。
 *
 * 复刻依据：直接抓参考站 HTML + main.min.css + main.min.js 逐条比对（不靠印象）。
 *   · 卡片总高 148px（参考站 --desktop-spotlight-height:148px）、左右列宽 3.5fr / 6.5fr；
 *   · 图标格 2.9rem / 圆角 .7rem、列宽 3.15rem、列内间隔 .35rem、偶数列左移 .85rem；
 *   · 转盘：面数 10、spin 1600ms + ease 800ms + hold 700ms、tilt -2.5deg、perspective 3000px。
 *
 * 实现取舍：
 *  ① 数据不进 Thymeleaf-JSON：转盘面池与右卡文章都由脚本**运行时**从 REST 取（沿用 1.5.29 的路子），
 *     省掉「服务端拼 JSON + 双引号转义」这条易错链路；无 JS 时左卡不可点（与 1.5.29 一致）。
 *  ② 右卡服务端**先渲染 3~4 张真卡**（posts.items 前 4 篇）⇒ 脚本挂了/取数失败仍有内容（渐进增强），
 *     脚本只做「填字段 + 换档位」，不在 JS 里拼卡片结构，也就不在 JS 里出现中文。
 *  ③ 取数一律走 `fetchWithTimeout`（1.5.27 的共享工具）：挂住的请求不能让卡片永久 loading。
 *  ④ 文案由 Thymeleaf 经**隐藏文本节点**（th:text）透传给脚本，脚本里不写中文。
 */
import { imageSuffixThWith } from "../utils/image-suffix";

/**
 * 左卡流动的图标格：12 个 = 参考站那 12 个格子（品牌色逐格对齐），
 * 图标本体换成主题已装图标集里最接近的品牌图标（fa6-brands / mdi）。
 * ⚠️ 类名必须写成完整字面量，Tailwind 才扫得到；`collection--name` 是双横线写法。
 */
const TILES: { icon: string; color: string }[] = [
  { icon: "icon-[fa6-brands--github]", color: "#358bff" },
  { icon: "icon-[fa6-brands--markdown]", color: "#15c6ff" },
  { icon: "icon-[mdi--language-typescript]", color: "#3178c6" },
  { icon: "icon-[fa6-brands--css3-alt]", color: "#2965f1" },
  { icon: "icon-[fa6-brands--python]", color: "#3776ab" },
  { icon: "icon-[fa6-brands--vuejs]", color: "#42b883" },
  { icon: "icon-[fa6-brands--sass]", color: "#cd6799" },
  { icon: "icon-[fa6-brands--node-js]", color: "#339933" },
  { icon: "icon-[fa6-brands--docker]", color: "#2496ed" },
  { icon: "icon-[fa6-brands--cloudflare]", color: "#f38020" },
  { icon: "icon-[fa6-brands--figma]", color: "#a259ff" },
  { icon: "icon-[fa6-brands--js]", color: "#f7df1e" },
];

/** 每列 2 格（对齐参考站的 __random-tags-pair） */
const TILE_PAIRS: { icon: string; color: string }[][] = [];
for (let i = 0; i < TILES.length; i += 2)
  TILE_PAIRS.push(TILES.slice(i, i + 2));

/**
 * 复制份数：动画位移必须是**整数份**才能无缝接回（-1/3 对应 3 份）。
 * 3 份还能保证整行宽度稳超「容器 175%」⇒ 右上角不会露出空白。
 */
const TILE_COPIES = 3;
const TILE_COPY_LIST = Array.from({ length: TILE_COPIES }, (_, i) => i);
---

<div
  id="featured-cards"
  class="featured-row onload-animation"
  th:with="
    fcItems=${posts.items},
    fcSource=${theme.config?.layout?.postList?.featuredSource ?: 'recent'},
    fcRandom=${theme.config?.layout?.postList?.featuredRandom == null or theme.config?.layout?.postList?.featuredRandom}"
  th:classappend="${fcRandom ? '' : ' no-random'}"
  th:attr="
    data-source=${fcSource},
    data-img-provider=${theme.config?.performance?.imageProcessing?.provider ?: 'none'},
    data-img-format=${theme.config?.performance?.imageProcessing?.custom_format ?: ''}"
  th:style="|animation-delay: var(--content-delay)|"
>
  <!-- 脚本要用的文案（中文只在模板里，见文件头「实现取舍 ④」） -->
  <span class="hidden" data-label-popular th:text="#{featured.badge.popular}"
    >热门文章</span
  >
  <span class="hidden" data-label-recent th:text="#{featured.badge.recent}"
    >最近文章</span
  >
  <span class="hidden" data-label-random th:text="#{featured.random.title}"
    >随机一篇文章</span
  >
  <span class="hidden" data-label-hint th:text="#{featured.ring.hint}"
    >按 Esc 取消</span
  >

  <!-- ============ 左：随机一篇（点击 → 全屏转盘把一篇文章「转」出来） ============ -->
  <button
    type="button"
    id="featured-random"
    class="featured-card featured-card--random"
    th:if="${fcRandom}"
    th:aria-label="#{featured.random.title}"
    th:title="#{featured.random.title}"
  >
    <span class="featured-random-face" aria-hidden="true">
      <span class="featured-random-face-title" th:text="${site.title}"
        >Ethereal</span
      >
      <span class="featured-random-face-desc" th:text="#{featured.random.desc}"
        >看点什么好呢</span
      >

      <!-- 斜向流动的图标群：容器 -30° + 整行循环位移 = 「斜着往下动」 -->
      <span class="featured-random-tags">
        <span class="featured-random-tags-group">
          <span class="featured-random-tags-scroll">
            {
              TILE_COPY_LIST.map(() =>
                TILE_PAIRS.map((pair) => (
                  <span class="featured-random-tags-pair">
                    {pair.map((tile) => (
                      <span
                        class="featured-random-tags-icon"
                        style={`--tile-bg:${tile.color}`}
                      >
                        <span class={`${tile.icon} text-2xl leading-none`} />
                      </span>
                    ))}
                  </span>
                )),
              )
            }
          </span>
        </span>
      </span>
    </span>

    <span class="featured-random-action">
      <span class="leading-none" th:text="#{featured.random.action}"
        >摇一篇</span
      >
      <span
        class="icon-[material-symbols--arrow-right-alt-rounded] text-base leading-none"
      ></span>
    </span>
  </button>

  <!-- ============ 右：热门 / 最近 文章（3~4 张叠层 + ‹ › 换档） ============ -->
  <div
    class="featured-pins"
    data-featured-pins
    th:if="${fcItems != null and #lists.size(fcItems) > 0}"
  >
    <div class="featured-stack">
      <a
        th:each="fcPost, fcStat : ${fcItems}"
        th:if="${fcStat.index < 4}"
        class="featured-card featured-card--post"
        href="/"
        th:href="@{${fcPost.status.permalink}}"
        th:aria-label="${fcPost.spec.title}"
        th:classappend="${fcStat.index == 0
          ? ' is-front'
          : (fcStat.index == 1 ? ' is-mid' : (fcStat.index == 2 ? ' is-back' : ' is-hidden'))}"
        th:attr="data-state=${fcSource == 'popular' ? 'pending' : 'ready'}"
      >
        <!-- 右上角星标（对齐参考图右上角那枚星） -->
        <span class="featured-star" aria-hidden="true">
          <span
            class="icon-[material-symbols--star-rounded] text-[1.15rem] leading-none"
          ></span>
        </span>

        <!-- 封面：单元素 + is-cover-empty 类（脚本要双向切换有无封面） -->
        <span
          class="featured-cover"
          data-featured-cover
          th:classappend="${#strings.isEmpty(fcPost.spec.cover) ? ' is-cover-empty' : ''}"
        >
          <span class="featured-veil"></span>
          <span class="featured-arrow">
            <span class="featured-arrow-chip">
              <span
                class="icon-[material-symbols--chevron-right-rounded] text-4xl leading-none"
              ></span>
            </span>
          </span>
          <img
            class="featured-img"
            th:src="${#strings.isEmpty(fcPost.spec.cover) ? null : fcPost.spec.cover + suffix}"
            th:alt="${fcPost.spec.title}"
            th:with={imageSuffixThWith("800")}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <span class="featured-cover-fallback" aria-hidden="true">
            <span
              class="icon-[material-symbols--article-outline-rounded] text-5xl leading-none text-(--primary)"
            ></span>
          </span>
        </span>

        <span class="featured-body">
          <span
            class="featured-title"
            data-featured-title
            th:text="${fcPost.spec.title}">Post title</span
          >
          <span
            class="featured-excerpt"
            data-featured-excerpt
            th:text="${fcPost.status.excerpt}">Excerpt</span
          >

          <!-- 底行：左「来源徽章 + 分类色块」，右「日期」（对齐参考图） -->
          <span class="featured-card-foot">
            <span class="featured-badge featured-badge--source">
              <span
                class="icon-[material-symbols--local-fire-department-rounded] text-[.9rem] leading-none"
              ></span>
              <span
                class="leading-none"
                data-featured-badge
                th:text="#{featured.badge.recent}">最近文章</span
              >
            </span>
            <span
              class="featured-cat"
              th:classappend="${#lists.isEmpty(fcPost.categories) ? ' is-hidden' : ''}"
            >
              <span
                class="featured-cat-square"
                data-featured-cat-square
                th:attr="data-cat=${not #lists.isEmpty(fcPost.categories) ? fcPost.categories[0].spec.displayName : ''}"
              ></span>
              <span
                class="leading-none"
                data-featured-cat
                th:text="${not #lists.isEmpty(fcPost.categories) ? fcPost.categories[0].spec.displayName : ''}"
                >分类</span
              >
            </span>
            <span class="featured-meta">
              <span
                class="icon-[material-symbols--calendar-today-outline-rounded] text-[.9rem] leading-none"
              ></span>
              <span
                class="leading-none"
                data-featured-date
                th:text="${#dates.format(fcPost.spec.publishTime, 'yyyy-MM-dd')}"
                >2026-01-01</span
              >
            </span>
          </span>
        </span>
      </a>
    </div>

    <!-- ‹ › 换档（参考站 data-spotlight-prev/next）：hover / focus-within 才浮现 -->
    <div class="featured-navs" data-featured-navs>
      <button
        type="button"
        class="featured-nav featured-nav--prev"
        data-dir="prev"
        th:aria-label="#{featured.nav.prev}"
      >
        <span
          class="icon-[material-symbols--chevron-left-rounded] text-xl leading-none"
        ></span>
      </button>
      <button
        type="button"
        class="featured-nav featured-nav--next"
        data-dir="next"
        th:aria-label="#{featured.nav.next}"
      >
        <span
          class="icon-[material-symbols--chevron-right-rounded] text-xl leading-none"
        ></span>
      </button>
    </div>
  </div>
</div>

<!-- 行为脚本（经典脚本产物）：左卡随机跳转（全屏转盘）+ 右卡按来源填充与换档 -->
<script
  src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/featured-cards.js?v=${ASSET_VERSION}`}
  defer></script>

<style is:global>
  /* ===== 顶部两卡行 =====
     ⚠️ 尺寸（148px 高 / 3.5fr:6.5fr / 各内距）全是参考站逐个量出来的，改一处要回看配平。 */
  .featured-row {
    --featured-h: 9.25rem; /* 148px */
    display: grid;
    grid-template-columns: minmax(0, 3.5fr) minmax(0, 6.5fr);
    gap: 0.625rem;
    margin-bottom: 1rem;
  }
  .featured-row.no-random {
    grid-template-columns: minmax(0, 1fr);
  }

  .featured-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-large);
    text-decoration: none;
    color: inherit;
    border: 1px solid
      color-mix(
        in oklab,
        var(--primary) 18%,
        color-mix(in oklab, var(--deep-text) 12%, transparent)
      );
    background: var(--card-bg);
    box-shadow: 0 3px 8px color-mix(in srgb, #000 8%, transparent);
    transition:
      box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease;
  }
  .featured-card:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* ---------- ① 左卡：斜向流动的图标群 ---------- */
  .featured-card--random {
    height: var(--featured-h);
    padding: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    /* 图标群故意画到卡外再被这里裁掉（= 参考图那种「窗开到图标场里」的出血感） */
    contain: layout paint style;
    isolation: isolate;
  }
  .featured-card--random:hover {
    border-color: color-mix(in oklab, var(--primary) 40%, transparent);
    box-shadow:
      0 5px 12px color-mix(in srgb, #000 10%, transparent),
      0 1px 4px color-mix(in srgb, #000 6%, transparent);
  }
  .featured-card--random:active {
    transform: scale(0.995);
    transition-duration: 0.08s;
  }

  .featured-random-face {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .featured-random-face-title {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    max-width: calc(100% - 2rem);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--deep-text);
    pointer-events: none;
  }
  .featured-random-face-desc {
    position: absolute;
    top: calc(1rem + 1.35em);
    left: 1rem;
    z-index: 2;
    max-width: calc(100% - 2rem);
    font-size: 0.75rem;
    line-height: 1.35;
    color: color-mix(in oklab, var(--deep-text) 62%, transparent);
    pointer-events: none;
  }

  /* 图标群：外层 -30°，内层整行循环位移 ⇒ 运动方向 = 旋转坐标系的 -X = 左下（「斜着往下」） */
  .featured-random-tags {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
  }
  .featured-random-tags-group {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 175%;
    height: 175%;
    transform: translate3d(calc(-50% + 2.25rem), calc(-50% + 2.65rem), 0)
      rotate(-30deg);
    transform-origin: center center;
    backface-visibility: hidden;
  }
  .featured-random-tags-scroll {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 0.5rem;
    width: max-content;
    min-width: 100%;
    margin-top: 2.85rem;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    /* 位移必须正好一份（3 份 ⇒ -33.3333%），否则循环接不齐会有跳帧 */
    animation: featured-tile-flow 50s linear infinite;
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform;
  }
  @keyframes featured-tile-flow {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-33.3333%, 0, 0);
    }
  }
  .featured-random-tags-pair {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 0.35rem;
    width: 3.15rem;
  }
  .featured-random-tags-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 0.7rem;
    color: #fff;
    /* ⚠️ 每格的底色由行内 --tile-bg 给（写死在这里就全同色了）；缺值时回落到主色 */
    background: var(--tile-bg, var(--primary));
    box-shadow: 0 2px 6px color-mix(in srgb, #000 12%, transparent);
    overflow: hidden;
    contain: layout paint;
  }
  /* 偶数列整列左移 ⇒ 两列错开半个身位，才像参考图那种「斜向铺开」而不是方正网格 */
  .featured-random-tags-pair .featured-random-tags-icon:nth-child(even) {
    transform: translateX(-0.85rem);
  }

  /* 左下角动作提示：图标群是彩色的，纯文字压上去读不清 ⇒ 垫一层卡底色的胶囊 */
  .featured-random-action {
    position: absolute;
    left: 1rem;
    bottom: 0.8rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.15rem 0.45rem;
    border-radius: 0.375rem;
    background: color-mix(in oklab, var(--card-bg) 78%, transparent);
    backdrop-filter: blur(3px);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--primary);
    pointer-events: none;
    transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .featured-card--random:hover .featured-random-action {
    transform: translateX(2px);
  }

  /* ---------- ② 右卡：三档叠层 + ‹ › 换档 ---------- */
  .featured-pins {
    position: relative;
    min-width: 0;
    height: var(--featured-h);
  }
  /* perspective 是「叠起来」的关键：没有它，下面那几张只是平面平移，看不出前后 */
  .featured-stack {
    position: absolute;
    inset: 0;
    perspective: 900px;
  }
  .featured-card--post {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 42fr 58fr;
    grid-template-rows: minmax(0, 1fr);
    border-radius: var(--radius-large);
    box-shadow: 0 10px 22px color-mix(in srgb, #000 10%, transparent);
    transform-origin: center bottom;
    /* z-index 也参与过渡：换档时先让新前牌拿到高的 z，再落下位置 */
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      box-shadow 0.35s ease,
      z-index 0s linear 0.2s;
  }
  /* 四档位（数值全抄参考站）*/
  .featured-card--post.is-front {
    z-index: 3;
    opacity: 1;
    transform: translate3d(0, 0, 0) rotate(0) scale(1);
    box-shadow: 0 14px 28px color-mix(in srgb, #000 14%, transparent);
    pointer-events: auto;
  }
  .featured-card--post.is-mid {
    z-index: 2;
    opacity: 0.94;
    transform: translate3d(5px, 4px, -12px) rotate(1.4deg) scale(0.985);
    pointer-events: none;
  }
  .featured-card--post.is-back {
    z-index: 1;
    opacity: 0.84;
    transform: translate3d(-5px, 7px, -24px) rotate(-1.8deg) scale(0.97);
    pointer-events: none;
  }
  .featured-card--post.is-hidden {
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 10px, -36px) scale(0.95);
    pointer-events: none;
  }
  .featured-card--post.is-front:hover {
    transform: translate3d(0, -3px, 0) rotate(0) scale(1.004);
    box-shadow: 0 18px 34px color-mix(in srgb, #000 18%, transparent);
  }

  /* ‹ › 换档箭头（参考站 __nav）：默认透明+不接收事件，hover/focus-within 才浮现 */
  .featured-navs {
    position: absolute;
    inset: 0;
    z-index: 8;
    pointer-events: none;
  }
  .featured-navs[hidden] {
    display: none;
  }
  .featured-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid color-mix(in oklab, var(--deep-text) 12%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--card-bg) 92%, transparent);
    color: var(--deep-text);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 4px 14px color-mix(in srgb, #000 12%, transparent);
    transition:
      opacity 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .featured-nav--prev {
    left: 0.625rem;
  }
  .featured-nav--next {
    right: 0.625rem;
  }
  .featured-nav:hover {
