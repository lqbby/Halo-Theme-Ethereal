---
import PostMeta from "./PostMeta.astro";
import PostCardSeriesBadge from "./PostCardSeriesBadge.astro";
import { imageSuffixThWith } from "../utils/image-suffix";

/**
 * 卡片级 th:with（1.5.57）。
 *
 * 🔴🔴 **顺序敏感**：`th:with` 里的变量只能引用**排在它前面**的。真引擎实测（ThRenderProbe
 *      --semantics）：逆序引用抛 `EL1001E: cannot convert from null to boolean`
 *      ⇒ 页面 200 但整块渲染截断。coverEmpty → postWordCount → readMinutes →
 *      seriesName 的先后不能动。
 * 🔴🔴 **三元运算符的条件不能是「可能为 null 的布尔值」**：同样抛 EL1001E。
 *      一律写成**比较式**（`x != null ? … : …`、`a == b`），别写 `${someNullableBool ? …}`。
 * 🔴 Finder 调用必须**内联**短路守卫（`pluginFinder != null and pluginFinder.available(...)`）：
 *      pluginFinder 缺失 / 插件未装时绝不能去解析 `extraApiStatsFinder`，
 *      否则整页 SpEL 异常（200 但正文截断）。
 *
 * 各变量：
 *   coverEmpty     —— 无封面标记；供 classappend 与「角标挂封面还是挂 eyebrow」分流
 *   postWordCount  —— extra-api 插件按篇字数（插件启动即缓存好 ⇒ 卡片零请求）。**1.5.58 起只喂给
 *                     readMinutes，底栏不再单独显示它**（eyebrow 的「N 分钟」已表达同一信息，
 *                     而它是底栏最宽的一项 63px）。取不到给 0 ⇒ 阅读时长那一项不渲染。
 *   readMinutes    —— 阅读时长（分钟）。**口径与文章页完全一致**：`Math.max(1, ceil(字数/400))`。
 *                     这里用整数除法 `(n + 399) div 400` 代替 `Math.ceil` —— 真引擎实测 7→1、400→1、
 *                     401→2、0→0，与 ceil 等价；**不用 `T(java.lang.Math)`**，那要类型白名单，不保证放行。
 *   seriesName     —— 文章上的 `series` 注解。实测线上列表接口就带 metadata.annotations ⇒ 直接读
 *                     metadata POJO，**不必依赖 Halo 的 `#annotations` 方言**。父为 null 必须先判空：
 *                     裸索引 `${nilMap['series']}` 会抛 `EL1012E: Cannot index into a null value`。
 *
 * ⚠️ **本组件不再自己取「该系列的全部文章」**：那要调 `recentCommentsSeriesFinder.get(name)`，
 *    而插件里它=每次全表扫（无缓存）⇒ 一页 9 张卡 = 9 次全表扫。现在改由 `PostList.astro`
 *    的容器 `th:with` 取**一次** `listAll()`（变量名 `seriesAll`），卡片角标从祖先作用域读它、
 *    按名挑自己的系列。详见 `src/utils/post-list-config.ts` 的同名注释。
 */
const cardThWith: string =
  "coverEmpty=${#strings.isEmpty(post.spec.cover)}, " +
  "postWordCount=${pluginFinder != null and pluginFinder.available('extra-api', '3.*') " +
  "? extraApiStatsFinder.getPostWordCount({name: post.metadata.name}) : 0}, " +
  "readMinutes=${(postWordCount + 399) div 400}, " +
  "seriesName=${post.metadata.annotations != null ? post.metadata.annotations['series'] : null}";
---

<!-- 结构（1.5.57 重构）。DOM 序与视觉序相反，靠 flex 方向翻转：
       · 网格 / 移动端：封面在上、内容在下（`column-reverse` / `flex-col-reverse`）
       · 列表模式桌面端：内容在左、封面绝对定位在右（`md:flex-col` + 封面 `md:absolute`）
     内容区内部顺序 = 视觉顺序：eyebrow（分类·日期·时长）→ 标题 → 摘要 → 合并底栏。
     ⚠️ eyebrow 提到标题**之上**是刻意的：分类/日期是「栏目前缀」，先于标题更好扫读，也顺带给
        阅读时长一个位置。这条会同时影响列表 / 网格 / 瀑布流三态（三态共用本组件）。 -->
<article
  class="card-base post-card relative flex w-full flex-col-reverse rounded-(--radius-large) md:flex-col card-hover-lift overflow-hidden"
  th:with={cardThWith}
  th:classappend="${(coverEmpty ? ' no-cover' : ' has-cover') + (post.spec.pinned == true ? ' is-pinned' : '') + (theme.config?.layout?.postList?.coverContainMode == true ? ' cover-contain' : '')}"
>
  <div
    class="post-card-content relative flex w-full flex-col pb-6 pl-6 pr-6 pt-6 md:pb-6 md:pl-9 md:pt-7"
  >
    <!-- ① eyebrow 行：分类 · 日期 · [系列 chip] · 阅读时长
         ⚠️ 置顶胶囊由 PostMeta 渲染，但有封面时会被 CSS 隐藏（改由封面右上角的角标承担）——
            底栏合并后 eyebrow 行本身要挤下「日期 + 分类 + 时长」，再塞个置顶就溢出了。
         ⚠️ 系列 chip 只在**无封面**卡上出现（有封面时角标挂封面）；inline 变体在列表模式桌面端
            也会顶上来（那时封面是条窄竖条、挂不下角标），切换规则见 PostList.astro。 -->
    <div
      class="post-card-eyebrow mb-2 flex flex-wrap items-center gap-x-3 gap-y-1.5"
    >
      <PostMeta hideTags={true} hideUpdateDate={true} class="post-meta" />
      <div th:remove="tag" th:if="${coverEmpty}">
        <PostCardSeriesBadge variant="inline" />
      </div>
      <!-- 阅读时长：与「字数」同一数据源（extra-api 按篇字数）⇒ 同时出现时口径自洽 -->
      <span
        class="post-card-reading-time inline-flex items-center gap-1 text-sm text-50"
        th:if="${postWordCount > 0}"
      >
        <span
          class="icon-[material-symbols--schedule-rounded] text-base leading-none"
        ></span>
        <span
          class="leading-none"
          th:text="#{postCard.readingTime(${readMinutes})}">5 分钟</span
        >
      </span>
    </div>

    <!-- ② 标题 -->
    <a
      th:href="@{${post.status.permalink}}"
      class="post-card-title relative group mb-3 block w-full font-bold text-90 transition before:absolute before:-left-[18px] before:top-2 before:hidden before:h-5 before:w-1 before:rounded-md before:bg-(--primary) hover:text-(--primary) active:text-(--title-active) dark:hover:text-(--primary) dark:active:text-(--title-active) md:before:block"
    >
      <span th:text="${post.spec.title}">Post title</span>
      <span
        class="post-card-arrow icon-[material-symbols--chevron-right-rounded] absolute z-30 hidden -translate-x-1 -translate-y-1/2 text-[2rem] text-(--primary) opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100 top-1/2 md:inline"
      ></span>
    </a>

    <!-- ③ 摘要 -->
    <div
      class="post-card-excerpt grow mb-3.5 pr-4 text-75 transition"
      th:classappend="${theme.config?.layout?.postList?.descriptionLines == 0 ? ' no-clamp' : ''}"
      th:text="${post.status.excerpt}"
    >
      Excerpt
    </div>

    <!-- ④ 合并底栏：标签行与统计行**并成一条**带 border-t 的底栏 —— 左标签、右统计。
         【设计契约 · 2026-09-21 定，1.5.58】底栏**恒为单行**，靠一条**容器查询**分档
         （判据挂 `.post-card-content`，参数见 PostList.astro）：
           · 卡片内容 <400px（桌面网格 / 移动端）→ 紧档：chip 11px·px-1.5、统计间距 8px、项内 4px、
             最多 **2** 个标签
           · 卡片内容 ≥400px（桌面列表）→ 宽松档：chip 12px·px-2.5、统计间距 12px、项内 6px、
             最多 **3** 个标签
         ⚠️ 因此标签**服务端渲染 3 个**、窄档由 CSS 收起第 3 个（`--extra`）；`+N` 同理渲染
            **两份**（按 2 算 / 按 3 算，title 各对应）由 CSS 切换 —— 服务端算不出卡片最终宽度，
            **绝不能靠 overflow 裁切假装**（那会让 +N 计数与实际隐藏数不符）。
         ⚠️ 数字不做千/万缩写：点赞计数由 post-card-like.js 在初始化时**用原始数字覆盖**文本
            （它只从 data-count 读值），缩写会被立刻冲掉；只缩写其余两项又会让底栏缩写口径不一致
            ⇒ 统一不缩写。
         ⚠️ 无标签时只剩统计组 ⇒ 需要 `justify-content: flex-end` 把它推到右侧（见 PostList.astro）。
         ⚠️ 整条底栏带 th:if 守卫：两个来源（标签 / 统计）**全空**时整条不渲染，
            否则会留下一条只有 border-t 的悬空细线，看起来像渲染坏了。
         ⚠️ 「字数」项 1.5.58 移除：eyebrow 的阅读时长与它同源（extra-api 按篇字数），是同一信息的
            两种表达；而它又是最宽的一项（实测 63px）—— 去掉它才让「2 标签 + 3 统计」
            在 288px 硬预算（最窄网格卡 320px − 32px 内距，也是 320px 视口手机的值）下落得下。 -->
    <div
      class="post-card-bottom mt-auto flex items-center justify-between gap-2 border-t pt-3 text-sm text-50 transition"
      th:if="${not #lists.isEmpty(post.tags) or post.stats != null}"
      th:classappend="${#lists.isEmpty(post.tags) ? ' no-tags' : ''}"
    >
      <!-- 左：标签（窄档 2 个 / 宽档 3 个，超出折叠为 +N）
           ⚠️ 上限由**容器查询**决定（见 PostList.astro）⇒ 这里渲染到 3 个、窄档用 CSS 收起第 3 个
              （`--extra`）。第 3 个被收起时必须换成「按 2 算」的 `+N` ⇒ 两份都渲染、由 CSS 切换。
              这是服务端算不出卡片宽度时，唯一能保证 `+N` 计数与实际隐藏数一致的做法。
           ⚠️ `th:title` 给全名：窄档 chip 允许收缩并把超出部分省略成 `…`（见 PostList.astro），
              悬停能看回完整标签名；`th:aria-label` 则让读屏始终拿到全名。 -->
      <div
        class="post-card-bottom-tags flex min-w-0 items-center gap-1.5 overflow-hidden"
        th:if="${not #lists.isEmpty(post.tags)}"
      >
        <a
          th:each="tag, tagStat : ${post.tags}"
          th:if="${tagStat.index < 3}"
          th:classappend="${tagStat.index >= 2 ? ' post-card-tag--extra' : ''}"
          th:href="@{${tag.status.permalink}}"
          th:aria-label="${tag.spec.displayName}"
          th:title="${'#' + tag.spec.displayName}"
          class="post-card-tag inline-flex shrink-0 items-center rounded-full px-2.5 py-1 text-xs font-medium transition"
        >
          <span th:text="${'#' + tag.spec.displayName}">#Tag</span>
        </a>
        <!-- +N 两份：紧档按「已显示 2 个」算，宽松档按「已显示 3 个」算（title 同步） -->
        <span
          th:if="${#lists.size(post.tags) > 2}"
          th:title="|还有 ${#lists.size(post.tags) - 2} 个标签|"
          class="post-card-tag post-card-tag-more post-card-tag-more--compact inline-flex shrink-0 items-center rounded-full px-2.5 py-1 text-xs font-medium transition"
        >
          +<span th:text="${#lists.size(post.tags) - 2}">2</span>
        </span>
        <span
          th:if="${#lists.size(post.tags) > 3}"
          th:title="|还有 ${#lists.size(post.tags) - 3} 个标签|"
          class="post-card-tag post-card-tag-more post-card-tag-more--wide inline-flex shrink-0 items-center rounded-full px-2.5 py-1 text-xs font-medium transition"
        >
          +<span th:text="${#lists.size(post.tags) - 3}">2</span>
        </span>
      </div>

      <!-- 右：统计（浏览 / 评论 / 点赞）
           1.5.58 移除「字数」项：它与 eyebrow 的阅读时长同源、是同一信息的两种表达，且是最宽的
           一项（实测 63px）—— 去掉它才让「2 标签 + 3 统计」在 288px 硬预算下落得下。
           点赞是唯一带交互态的项，置于末位避免被静态数字夹住。
           🔴 选择器 .post-card-stat-like / .post-card-like-count 与 data-post / data-count 是
              post-card-like.js 的契约，不许改名。 -->
      <div class="post-card-stats flex shrink-0 items-center gap-3">
        <span
          th:if="${post.stats != null}"
          class="post-card-stat inline-flex items-center gap-1.5"
        >
          <span
            class="icon-[material-symbols--visibility-outline-rounded] text-base leading-none"
          ></span>
          <span class="leading-none" th:text="${post.stats.visit}">0</span>
        </span>
        <a
          th:if="${post.stats != null}"
          th:href="${post.status.permalink + '#comment'}"
          th:aria-label="评论"
          class="post-card-stat post-card-stat-link inline-flex items-center gap-1.5"
        >
          <span class="icon-[mdi--comment-text-outline] text-base leading-none"
          ></span>
          <span class="leading-none" th:text="${post.stats.comment}">0</span>
        </a>
        <button
          type="button"
          th:if="${post.stats != null and theme.config?.post?.actionBar?.like == true}"
          th:attr="data-post=${post.metadata.name}"
          th:data-count="${post.stats.upvote}"
          aria-label="点赞"
          class="post-card-stat post-card-stat-like inline-flex cursor-pointer items-center gap-1.5 border-none bg-transparent"
        >
          <span class="relative inline-flex text-base leading-none">
            <span
              class="stat-heart-outline icon-[material-symbols--favorite-outline-rounded]"
            ></span>
            <span
              class="stat-heart-filled icon-[material-symbols--favorite-rounded] absolute inset-0 opacity-0"
            ></span>
          </span>
          <span
            class="post-card-like-count leading-none"
            th:text="${post.stats.upvote}">0</span
          >
        </button>
      </div>
    </div>
  </div>

  <a
    th:if="${not #strings.isEmpty(post.spec.cover)}"
    th:href="@{${post.status.permalink}}"
    th:aria-label="${post.spec.title}"
    th:with={imageSuffixThWith("p?.card_cover_width ?: 400")}
    class="post-card-cover group relative mx-4 -mb-2 mt-4 w-[calc(100%-2rem)] max-h-[20vh] overflow-hidden rounded-xl active:scale-95 aspect-[16/9] md:aspect-auto md:absolute md:bottom-3 md:right-3 md:top-3 md:mx-0 md:mb-0 md:mt-0 md:max-h-none md:w-(--post-card-cover-width)"
  >
    <!-- 设计型封面裁切（coverContainMode）的模糊填充层：仅开启时渲染（关时零 DOM 变化）。
         背景图与下方封面 <img> 同源同址（含同一 suffix），浏览器命中缓存、不发额外请求；
         样式（blur + scale + cover 填充）见 PostList.astro 的 .cover-contain 规则 -->
    <span
      class="post-card-cover-bg"
      aria-hidden="true"
      th:if="${theme.config?.layout?.postList?.coverContainMode == true}"
      th:style="|background-image: url('${post.spec.cover}${suffix}')|"></span>
    <div
      class="pointer-events-none absolute z-10 h-full w-full transition group-hover:bg-black/30 group-active:bg-black/50"
    >
    </div>
    <div
      class="pointer-events-none absolute z-20 flex h-full w-full items-center justify-center"
    >
      <span
        class="icon-[material-symbols--chevron-right-rounded] scale-50 text-5xl text-white opacity-0 transition group-hover:scale-100 group-hover:opacity-100"
      ></span>
    </div>
    <!-- 封面角标层（z-30 盖住上面两层遮罩）：左系列、右置顶。
         ⚠️ 父 <a> 已写死 aria-label=标题 ⇒ 这里的文字不会污染链接的可访问名。
         ⚠️ pointer-events-none：角标纯标识，点击应落到整张封面链接上。 -->
    <span
      class="post-card-badges pointer-events-none absolute inset-x-2 top-2 z-30 flex items-start justify-between gap-2"
    >
      <PostCardSeriesBadge variant="cover" />
      <span
        class="post-card-pinned inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold text-white"
        th:if="${post.spec.pinned == true}"
      >
        <span class="icon-[material-symbols--pinboard] text-sm leading-none"
        ></span>
        <span class="leading-none">置顶</span>
      </span>
    </span>
    <img
      th:src="|${post.spec.cover}${suffix}|"
      th:alt="${post.spec.title}"
      th:attr="loading=${postStat.index == 0 ? 'eager' : 'lazy'},fetchpriority=${postStat.index == 0 ? 'high' : 'auto'}"
      decoding="async"
      class="post-card-cover-img h-full w-full object-cover"
    />
  </a>

  <!-- 无封面占位封面：仅桌面端网格（非瀑布流）显示，保证与有封面卡片等高协调。
       其余场景（移动端 / 列表 / 瀑布流）由 CSS 隐藏，改用主题色按钮 -->
  <a
    th:if="${coverEmpty}"
    th:href="@{${post.status.permalink}}"
    th:aria-label="${post.spec.title}"
    class="post-card-cover post-card-cover-placeholder group relative mx-4 -mb-2 mt-4 w-[calc(100%-2rem)] max-h-[20vh] overflow-hidden rounded-xl active:scale-95 aspect-[16/9] md:aspect-auto md:absolute md:bottom-3 md:right-3 md:top-3 md:mx-0 md:mb-0 md:mt-0 md:max-h-none md:w-(--post-card-cover-width)"
  >
    <div
      class="pointer-events-none absolute inset-0 z-10 flex h-full w-full items-center justify-center transition group-hover:bg-black/10 group-active:bg-black/20"
    >
      <span
        class="icon-[material-symbols--article-outline-rounded] scale-90 text-4xl text-white/80 transition group-hover:scale-100"
      ></span>
    </div>
  </a>

  <!-- 无封面主题色块按钮：列表模式与瀑布流下显示（Firefly 原版做法）。
       桌面网格非瀑布流下由 CSS 隐藏（改用占位封面） -->
  <a
    th:if="${coverEmpty}"
    th:href="@{${post.status.permalink}}"
    th:aria-label="${post.spec.title}"
    class="post-card-enter-btn btn-regular absolute bottom-3 right-3 top-3 flex w-[3.25rem] rounded-xl bg-(--enter-btn-bg) hover:bg-(--enter-btn-bg-hover) active:scale-95 active:bg-(--enter-btn-bg-active)"
  >
    <span
      class="icon-[material-symbols--chevron-right-rounded] mx-auto text-4xl text-(--primary) transition"
    ></span>
  </a>
</article>
<div
  class="post-card-divider mx-6 border-t-[1px] border-dashed border-black/10 transition last:border-t-0 dark:border-white/10 md:hidden"
>
</div>
