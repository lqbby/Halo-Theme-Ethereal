---
import Pagination from "./control/Pagination.astro";
import FeaturedCards from "./FeaturedCards.astro";
import SeriesStrip from "./SeriesStrip.astro";
import PostCard from "./PostCard.astro";
import {
  postListContainerClass,
  postListContainerStyle,
  postListContainerThWith,
  postListDataAttrs,
} from "../utils/post-list-config";

interface Props {
  pagination?: string;
  /** 是否在列表上方渲染「两卡行」（随机一篇文章 + 热门/最近文章）。仅首页传 true。 */
  featured?: boolean;
}

const { pagination = "posts", featured = false } = Astro.props;
---

<!-- 首页「系列」卡片条（1.5.32 新增，1.5.33 提到两卡行之上）：显示系列的全部文章，
     一排四个、可点箭头右移，并带系列切换按钮。自带完整门控（插件版本 / 后台开关 /
     首页第一页 / 空态），与下方精选卡互不影响：精选卡关掉时本组件仍按自己的
     seriesEnable 决定显隐。 -->{
  featured && <SeriesStrip />
}

{
  featured && (
    <div
      class="contents"
      th:if="${(theme.config?.layout?.postList?.featuredEnable == null or theme.config?.layout?.postList?.featuredEnable) and posts.page == 1}"
    >
      <FeaturedCards />
    </div>
  )
}

<div
  id="post-list-container"
  th:with={postListContainerThWith()}
  th:classappend={postListContainerClass()}
  th:attr={postListDataAttrs()}
  th:style={postListContainerStyle()}
  class="mb-4 transition flex flex-col gap-4 rounded-(--radius-large) bg-(--card-bg) py-1 md:gap-4 md:bg-transparent md:py-0"
>
  <div class="contents" th:each="post, postStat : ${posts.items}">
    <div
      class="post-card-item onload-animation"
      th:style="|animation-delay: min(calc(var(--content-delay) + ${postStat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
    >
      <PostCard />
    </div>
  </div>
</div>
<Pagination context={pagination} class="mb-4 onload-animation" />

<!-- 访客布局覆盖：同步脚本，须在瀑布流脚本之前执行（先换类再排瀑布流），
     Swup 换页由 SwupScriptsPlugin 按序重执行，见 visitor-post-layout.js 头注释。
     is:inline 必须显式声明：仅 src 无其他属性的 script 会被 Astro 当模块打包而丢弃 -->
<script
  is:inline
  src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/visitor-post-layout.js?v=${ASSET_VERSION}`}
></script>
<!-- 瀑布流（Masonry）布局脚本：仅 grid + masonry 时启用，见 post-list-layout.js -->
<script
  src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/post-list-layout.js?v=${ASSET_VERSION}`}
  defer></script>
<!-- 卡片点赞：经典脚本，点击卡片点赞胶囊调 Halo upvote API；与详情页 post-like.js
     共用 localStorage key 状态互通；Swup 换页由 SwupScriptsPlugin 按序重执行 -->
<script
  src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/post-card-like.js?v=${ASSET_VERSION}`}
  defer></script>

<style is:global>
  /* ===== 卡片底部标签：firefly 同款药丸 chip（# 前缀 + 主色 8% 底）===== */
  #post-list-container .post-card-tag {
    background: color-mix(in srgb, var(--btn-content) 8%, transparent);
    color: var(--btn-content);
  }
  /* 仅可点击的 <a> 标签响应 hover；+N 合并项是 <span>，保持静态（同 firefly tag-item-static） */
  #post-list-container a.post-card-tag:hover {
    background: color-mix(in srgb, var(--btn-content) 18%, transparent);
    color: var(--primary);
  }

  /* ===== 卡片底部统计（浏览/评论/点赞）：纯「图标 + 数字」，无胶囊底 =====
     原先统计与上方标签同为药丸，但底色更实（--btn-regular-bg 不透明 vs 标签 8% 半透明）
     ⇒ 底栏读起来像「第二行标签」，且比标签更抢眼。去掉底色 + 前景改中性灰
     （跟随 .post-card-stats 的 text-50，与日期同一档灰度）后：
     标签＝分类（带色 chip）、统计＝数值（素色），权重拉开、不再打架。 */
  #post-list-container .post-card-stat {
    background: transparent;
    color: inherit;
    transition: color 0.15s ease;
  }
  /* 可点击项（评论链接 / 点赞按钮）：hover 前景变主色 */
  #post-list-container a.post-card-stat:hover,
  #post-list-container .post-card-stat-like:hover {
    color: var(--primary);
  }
  /* 点赞为可点击按钮：显示手型指针（其余胶囊是展示/链接） */
  #post-list-container .post-card-stat-like {
    cursor: pointer;
  }
  /* 点赞 hover 实心：描边→实心图标切换（实心用主色点亮） */
  #post-list-container .post-card-stat-like .stat-heart-outline,
  #post-list-container .post-card-stat-like .stat-heart-filled {
    transition: opacity 0.15s ease;
  }
  #post-list-container .post-card-stat-like .stat-heart-filled {
    color: var(--primary);
  }
  /* 已点赞：数字一并转主色，与实心心形呼应 */
  #post-list-container .post-card-stat-like.liked {
    color: var(--primary);
  }
  #post-list-container .post-card-stat-like:hover .stat-heart-outline,
  #post-list-container .post-card-stat-like.liked .stat-heart-outline {
    opacity: 0;
  }
  #post-list-container .post-card-stat-like:hover .stat-heart-filled,
  #post-list-container .post-card-stat-like.liked .stat-heart-filled {
    opacity: 1;
  }

  /* ===== 合并底栏（1.5.58 定契约：**恒单行** + 一条容器查询分档）=====
     标签行与统计行并成一条带 border-t 的底栏：左标签、右统计。
     ⚠️ 描边走 --line-divider 而不是写死 black/10 + dark:white/10：
        主题在浅底卡片外壳下需要更淡的分隔线，token 会跟着卡片外壳一起变。

     🔴🔴 **为什么必须分档：底栏可用宽最窄只有 288px**
         · 网格是 `repeat(auto-fill, minmax(320px, 1fr))` ⇒ 卡片内容宽下限 = 320 − 32(内距) = **288px**；
           这也正是 320px 视口手机的值（移动端主壳 px-0、网格 padding 0，卡片满宽）。
         · CDP 实测锚点：四项统计 `36+29+63+29 + 3×12 = 193px`、两个标签 `75+6+75 = 156px`；
           「字数」一项就占 63px；1440 视口双列卡内容宽 311px。
         · 旧版（1.5.57）靠 `flex-wrap: wrap` 兜底 ⇒ 357px > 311px 溢出 46px ⇒ 统计整组掉到
           第二行（就是「标签和数据不在同一行」）。
         ⇒ 1.5.58 改为**两套参数 + 恒单行**（下面同名块 + 文件后部的 @container）：
             紧档（内容 <400px）：chip 11px·px-1.5、标签组 4px、统计组 8px、项内 4px、最多 **2** 个标签
                                  ⇒ 常规 240px / 最宽标签对 ≈264px（288 预算下余 24px）
             宽松档（内容 ≥400px）：chip 12px·px-2.5、标签组 6px、统计组 12px、项内 6px、最多 **3** 个标签
                                  ⇒ 常规 363px / 最宽三标签 ≈378px（400 预算下余 22px）
         ⇒ 效果：桌面列表（592–800px）宽松+3；桌面网格（288–455px）与移动端（288–398px）紧+2。

     🔴 **判据挂 `.post-card-content` 而不是卡片**：列表模式内容区是 `calc(100% − 封面 − 12px)`，
        与卡宽不成比例 ⇒ 只有内容区宽才等于底栏真正可用的宽度。
        `container-type: inline-size` 会带来 layout containment（成为 abs 定位包含块 + 新层叠上下文）；
        已确认 `.post-card-content` 内所有 abs 元素（标题装饰条 / hover 箭头 / 点赞实心心）
        都以组件内部的 relative 元素为包含块 ⇒ 无副作用。

     🔴 **标签数只能由 CSS 分档** ⇒ 标记里服务端渲染 3 个、窄档收起第 3 个（`--extra`）；`+N` 同理
        渲染两份（按 2 算 / 按 3 算）由 CSS 切换。**不要改成 overflow 裁切**：
        那会让 +N 计数与实际隐藏数不符。 */
  #post-list-container .post-card-content {
    container-type: inline-size;
    container-name: post-card;
  }

  /* ---- 紧档（默认：所有窄场景）---- */
  #post-list-container .post-card-bottom {
    /* 恒单行：分档已保证放得下，不再用 flex-wrap 兜底（那正是「标签和数据不同行」的成因） */
    flex-wrap: nowrap !important;
    border-top-color: var(--line-divider);
    gap: 0.5rem; /* 标签组 ↔ 统计组 */
  }
  /* 无标签时只剩统计组：justify-between 对单个子项会把它留在最左，需显式推到右侧
     （否则底栏右半边空着、视觉上像「统计掉到了左边」） */
  #post-list-container .post-card-bottom.no-tags {
    justify-content: flex-end !important;
  }
  /* 左侧标签组：单行。min-width:0 是 flex 子项能真正收缩的前提
     （flex 项默认 min-width:auto，会被内容撑开、把右侧统计挤出卡片） */
  #post-list-container .post-card-bottom-tags {
    flex-wrap: nowrap !important;
    gap: 0.25rem;
  }
  /* 第 3 个标签只在宽松档出现（由文件后部的 @container 放回来） */
  #post-list-container .post-card-tag--extra {
    display: none !important;
  }
  /* +N 两份：紧档用 --compact（按 2 算），--wide 只在宽松档出现 */
  #post-list-container .post-card-tag-more--wide {
    display: none !important;
  }
  /* chip 紧档收一档：px-2.5 → px-1.5、text-xs(12px) → 11px */
  #post-list-container .post-card-tag {
    padding-inline: 0.375rem !important;
    font-size: 0.6875rem !important;
  }
  /* 🔴 极端长标签的兜底（不让它被标签组右缘硬切）：允许 chip 收缩 + 文本省略成 `…`。
     ⚠️ `+N` 合并项**不参与收缩**（Tailwind 的 shrink-0 保留），否则数字会被挤没。
     ⚠️ 全名仍可达：<a> 带 th:title + th:aria-label（见 PostCard.astro）。 */
  #post-list-container
    .post-card-bottom-tags
    .post-card-tag:not(.post-card-tag-more) {
    flex-shrink: 1;
    min-width: 0;
  }
  #post-list-container .post-card-bottom-tags .post-card-tag > span {
    /* min-width:0 缺一不可：flex 子项默认 min-width:auto ⇒ 不写它即使有 overflow:hidden
       也只会停在 min-content 宽、省略号永远不出现（真机踩过） */
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* 右侧统计组：永不折行，并**永远贴右**（有/无标签、宽/窄档都贴右）。
     ⚠️ 用 `margin-left:auto` 而不是只靠容器的 justify-content: space-between：
        no-tags 时只剩一个子项，space-between 会把它留在**最左**；auto 才能保证恒贴右。 */
  #post-list-container .post-card-stats {
    flex-wrap: nowrap !important;
    white-space: nowrap;
    margin-left: auto;
    gap: 0.5rem;
  }
  #post-list-container .post-card-stat {
    gap: 0.25rem;
  }

  /* ---- 宽松档：卡片内容 ≥400px（桌面列表模式是唯一常态命中者）----
     ⚠️ 这个块只做「档位切换」，不许再写第三套数值 —— 两档就是全部。 */
  @container post-card (min-width: 400px) {
    #post-list-container .post-card-bottom-tags {
      gap: 0.375rem;
    }
    #post-list-container .post-card-tag--extra {
      display: inline-flex !important;
    }
    #post-list-container .post-card-tag-more--compact {
      display: none !important;
    }
    #post-list-container .post-card-tag-more--wide {
      display: inline-flex !important;
    }
    #post-list-container .post-card-tag {
      padding-inline: 0.625rem !important;
      font-size: 0.75rem !important;
    }
    #post-list-container .post-card-stats {
      gap: 0.75rem;
    }
    #post-list-container .post-card-stat {
      gap: 0.375rem;
    }
  }

  /* ===== 系列角标 / 置顶角标（1.5.57）=====
     两种变体（cover / inline）**同时只显示一个**，由 .has-cover 与布局模式切换：
       · 有封面 + 网格 / 移动端 → cover（压在封面左上角的深色胶囊）＋ 置顶压封面右上
       · 有封面 + 列表模式桌面端 → inline（那时封面是条窄竖条，整层封面角标都关掉，
         系列改回 eyebrow 行、置顶改回 PostMeta 内联胶囊）
       · 无封面 → 只渲染 inline（封面角标所在的那个 cover <a> 根本不存在） */
  #post-list-container .post-card-series {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.0625rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }
  /* 名与期号之间用中圆点分隔；__issue 只在「本文确实属于该系列」时才渲染，
     所以不会出现悬空的圆点 */
  #post-list-container .post-card-series__issue::before {
    content: "·";
    margin-right: 0.25rem;
    opacity: 0.6;
  }
  /* cover 变体：半透明底 + 毛玻璃，压住再花的封面也读得清（与首页系列条的期号胶囊同款）。
     ⚠️ 这个 backdrop-filter 只作用在一个小胶囊上（不是卡片本身）⇒ 不会踩
        「`.card-base` 无 position、加合成层会挪走纹理包含块」那个坑，开销也可忽略。 */
  #post-list-container .post-card-series--cover {
    color: #fff;
    background: color-mix(in srgb, #000 42%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  /* inline 变体：混在 eyebrow 行里的浅色 chip，与标签 chip 同色系但用主色区分「这是系列」 */
  #post-list-container .post-card-series--inline {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }
  /* 有封面时角标默认在封面上 ⇒ 隐藏 eyebrow 行里的 inline 副本（两处都渲染，靠这里二选一） */
  #post-list-container .post-card.has-cover .post-card-series--inline {
    display: none;
  }
  /* 列表模式桌面端：封面是一条窄竖条，角标挂不下 ⇒ 把**整层**封面角标关掉（系列 + 置顶一起，
     这样两者不会一半在封面一半在 eyebrow 行），再分别改回 eyebrow 行 / PostMeta。
     ⚠️ 只关 `.post-card-series--cover` 不够 —— 置顶那颗在同一个 `.post-card-badges` 层里、
     是另一个元素，会只剩它孤零零挂在窄条上。 */
  @media (min-width: 768px) {
    #post-list-container.post-list-mode .post-card.has-cover .post-card-badges {
      display: none;
    }
    #post-list-container.post-list-mode
      .post-card.has-cover
      .post-card-series--inline {
      display: inline-flex;
    }
  }
  /* 置顶角标（封面右上角）：主色实心 + 白字，与系列角标的半透明黑底拉开层级。
     ⚠️ `margin-left: auto` 而不是靠容器的 justify-content: space-between ——
        系列角标在「本文不属于任何系列」时不渲染，那时容器只剩置顶一个子项，
        space-between 会把它留在**最左**。用 auto 外边距才能保证它永远贴右。 */
  #post-list-container .post-card-pinned {
    margin-left: auto;
    background: var(--primary);
  }
  /* 有封面时置顶改由封面角标承担 ⇒ 隐藏 PostMeta 里的内联胶囊（同上，两处渲染二选一）。
     ⚠️ 列表模式桌面端要把 Meta 里那颗还回来 —— 那时封面角标整层都被隐藏了，
        两处一起藏会导致「列表模式下看不到任何置顶标识」。 */
  #post-list-container .post-card.has-cover .post-meta-pinned {
    display: none !important;
  }
  @media (min-width: 768px) {
    #post-list-container.post-list-mode .post-card.has-cover .post-meta-pinned {
      display: inline-flex !important;
    }
  }

  /* ===== 置顶卡片高亮：主色描边 + 轻微光晕（列表/网格/瀑布流通用）=====
     ⚠️ 置顶高亮必须独立于访客样式切换：访客切布局（列表/网格/瀑布流）只改容器类
     与卡片定位，不得改变置顶卡片的描边/光晕。本规则写在 #post-list-container 的
     ID 选择器下（特异性 1-2-0），高于任何访客可切换的类选择器（如
     body.card-hover-lift-enabled .card-hover-lift:hover 的 0-3-1），因此在所有
     布局模式下都稳定胜出；hover 时的 translateY 位移照常保留（那是交互，不是高亮）。
     ⚠️ 用 outline 而非 border：瀑布流下卡片由 JS 绝对定位并显式写下 width/height
     行内样式，若用 border 会改变盒模型尺寸、与 JS 计算的高度互相干扰；
     outline 不占空间，随卡片一起移动，无需 JS 额外处理。
     ⚠️ 此处是「卡片外壳开关关闭」时的基线（细描边 + 淡光晕）。开关开启后由
     components.css 的 `:root.mods-card-shell #post-list-container .post-card.is-pinned`
     升级成「2px 外浮粗环 + 主色投影」——两级强度刻意拉开，保证置顶一眼可辨。 */
  #post-list-container .post-card.is-pinned {
    outline: 1px solid color-mix(in srgb, var(--primary) 40%, transparent);
    outline-offset: -1px;
    box-shadow: 0 2px 18px color-mix(in srgb, var(--primary) 14%, transparent);
  }

  /* ===== 网格（grid）布局容器 ===== */
  #post-list-container.post-grid-mode {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(var(--post-card-min-width, 320px), 1fr)
    );
    gap: 1rem;
    border-radius: 0;
    background: transparent;
    padding: 0;
  }

  /* ===== 网格模式卡片：封面在顶部、内容在下 ===== */
  #post-list-container.post-grid-mode .post-card {
    flex-direction: column-reverse !important;
    justify-content: flex-end !important;
    height: 100%;
  }

  /* 封面：移到卡片顶部。默认内缩（grid-cover-inset）：按卡片内边距内缩、四角圆角。
     封面固定为 2:1 统一高度，不随等高网格拉伸；剩余高度由内容区吸收，
     摘要下方留白（见下方内容区规则）。开启「封面高度自适应」时由
     .grid-cover-fill 覆盖为 flex-grow 吸收 */
  #post-list-container.post-grid-mode .post-card-cover {
    position: relative !important;
    top: auto !important;
    right: auto !important;
    bottom: auto !important;
    left: auto !important;
    width: calc(100% - 2rem) !important;
    max-height: none !important;
    aspect-ratio: 2 / 1 !important;
    margin: 1rem 1rem 0 !important;
    border-radius: 0.75rem !important;
    flex-shrink: 0 !important;
  }

  /* 封面高度自适应（grid-cover-fill）：封面 flex-grow 吸收等高网格的剩余高度，
     同排卡片封面等高、摘要下方不留白；内容区回到自然高度不拉伸 */
  #post-list-container.post-grid-mode.grid-cover-fill .post-card-cover {
    flex-grow: 1 !important;
  }
  #post-list-container.post-grid-mode.grid-cover-fill .post-card-content {
    flex-grow: 0 !important;
  }

  /* 封面贴边（grid-cover-full）：撑满卡片顶部，仅上两角圆角 */
