---
/**
 * 首页瞬间栏：顶部横向滚动跑马灯 + 底部标签筛选。
 *
 * 结构：
 *  ┌──────────────────────────────────────────────┐
 *  │ [✨瞬间]  滚动内容……   滚动内容……   [更多›]  │  跑马灯行
 *  │  #标签·n  #标签·n  #标签·n  …                │  标签筛选行
 *  └──────────────────────────────────────────────┘
 *
 * 数据流：
 * - 跑马灯 SSR 渲染最近瞬间，content.raw 为富文本（可能含 HTML），
 *   由前端 JS 解析提取纯文本后回填（隐藏 span 传值，避免 HTML 转义外露）。
 * - 标签同样用隐藏 span 传入，JS 去重 + 计数后渲染为胶囊链接。
 * - 无缝滚动：JS 克隆一份内容，内容超出一屏时才启用动画；hover 暂停；两端渐隐。
 * - 开关：theme.config.layout.postList.showHomeMoments
 * - 数量：theme.config.layout.postList.homeMomentsCount
 */
---

<section
  id="home-moments"
  class="card-base onload-animation relative mb-4 overflow-hidden px-4 py-4"
  th:if="${theme.config?.layout?.postList?.showHomeMoments == null or theme.config?.layout?.postList?.showHomeMoments}"
  th:with="homeMomentsCount = ${theme.config?.layout?.postList?.homeMomentsCount ?: 10}"
>
  <!-- 整条可点击覆盖层：空白区域点击跳 /moments（z-1，内容在 z-10 之上） -->
  <a
    th:href="@{/moments}"
    class="home-moments-overlay"
    aria-label="查看我的瞬间"
  ></a>

  <!-- ===== 顶部：跑马灯行 ===== -->
  <div class="relative z-10 flex flex-nowrap items-center gap-3">
    <!-- "瞬间" 标签 -->
    <a
      th:href="@{/moments}"
      class="home-moments-badge group flex shrink-0 items-center gap-1.5 rounded-lg bg-(--btn-regular-bg) px-3 py-1.5 transition hover:bg-(--btn-regular-bg-hover) active:scale-95"
    >
      <span
        class="icon-[material-symbols--auto-awesome-outline-rounded] text-base text-(--primary)"
      ></span>
      <span
        class="text-sm font-bold text-(--btn-content)"
        th:text="#{page.moments.title}"
        >瞬间</span
      >
    </a>

    <!-- 滚动区：SSR 仅渲染空壳 + 加载态；
         瞬间数据改由前端异步拉取（标准 content API），
         失败仅显示空态，绝不崩页。 -->
    <div
      id="home-moments-marquee"
      class="home-moments-marquee relative min-w-0 flex-1 overflow-hidden rounded-lg bg-(--btn-regular-bg) py-1.5"
    >
      <div
        id="home-moments-track"
        class="home-moments-track flex w-max items-center"
      >
        <div class="home-moments-group flex items-center">
          <!-- 瞬时条目由前端 JS 渲染 -->
        </div>
      </div>

      <!-- 加载态 / 空状态（JS 拉取后替换） -->
      <div
        id="home-moments-status"
        class="px-3 text-sm text-30"
        th:text="#{page.moments.empty}"
        >暂无瞬间</div
      >
    </div>

    <!-- 更多 -->
    <a
      th:href="@{/moments}"
      class="btn-regular group flex h-8 shrink-0 items-center gap-0.5 rounded-lg px-3 text-sm font-bold active:scale-95"
    >
      <span th:text="#{common.more}">更多</span>
      <span
        class="icon-[material-symbols--chevron-right-rounded] text-base transition-transform group-hover:translate-x-0.5"
      ></span>
    </a>
  </div>

  <!-- ===== 底部：标签筛选 ===== -->
  <div
    id="home-moments-tags"
    class="relative z-10 mt-3 flex flex-wrap items-center gap-2"
  ></div>

  <!-- 将后台配置的瞬间条数量注入前端（SSR 阶段由 Thymeleaf 求值，安全无运行期风险） -->
  <script th:inline="javascript" type="application/json" id="home-moments-config">
    /*[[${homeMomentsCount}]]*/
  </script>
  <script is:inline>
    (function () {
      var cfg = document.getElementById("home-moments-config");
      if (cfg) {
        try {
          window.__homeMomentsCount = JSON.parse(cfg.textContent.trim());
        } catch (e) {
          window.__homeMomentsCount = 10;
        }
      }
    })();
  </script>
</section>

<style is:global>
  /* ===== 整条可点击覆盖层 ===== */
  .home-moments-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    text-decoration: none;
  }

  /* ===== 跑马灯 ===== */
  .home-moments-marquee {
    /* 两端渐隐遮罩：中间透明，两侧淡入卡片底色 */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 2rem,
      black calc(100% - 2rem),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 2rem,
      black calc(100% - 2rem),
      transparent
    );
  }

  /* 轨道：内容宽度自适应；滚动时长由 JS 按内容宽度动态注入。
     will-change 提前把轨道提升为独立合成层，动画用 GPU 合成，避免每帧重排 */
  .home-moments-track--animate {
    animation: home-moments-scroll var(--home-moments-duration, 40s) linear
      infinite;
    will-change: transform;
  }

  @keyframes home-moments-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* hover 暂停滚动 */
  .home-moments-marquee:hover .home-moments-track--animate {
    animation-play-state: paused;
  }

  /* 单条瞬间：保持自然宽度、不换行（跑马灯靠滚动展示完整内容，无需截断）。
     inline-block 是关键：默认 span 是 inline，white-space 不生效。
     !important 防止被任何更高优先级的样式覆盖 */
  .home-moment-text {
    display: inline-block !important;
    white-space: nowrap !important;
    vertical-align: middle !important;
    transition: color 0.2s ease;
  }
  .home-moment-link:hover .home-moment-text {
    color: var(--primary);
  }

  /* 标签胶囊 */
  #home-moments-tags .home-moment-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.75rem;
    padding: 0 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--btn-content);
    background: var(--btn-regular-bg);
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease;
  }
  #home-moments-tags .home-moment-tag:hover {
    background: var(--btn-regular-bg-hover);
    color: var(--primary);
  }
  #home-moments-tags .home-moment-tag:active {
    transform: scale(0.95);
  }
  #home-moments-tags .home-moment-tag .home-moment-tag-count {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--primary);
    opacity: 0.7;
  }

  /* 移动端性能降级：关闭跑马灯无限滚动动画（改为原生横向滑动），
     同时关闭两端渐隐遮罩——无限 transform 动画与 mask 在低端机持续
     触发合成层重绘，是移动端卡顿主因 */
  @media (max-width: 767px) {
    .home-moments-track--animate {
      animation: none !important;
      /* 释放合成层：桌面端动画时提升的 GPU 合成层，移动端不再需要，
         避免占用安卓低端机紧张的显存 */
      will-change: auto !important;
    }
    .home-moments-marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .home-moments-marquee::-webkit-scrollbar {
      display: none;
    }
  }

  /* 减少动态偏好：关闭滚动 */
  @media (prefers-reduced-motion: reduce) {
    .home-moments-track--animate {
      animation: none;
    }
  }
</style>

<script is:inline>
  (function () {
    function stripHtml(html) {
      var div = document.createElement("div");
      div.innerHTML = html;
      return (div.textContent || div.innerText || "").trim();
    }

    var MOMENTS_API =
      "/apis/api.content.halo.run/v1alpha1/moments?size=" +
      (window.__homeMomentsCount || 10) +
      "&sort=spec.releaseTime,desc";

    function renderInto(group, statusEl, moments) {
      var valid = (moments || []).filter(function (m) {
        return (
          m &&
          m.spec &&
          m.spec.content != null &&
          m.spec.content.raw != null &&
          m.spec.content.raw.trim() !== ""
        );
      });
      if (!valid.length) {
        if (statusEl) statusEl.style.display = "";
        return;
      }
      if (statusEl) statusEl.style.display = "none";

      var html = "";
      valid.forEach(function (m) {
        var name = m.metadata ? m.metadata.name : "";
        var owner = m.owner && m.owner.displayName ? m.owner.displayName : "";
        var raw = m.spec.content.raw;
        // 标签：隐藏 span 供下方 JS 提取（与旧版 SSR 结构一致）
        var tags = (m.spec.tags || [])
          .map(function (t) {
            return '<span class="home-moment-tag-data" style="display:none">' +
              t +
              "</span>";
          })
          .join("");
        var ownerHtml = owner
          ? '<span class="home-moment-owner text-sm font-bold text-(--primary)">' +
            owner +
            '</span><span class="text-sm text-(--primary)">：</span>'
          : "";
        html +=
          '<a href="/moments/' +
          encodeURIComponent(name) +
          '" class="home-moment-link group flex items-center whitespace-nowrap">' +
          ownerHtml +
          '<span class="home-moment-text text-sm text-50">' +
          raw.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;") +
          "</span>" +
          '<span class="home-moment-dot mx-3 inline-block h-1 w-1 shrink-0 rounded-full bg-(--primary)/40" aria-hidden="true"></span>' +
          tags +
          "</a>";
      });
      group.innerHTML = html;
    }

    function initHomeMoments() {
      var marquee = document.getElementById("home-moments-marquee");
      var track = document.getElementById("home-moments-track");
      var tagsBox = document.getElementById("home-moments-tags");
      var statusEl = document.getElementById("home-moments-status");
      if (!marquee || !track) return;

      var group = track.querySelector(".home-moments-group");
      if (!group) return;

      // ===== 1. 富文本 → 纯文本回填，过滤空文本条目 =====
      var textEls = track.querySelectorAll(".home-moment-text");
      textEls.forEach(function (el) {
        var raw = el.textContent || "";
        var text = stripHtml(raw);
        el.textContent = text;
        if (!text) {
          var link = el.closest(".home-moment-link");
          if (link) link.style.display = "none";
        }
      });

      // ===== 2. 无缝滚动：克隆一份内容，超出一屏时才启用动画 =====
      // 延迟到字体加载 + 布局稳定后再测量宽度：否则字体未就绪时 scrollWidth
      // 偏小，容易误判为"不超宽"而禁用滚动（全屏模式下首屏 banner 占满、
      // 字体加载更晚，此问题更明显）。
      if (track.getAttribute("data-cloned") !== "1") {
        track.setAttribute("data-cloned", "1");
        var setupMarquee = function () {
          var groupWidth = group.scrollWidth;
          var marqueeWidth = marquee.clientWidth;
          // 移动端不启用无缝滚动动画（CSS 已降级为原生横向滑动），
          // 也不克隆内容，避免 DOM 翻倍加重低端机负担
          var isMobile = window.matchMedia("(max-width: 767px)").matches;

          if (groupWidth > marqueeWidth && !isMobile) {
            var clone = group.cloneNode(true);
            clone.setAttribute("aria-hidden", "true");
            track.appendChild(clone);
            track.classList.add("home-moments-track--animate");
            // 速度 ~48px/s，最小 20s，避免内容少时转太快
            var duration = Math.max(20, Math.round(groupWidth / 48));
            track.style.setProperty("--home-moments-duration", duration + "s");
          }
        };
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () {
            requestAnimationFrame(setupMarquee);
          });
        } else {
          setTimeout(setupMarquee, 200);
        }
      }

      // ===== 3. 标签提取去重 + 计数，渲染胶囊 =====
      if (tagsBox && tagsBox.getAttribute("data-rendered") !== "1") {
        tagsBox.setAttribute("data-rendered", "1");
        var tagMap = new Map();
        track
          .querySelectorAll(".home-moment-link .home-moment-tag-data")
          .forEach(function (el) {
            var t = (el.textContent || "").trim();
            if (t) tagMap.set(t, (tagMap.get(t) || 0) + 1);
          });

        if (tagMap.size === 0) {
          tagsBox.style.display = "none";
          return;
        }

        var html = "";
        var i = 0;
        var MAX_TAGS = 10;
        tagMap.forEach(function (count, tag) {
          if (i >= MAX_TAGS) return;
          i++;
          html +=
            '<a href="/moments?tag=' +
            encodeURIComponent(tag) +
            '" class="home-moment-tag">#' +
            tag +
            '<span class="home-moment-tag-count">' +
            count +
            "</span></a>";
        });
        tagsBox.innerHTML = html;
      }
    }

    function loadMoments() {
      var track = document.getElementById("home-moments-track");
      var group = track && track.querySelector(".home-moments-group");
      var statusEl = document.getElementById("home-moments-status");
      if (!group) return;
      fetch(MOMENTS_API, { headers: { Accept: "application/json" } })
        .then(function (r) {
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.json();
        })
        .then(function (data) {
          renderInto(group, statusEl, (data && data.items) || []);
          initHomeMoments();
        })
        .catch(function () {
          // 拉取失败：保持空态，不崩页
          if (statusEl) statusEl.style.display = "";
        });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", loadMoments);
    } else {
      loadMoments();
    }
    // 瞬间条位于 #swup-container 之外，Swup 换页不替换该 DOM、也不重执行本脚本，
    // 因此全站仅首屏初始化一次；data-cloned/data-rendered 标记保证幂等，
    // 避免重复克隆与重复渲染。
  })();
</script>
