---
/**
 * 首页瞬间栏：顶部横向滚动跑马灯 + 底部标签筛选。
 *
 * 结构：
 *  ┌──────────────────────────────────────────────┐
 *  │ [✨瞬间]  滚动内容……   滚动内容……   [更多›]  │  跑马灯行
 *  │  #标签·n  #标签·n  #标签·n  …                │  标签筛选行
 *  └──────────────────────────────────────────────┘
 *
 * 数据流：
 * - 跑马灯 SSR 渲染最近瞬间，content.raw 为富文本（可能含 HTML），
 *   由前端 JS 解析提取纯文本后回填（隐藏 span 传值，避免 HTML 转义外露）。
 * - 标签同样用隐藏 span 传入，JS 去重 + 计数后渲染为胶囊链接。
 * - 无缝滚动：JS 克隆一份内容，内容超出一屏时才启用动画；hover 暂停；两端渐隐。
 * - 开关：theme.config.layout.postList.showHomeMoments
 * - 数量：theme.config.layout.postList.homeMomentsCount
 */
---

<section
  id="home-moments"
  class="card-base onload-animation relative mb-4 overflow-hidden px-4 py-4"
  th:if="${theme.config?.layout?.postList?.showHomeMoments == null or theme.config?.layout?.postList?.showHomeMoments}"
  th:with="homeMoments = ${momentFinder?.list({size: theme.config?.layout?.postList?.homeMomentsCount ?: 10})}"
>
  <!-- 装饰性覆盖层：父级 home-moments-wrap 为 pointer-events-none，本层继承后
       不拦截内层链接点击；纯装饰，不作为可聚焦链接（避免 target-size /
       label-content-name-mismatch 审计误报）。空白区跳转由顶部「瞬间」徽标与
       「更多」链接承担。 -->
  <div class="home-moments-overlay"></div>

  <!-- ===== 顶部：跑马灯行 ===== -->
  <div class="relative z-10 flex flex-nowrap items-center gap-3">
    <!-- "瞬间" 标签 -->
    <a
      th:href="@{/moments}"
      class="home-moments-badge group flex shrink-0 items-center gap-1.5 rounded-lg bg-(--btn-regular-bg) px-3 py-1.5 transition hover:bg-(--btn-regular-bg-hover) active:scale-95"
    >
      <span
        class="icon-[material-symbols--auto-awesome-outline-rounded] text-base text-(--primary)"
      ></span>
      <span
        class="text-sm font-bold text-(--btn-content)"
        th:text="#{page.moments.title}">瞬间</span
      >
    </a>

    <!-- 滚动区：SSR 渲染最近瞬间条目（momentFinder 由瞬间插件注入渲染上下文，
         ?. 空安全——插件未装时短路为 null，仅显示空态，绝不崩页）。
         前端 JS 仅负责富文本→纯文本回填、无缝滚动动画、标签胶囊提取，
         不再承担数据拉取（匿名前端 API 需登录，拿不到数据）。 -->
    <div
      id="home-moments-marquee"
      class="home-moments-marquee relative min-w-0 flex-1 overflow-hidden rounded-lg bg-(--btn-regular-bg) py-1.5"
    >
      <div
        id="home-moments-track"
        class="home-moments-track flex w-max items-center"
        th:if="${homeMoments != null and not #lists.isEmpty(homeMoments.items)}"
      >
        <div class="home-moments-group flex items-center">
          <a
            th:each="moment : ${homeMoments.items}"
            th:if="${moment.spec.content != null and not #strings.isEmpty(moment.spec.content.raw)}"
            th:href="@{/moments/{name}(name=${moment.metadata.name})}"
            class="home-moment-link group flex items-center whitespace-nowrap"
          >
            <span
              class="home-moment-owner text-sm font-bold text-(--primary)"
              th:if="${moment.owner != null and not #strings.isEmpty(moment.owner.displayName)}"
              th:text="${moment.owner.displayName}">作者</span
            >
            <span
              class="text-sm text-(--primary)"
              th:if="${moment.owner != null and not #strings.isEmpty(moment.owner.displayName)}"
              >：</span
            >
            <span
              class="home-moment-text text-sm text-50"
              th:text="${moment.spec.content.raw}">内容</span
            >
            <span
              class="home-moment-dot mx-3 inline-block h-1 w-1 shrink-0 rounded-full bg-(--primary)/40"
              aria-hidden="true"></span>
            <span
              class="home-moment-tag-data"
              style="display:none"
              th:each="tagName : ${moment.spec.tags}"
              th:text="${tagName}"></span>
          </a>
        </div>
      </div>

      <!-- 空状态 -->
      <div
        th:if="${homeMoments == null or #lists.isEmpty(homeMoments.items)}"
        class="px-3 text-sm text-30"
        th:text="#{page.moments.empty}"
      >
        暂无瞬间
      </div>
    </div>

    <!-- 更多 -->
    <a
      th:href="@{/moments}"
      class="btn-regular group flex h-8 shrink-0 items-center gap-0.5 rounded-lg px-3 text-sm font-bold active:scale-95"
    >
      <span th:text="#{common.more}">更多</span>
      <span
        class="icon-[material-symbols--chevron-right-rounded] text-base transition-transform group-hover:translate-x-0.5"
      ></span>
    </a>
  </div>

  <!-- ===== 底部：标签筛选 ===== -->
  <div
    id="home-moments-tags"
    class="relative z-10 mt-3 flex flex-wrap items-center gap-2"
  >
  </div>
</section>

<style is:global>
  /* ===== 整条可点击覆盖层 ===== */
  .home-moments-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    text-decoration: none;
    /* 父级 home-moments-wrap 为 pointer-events-none，此处显式继承并固化，
       确保覆盖层永不拦截内层链接点击、也不作为可聚焦目标参与 a11y 审计 */
    pointer-events: none;
  }

  /* ===== 跑马灯 ===== */
  .home-moments-marquee {
    /* 两端渐隐遮罩：中间透明，两侧淡入卡片底色 */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 2rem,
      black calc(100% - 2rem),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 2rem,
      black calc(100% - 2rem),
      transparent
    );
  }

  /* 轨道：内容宽度自适应；滚动时长由 JS 按内容宽度动态注入。
     will-change 提前把轨道提升为独立合成层，动画用 GPU 合成，避免每帧重排 */
  .home-moments-track--animate {
    animation: home-moments-scroll var(--home-moments-duration, 40s) linear
      infinite;
    will-change: transform;
  }

  @keyframes home-moments-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* hover 暂停滚动 */
  .home-moments-marquee:hover .home-moments-track--animate {
    animation-play-state: paused;
  }

  /* 单条瞬间：保持自然宽度、不换行（跑马灯靠滚动展示完整内容，无需截断）。
     inline-block 是关键：默认 span 是 inline，white-space 不生效。
     !important 防止被任何更高优先级的样式覆盖 */
  .home-moment-text {
    display: inline-block !important;
    white-space: nowrap !important;
    vertical-align: middle !important;
    transition: color 0.2s ease;
  }
  .home-moment-link:hover .home-moment-text {
    color: var(--primary);
  }

  /* 标签胶囊 */
  #home-moments-tags .home-moment-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.75rem;
    padding: 0 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--btn-content);
    background: var(--btn-regular-bg);
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease;
  }
  #home-moments-tags .home-moment-tag:hover {
    background: var(--btn-regular-bg-hover);
    color: var(--primary);
  }
  #home-moments-tags .home-moment-tag:active {
    transform: scale(0.95);
  }
  #home-moments-tags .home-moment-tag .home-moment-tag-count {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--primary);
    opacity: 0.7;
  }

  /* 减少动态偏好：关闭滚动 */
  @media (prefers-reduced-motion: reduce) {
    .home-moments-track--animate {
      animation: none;
    }
  }
</style>

<script is:inline>
  (function () {
    function stripHtml(html) {
      var div = document.createElement("div");
      div.innerHTML = html;
      return (div.textContent || div.innerText || "").trim();
    }

    function initHomeMoments() {
      var marquee = document.getElementById("home-moments-marquee");
      var track = document.getElementById("home-moments-track");
      var tagsBox = document.getElementById("home-moments-tags");
      if (!marquee || !track) return;

      // ===== 1. 富文本 → 纯文本回填，过滤空文本条目 =====
      var textEls = track.querySelectorAll(".home-moment-text");
      textEls.forEach(function (el) {
        var raw = el.textContent || "";
        var text = stripHtml(raw);
        el.textContent = text;
        if (!text) {
          var link = el.closest(".home-moment-link");
          if (link) link.style.display = "none";
        }
      });

      var group = track.querySelector(".home-moments-group");
      if (!group) return;

      // ===== 2. 无缝滚动：克隆一份内容，超出一屏时才启用动画 =====
      // 延迟到字体加载 + 布局稳定后再测量宽度：否则字体未就绪时 scrollWidth
      // 偏小，容易误判为"不超宽"而禁用滚动（全屏模式下首屏 banner 占满、
      // 字体加载更晚，此问题更明显）。
      if (track.getAttribute("data-cloned") !== "1") {
        track.setAttribute("data-cloned", "1");
        var setupMarquee = function () {
          var groupWidth = group.scrollWidth;
          var marqueeWidth = marquee.clientWidth;

          if (groupWidth > marqueeWidth) {
            var clone = group.cloneNode(true);
            clone.setAttribute("aria-hidden", "true");
            // 克隆块内的瞬间链接是装饰性重复（aria-hidden 已对读屏隐藏），
            // 但 <a> 默认可聚焦，会被 aria-hidden-focus 审计判为「可聚焦元素藏在
            // aria-hidden 容器内」→ 显式 tabindex=-1 移出 tab 序。
            clone.querySelectorAll("a").forEach(function (a) {
              a.setAttribute("tabindex", "-1");
            });
            track.appendChild(clone);
            track.classList.add("home-moments-track--animate");
            // 速度 ~48px/s，最小 20s，避免内容少时转太快
            var duration = Math.max(20, Math.round(groupWidth / 48));
            track.style.setProperty("--home-moments-duration", duration + "s");
          }
        };
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () {
            requestAnimationFrame(setupMarquee);
          });
        } else {
          setTimeout(setupMarquee, 200);
        }
      }

      // ===== 3. 标签提取去重 + 计数，渲染胶囊 =====
      if (tagsBox && tagsBox.getAttribute("data-rendered") !== "1") {
        tagsBox.setAttribute("data-rendered", "1");
        var tagMap = new Map();
        // 计数源用原始 group（克隆块挂在 track 下，若从 track 数会把每个标签
        // 算 2 次）；group 是克隆前的原始节点引用，此处只统计原始标签。
        group
          .querySelectorAll(".home-moment-link .home-moment-tag-data")
          .forEach(function (el) {
            var t = (el.textContent || "").trim();
            if (t) tagMap.set(t, (tagMap.get(t) || 0) + 1);
          });

        if (tagMap.size === 0) {
          tagsBox.style.display = "none";
          return;
        }

        var i = 0;
        var MAX_TAGS = 10;
        tagMap.forEach(function (count, tag) {
          if (i >= MAX_TAGS) return;
          i++;
          var a = document.createElement("a");
          a.href = "/moments?tag=" + encodeURIComponent(tag);
          a.className = "home-moment-tag";
          a.textContent = "#" + tag;
          var c = document.createElement("span");
          c.className = "home-moment-tag-count";
          c.textContent = String(count);
          a.appendChild(c);
          tagsBox.appendChild(a);
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHomeMoments);
    } else {
      initHomeMoments();
    }
    // 瞬间条位于 #swup-container 之外，Swup 换页不替换该 DOM、也不重执行本脚本，
    // 因此全站仅首屏初始化一次；data-cloned/data-rendered 标记保证幂等，
    // 避免重复克隆与重复渲染。
  })();
</script>
