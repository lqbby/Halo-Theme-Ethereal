---
// 魔改轴前台覆盖启动脚本（mods：宽屏 / 卡片纹理 / 卡片外壳 / 整页底纹）。
//
// 消费 #config-carrier 的 4 个 data-*-default（后台默认值）+ localStorage（访客偏好），
// 在可见内容解析前把 <html> 上的 mods 作用域类应用好。首帧不依赖本脚本 —— 服务端
// 已由两个外壳的 <html th:classappend> 算好默认类，本脚本只做「访客覆盖」。
//
// 调用位置（两处必须都挂，且紧跟在 <ConfigCarrier /> 之后）：
//   1. src/layouts/Layout.astro   —— 主题页外壳
//   2. src/pages/layout.astro     —— 插件页外壳（th:fragment 契约）
// ⚠️ 抽成组件而非复制：两份失步会让插件页与主题页行为不一致。
// ⚠️ body 不被 Swup 替换，本脚本仅首载执行一次即可（无需换页重执行）。
// ⚠️ is:inline 必须显式声明：否则 Astro 会当模块打包进 bundle，脚本不再紧随
//    配置载体同步执行，访客覆盖就会晚一拍。
//
// ── 与上游的关系（合并说明）────────────────────────────────────────────
// 上游 v2.0.0 自带一套「访客样式」内联脚本（标签页级：外观 / 壁纸 / 特效），写在
// 两个外壳的 <body> 里，本组件**不碰它**。这里只负责上游没有的 mods 轴。
// 本地 1.5.66 原版 VisitorStyleBoot 还包含「卡片样式 / 透明设置 / 壁纸模式 /
// 壁纸设置」四项分项覆盖，与上游标签页级面板功能重叠 ⇒ 暂未迁回，待面板取舍
// 决策后处理（完整原版见 tag `backup-1.5.66` 的 src/components/VisitorStyleBoot.astro）。
---

<script is:inline>
  (function () {
    // localStorage 安全访问：禁存储环境读取/删除会抛 SecurityError，裸调会中断
    // 整段覆盖逻辑（超时 / 隐私模式）。
    var storageGet = function (k) {
      try {
        return localStorage.getItem(k);
      } catch (e) {
        return null;
      }
    };

    var carrier = document.getElementById("config-carrier");
    if (!carrier) return;
    var d = carrier.dataset;
    var root = document.documentElement;

    // 四个 mods 轴各自独立：后台默认值（data-*-default）打底，访客偏好覆盖。
    // mods.enable 总闸已在服务端参与计算，客户端不重复判。
    var apply = function (key, cls, defaultValue) {
      var stored = storageGet(key);
      var on = stored == null ? defaultValue : stored === "true";
      root.classList.toggle(cls, on);
    };

    apply("pageWide", "mods-page-wide", d.pageWideDefault !== "false");
    apply("cardPattern", "mods-card-pattern", d.cardPatternDefault !== "false");
    apply("cardShell", "mods-card-shell", d.cardShellDefault === "true");
    apply("pagePattern", "mods-page-pattern", d.pagePatternDefault !== "false");
  })();
</script>
