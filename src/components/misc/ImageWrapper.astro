---
interface Props {
  id?: string;
  src: string;
  class?: string;
  alt?: string;
  position?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  /** 暗色主题壁纸 URL 的 Thymeleaf 表达式串（如 "${darkSrcX}"），可选；
      传入时在 img 上输出 data-theme-src，由 banner-theme-switch.js 切换 */
  themeSrc?: string;
  /** 暗色主题壁纸的图片位置（object-position），可选；随 data-theme-src 切换 */
  themePosition?: string;
}

const {
  id,
  src,
  alt = "",
  position = "center",
  loading = "lazy",
  fetchpriority = "auto",
  themeSrc,
  themePosition,
} = Astro.props;
const className = Astro.props.class;
const imageStyle = `object-position: ${position}`;
---

<div id={id} class:list={[className, "overflow-hidden relative"]}>
  <div
    class="pointer-events-none absolute inset-0 bg-opacity-50 transition dark:bg-black/10"
  >
  </div>
  <img
    th:src={src}
    th:alt={alt}
    th:style={`|object-position: ${position}|`}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    class="h-full w-full object-cover"
    style={imageStyle}
    alt=""
    {...themeSrc
      ? {
          "th:attr": `data-theme-src=${themeSrc}${
            themePosition ? `,data-theme-position=${themePosition}` : ""
          }`,
        }
      : {}}
  />
</div>
