---
/**
 * 移动端侧边栏（<768px 专用，上游 7e6c87c）：仅当「移动端小组件」列表非空时渲染。
 *
 * 与左右两栏的区别：没有吸顶概念——条目按配置顺序排成一个普通流块，也不吃
 * 「文章页只留前 2 个」的限额（限额/限高规则只写在 md+ 断点里）。
 *
 * 条目不直接渲染、而是放进 <template>：template 内容与其内联脚本都不执行，桌面端
 * 不会为「只在移动端用」的小部件白跑请求；只有移动端断点下才由下面的内联脚本克隆挂载
 * （克隆 + appendChild 插入的 <script> 会执行，innerHTML 插入的不会）。挂载成功才给
 * <html> 加 has-mobile-sidebar（Layout.astro / MainGridLayout 据此在移动端隐藏左右两栏）；
 * 脚本没跑（禁用 JS / 报错）时类不存在，移动端照旧显示两栏，不会白屏。
 * 挂载是一次性的：侧栏在 Swup 容器之外，换页不重建、不重复请求。
 *
 * ⚠️ 挂载脚本必须 is:inline 且紧贴 template：Astro 处理过的脚本会变成 defer 模块，
 * 挂载被推迟到解析结束，移动端会先闪一下左右两栏。
 * 位置放在两个 aside 之后：小部件可同时配在桌面列表与移动端列表（各脚本按实例作用域取元素），
 * DOM 位置只决定视觉顺序。
 *
 * v1.7.35：个人简介 / 公告在桌面上**不是小部件列表项**——它们由左右侧栏按各自设置
 * 直出的「定位卡」（SideBar/RightSideBar 首部，见 settings 的「个人简介小组件」组）。
 * 移动端侧栏替代两栏后若只渲染 mobileWidgets，这两块会整块消失（用户报「移动端
 * 个人简介不显示，这个应该是默认就有的」）。故这里默认在首位按同语义渲染；
 * 若列表里已含同名条目（上游旧配置可能会）则跳过，避免重复。
 */
import Announcement from "./Announcement.astro";
import Profile from "./Profile.astro";

const widgetSwitchReplace = "~{::widgetSwitch(${widget}, ${widgetStat.index})}";
---

<div
  th:with="mobileWidgets=${theme.config?.sidebar?.widgetsConfig?.mobileWidgets}"
  th:remove="tag"
>
  <div
    th:if="${mobileWidgets != null and not #lists.isEmpty(mobileWidgets)}"
    th:remove="tag"
  >
    <aside
      id="mobile-sidebar"
      class="onload-animation col-span-2 hidden w-full md:hidden"
    >
    </aside>

    <template id="mobile-sidebar-template">
      <div class="mb-4 flex w-full flex-col gap-4">
        <!-- 个人简介：与桌面同语义（按「个人简介小组件」设置在首位直出，不参与
             列表排序）；列表已含 profile 条目时跳过防重复（见文件头 v1.7.35 说明） -->
        <div
          th:if="${theme.config?.sidebar?.profile?.enable_profile != false and #lists.isEmpty(mobileWidgets.?[value == 'profile'])}"
          class="contents"
        >
          <Profile class="onload-animation" />
        </div>
        <!-- 公告：同上（「! = false」= 缺省视为开启，与 SideBar.astro 口径一致） -->
        <div
          th:if="${theme.config?.sidebar?.announcement?.enable != false and #lists.isEmpty(mobileWidgets.?[value == 'announcement'])}"
          class="contents"
        >
          <Announcement class="onload-animation" />
        </div>
        <div class="contents" th:each="widget, widgetStat : ${mobileWidgets}">
          <div th:replace={widgetSwitchReplace}></div>
        </div>
      </div>
    </template>

    <script is:inline>
      (function () {
        var host = document.getElementById("mobile-sidebar");
        var template = document.getElementById("mobile-sidebar-template");
        if (!host || !template) return;
        var query = window.matchMedia("(max-width: 767.98px)");

        function mount() {
          if (!query.matches || host.dataset.mounted === "true") return;
          host.dataset.mounted = "true";
          // 先挂内容再显示：否则会闪一下空侧栏
          host.appendChild(template.content.cloneNode(true));
          document.documentElement.classList.add("has-mobile-sidebar");
          host.classList.remove("hidden");
        }

        mount();
        // 桌面 → 移动（拖窄 / 转屏）时补挂一次；移动 → 桌面不卸载，交给 md:hidden 收起
        if (query.addEventListener) query.addEventListener("change", mount);
      })();
    </script>
  </div>
</div>
