---
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
  style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;
const COLLAPSED_HEIGHT = "7.5rem";
const COLLAPSE_THRESHOLD = 20;
---

<div
  class="contents"
  th:with={`tags = \${tagFinder.listAll()}, isCollapsed = \${#lists.size(tags) >= ${COLLAPSE_THRESHOLD}}`}
>
  <WidgetLayout
    name="标签"
    nameKey="widget.tags.title"
    id="tags"
    collapseExpression="isCollapsed"
    collapsedHeight={COLLAPSED_HEIGHT}
    class={className}
    style={style}
  >
    <div class="flex flex-wrap gap-2 pl-3">
      <a
        th:each="tag : ${tags}"
        th:href="@{${tag.status.permalink}}"
        th:title="${tag.spec.displayName}"
        th:style="|color: ${tag.spec.color ?: 'var(--primary)'}; border-color: color-mix(in srgb, ${tag.spec.color ?: 'var(--primary)'} 35%, transparent); background: color-mix(in srgb, ${tag.spec.color ?: 'var(--primary)'} 12%, transparent)|"
        class="tag-chip inline-flex h-8 items-center rounded-lg border px-3 text-sm font-medium transition hover:-translate-y-0.5"
        th:text="${tag.spec.displayName}"
      >
        Tag
      </a>
    </div>
  </WidgetLayout>
</div>

<style is:global>
  /* 侧边栏标签胶囊：颜色跟随标签配置（tag.spec.color），hover 上浮 + 同色光晕 */
  .tag-chip {
    transition:
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.2s ease,
      filter 0.2s ease;
  }
  .tag-chip:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 12px -4px color-mix(in srgb, currentColor 45%, transparent);
    filter: saturate(1.15);
  }
  .tag-chip:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
