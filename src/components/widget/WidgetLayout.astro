---
interface Props {
  id: string;
  name?: string;
  nameKey?: string;
  nameExpression?: string;
  isCollapsed?: boolean;
  collapseExpression?: string;
  collapsedHeight?: string;
  class?: string;
  style?: string;
  noOverflow?: boolean;
}

const {
  id,
  name,
  nameKey,
  nameExpression,
  isCollapsed = false,
  collapseExpression,
  collapsedHeight = "7.5rem",
  style,
  noOverflow = false,
} = Astro.props;
const className = Astro.props.class;
const hasRuntimeCollapse = Boolean(collapseExpression);
const collapseCondition = collapseExpression
  ? `\${${collapseExpression}}`
  : undefined;
// 三元必须整体位于 ${} 内：写成 `${expr} ? 'a' : ''` 时三元落在 SpEL 之外，
// 会被 Thymeleaf 当字面量原样输出，导致折叠样式彻底失效。
const collapseClassAppend = collapseExpression
  ? `\${${collapseExpression} ? 'collapsed' : ''}`
  : undefined;
const collapseDataAttr = collapseExpression
  ? `data-is-collapsed=\${${collapseExpression}}`
  : undefined;
const titleText = nameExpression
  ? `\${${nameExpression}}`
  : nameKey
    ? `#{${nameKey}}`
    : undefined;
// style 未传时 Astro 会渲染成字面量 style="undefined; ..."。仅在有值时输出。
const styleAttr = style || undefined;
// 折叠高度：原先用 <style define:vars> 会把 --collapsedHeight 写到组件子树内
// 每一个带 scope 属性的元素上（div/span/button…），单页重复上百次。
// 改为直接挂在 .collapse-wrapper 上。仅「可能折叠」的小组件才需要该变量，
// 其余组件（天气/一言/统计…）一律不输出，单页属性数进一步降到个位数。
const canCollapse = isCollapsed || hasRuntimeCollapse;
const collapseStyleAttr = canCollapse
  ? `--collapsedHeight: ${collapsedHeight}`
  : undefined;
---

<widget-layout
  data-id={id}
  data-is-collapsed={String(isCollapsed && !hasRuntimeCollapse)}
  th:attr={collapseDataAttr}
  class:list={["card-base pb-4", { "overflow-visible": noOverflow }, className]}
  style={styleAttr}
>
  <div
    class="relative mb-2 ml-8 mt-4 text-lg font-bold text-neutral-900 transition before:absolute before:left-[-16px] before:top-1/2 before:h-4 before:w-1 before:-translate-y-1/2 before:rounded-md before:bg-(--primary) dark:text-neutral-100"
    th:text={titleText}
  >
    {name}
  </div>
  <div
    id={id}
    th:classappend={collapseClassAppend}
    style={collapseStyleAttr}
    class:list={[
      "collapse-wrapper px-2.5 overflow-hidden",
      { "!overflow-visible": noOverflow },
      { collapsed: isCollapsed && !hasRuntimeCollapse },
    ]}
  >
    <slot />
  </div>
  {
    (isCollapsed || hasRuntimeCollapse) && (
      <div class="expand-btn -mb-2 px-4" th:if={collapseCondition}>
        <button class="btn-plain h-9 w-full rounded-lg" type="button">
          <div class="-translate-x-2 flex items-center justify-center gap-2 text-(--primary)">
            <span class="icon-[material-symbols--more-horiz] text-[1.75rem]" />
            <span th:text="#{common.more}">More</span>
          </div>
        </button>
      </div>
    )
  }
</widget-layout>

<style>
  .collapsed {
    height: var(--collapsedHeight);
  }
</style>

<!-- widget-layout 自定义元素已全局注册于 src/scripts/app.ts，
     不在此处内联，避免注册脚本随组件渲染位置（如公告被 th:if 隐藏）而丢失 -->
