---
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
  style?: string;
}

const className = Astro.props.class;
// 未传时保持 undefined（Astro 会把 undefined 渲染成字面量 style="undefined"）
const style = Astro.props.style || undefined;
---

{
  /* 访客计数（Moe-Counter 小组件）
     - 默认「原版模式」：直接渲染 Moe-Counter 的主题 SVG（如 moebooru 的看板娘数字）。
       该 SVG 是自包含的——数字贴图以 base64 GIF 内嵌在 <defs> 里，约 6.5KB，零外部图片请求。
       用 counter_theme 可切服务端任意主题（moebooru / 3d-num / miku / capoo-1 …）
     - 可选「自绘模式」：counter_theme = native 时用主题 token（--primary / --deep-text）
       自绘数字方块，不带看板娘，风格更克制
     - ⭐ counter_source 决定「数字从哪来」：
       · moe（默认）= Moe-Counter 自己的计数（每渲染一次 +1，服务端存库）
       · site        = Halo 站点统计（siteStatsFinder.getStats().visit），
                       与「站点统计」小组件的「访问量」**同一来源**，两个小组件数字必然一致；
                       看板娘/人物贴片仍由 Moe-Counter 主题渲染 —— Moe-Counter 的 /get/@id
                       支持 `num` 参数：num>0 时**只渲染、不写库、不自增**（已实测），
                       所以数字可外部注入而人物动画原样保留。
                       注意 num=0 会被服务端当作「无 num」→ 回落成自增，故 visit 为 0 时不带该参数。
     - ⭐⭐ counter_source = site 时**不再直接请求主题图**，改走「贴片精灵模式」（1.5.24 起）：
       数字仍由本站 SSR 出（零请求），字形则用 Moe-Counter 的 `@demo` 端点一次取回、本地拼。
       为什么必须用 @demo：`/get/@:id` 一律带 `cache-control: no-store`（**每次页面加载都重拉**），
       而服务端对内置调试名 `demo` 有特判 `res.set("cache-control", "max-age=31536000")`；
       @demo 返回的正是「10 个字形并排」的 SVG（`<use x="cellW * d">` 顺序 0→9，字形是
       base64 GIF 内嵌在 <defs>）⇒ 天生就是一张**URL 恒定、可缓存一年**的精灵图，
       用 background-position 就能切出任一位数字。
       净效果：首访 1 个请求（moebooru 约 10.9KB gzip），**之后每次导航 0 个外部请求**
       （连 304 都没有）—— 比「直接拉主题图」按十次导航算省约 76%。
       任何环节失败（超时 / 解析不到字形 / 非 200）都自动回落到服务端主题图，行为与旧版一致。
       注意：@demo 的体积随主题变化（moebooru 16KB / asoul 33KB / capoo-1 76KB / miku 99KB），
       位数多的大主题首访成本更高 —— 这是「之后永久 0 请求」的一次性代价。
     - 性能：img 走 loading=lazy + 视口懒加载；贴片精灵同样等进入视口才请求；
       自绘模式另有 sessionStorage 每会话一次的缓存
     - 配置：侧栏小组件的 counter_api / counter_name / counter_theme / counter_source（见 settings.yaml）

     ⚠️ th:with 里变量不能互相引用（Thymeleaf 用旧 context 逐个求值），
     所以 moeVisit 里把「来源」表达式重复写了一遍，而不是引用同一 th:with 的 moeSource。 */
}
<div
  class="contents"
  th:with="
    moeApi=${widget?.counter_api ?: 'https://moe.lqbby.com:1443'},
    moeName=${widget?.counter_name ?: 'lqbby'},
    moeTheme=${widget?.counter_theme ?: 'moebooru'},
    moeVisit=${(widget?.counter_source ?: 'moe') == 'site' and siteStatsFinder != null ? siteStatsFinder.getStats()?.visit : null}"
>
  <WidgetLayout
    id="moe-counter"
    name="访客计数"
    nameKey="widget.moeCounter.title"
    class={className}
    style={style}
  >
    <div
      id="moe-counter-root"
      class="moe-cnt-root"
      th:attr="data-api=${moeApi}, data-name=${moeName}, data-theme=${moeTheme}, data-num=${moeVisit != null ? moeVisit : ''}"
    >
      <!-- 原版模式：服务端主题 SVG（可含看板娘贴图） -->
      <img
        id="moe-counter-img"
        class="moe-cnt-img"
        alt="访客计数"
        loading="lazy"
        decoding="async"
        th:alt="#{widget.moeCounter.title}"
      />
      <!-- 贴片精灵模式：数字来自站点统计（SSR 出），字形由 @demo 精灵图本地拼（见脚本注释） -->
      <div id="moe-counter-sprite" class="moe-cnt-sprite" role="img" hidden>
      </div>
      <!-- 自绘模式：主题 token 渲染的数字方块（counter_theme = native 时启用） -->
      <div id="moe-counter-digits" class="moe-cnt-digits" hidden></div>
      <div class="moe-cnt-caption">
        <span
          class="moe-cnt-caption-icon icon-[material-symbols--visibility-outline-rounded]"
        ></span>
        <span th:text="#{widget.moeCounter.caption}">本站累计访问</span>
      </div>
      <div
        id="moe-counter-error"
        class="moe-cnt-error"
        hidden
        th:text="#{widget.moeCounter.error}"
      >
        计数器加载失败
      </div>
    </div>
  </WidgetLayout>
</div>

<script is:inline th:inline="none">
  (function () {
    var SESSION_PREFIX = "moe-cnt-session-";
    var LAST_PREFIX = "moe-cnt-last-";

    function readStore(store, key) {
      try {
        return store.getItem(key);
      } catch (e) {
        return null;
      }
    }

    function writeStore(store, key, val) {
      try {
        store.setItem(key, val);
      } catch (e) {}
    }

    function showError(root) {
      var err = document.getElementById("moe-counter-error");
      if (err) err.hidden = false;
      root.setAttribute("data-state", "error");
    }

    // ---- 自绘模式：逐位渲染成「里程表」小方块 ----
    function renderDigits(digitsEl, num) {
      var text = String(num);
      if (!/^\d+$/.test(text)) return false;
      var frag = document.createDocumentFragment();
      for (var i = 0; i < text.length; i++) {
        var span = document.createElement("span");
        span.className = "moe-cnt-digit";
        span.textContent = text.charAt(i);
        span.style.animationDelay = i * 45 + "ms";
        frag.appendChild(span);
      }
      digitsEl.innerHTML = "";
      digitsEl.appendChild(frag);
      return true;
    }

    // num 有值时（counter_source = site）：数字来自站点统计，直接渲染即可，
    // 不必再请求 Moe-Counter —— 顺带避免 /record 自增污染计数器
    function initNativeMode(root, imgEl, digitsEl, api, name, num) {
      root.setAttribute("data-state", "native");
      if (imgEl) imgEl.hidden = true;
      digitsEl.hidden = false;

      if (num && renderDigits(digitsEl, num)) return;

      var sessionKey = SESSION_PREFIX + name;
      var lastKey = LAST_PREFIX + name;

      // 本会话已取过：直接复用，避免同一访客反复 +1
      var sessionVal = readStore(window.sessionStorage, sessionKey);
      if (sessionVal && renderDigits(digitsEl, sessionVal)) return;

      // 先垫上次已知值，避免加载空白
      var lastVal = readStore(window.localStorage, lastKey);
      if (lastVal) renderDigits(digitsEl, lastVal);

      var url = api + "/record/@" + encodeURIComponent(name);
      var ctrl =
        typeof AbortController !== "undefined" ? new AbortController() : null;
      var timer = setTimeout(function () {
        if (ctrl) ctrl.abort();
      }, 6000);

      fetch(url, ctrl ? { signal: ctrl.signal } : undefined)
        .then(function (res) {
          if (!res.ok) throw new Error("HTTP " + res.status);
          return res.json();
        })
        .then(function (data) {
          var num = data && data.num != null ? String(data.num) : "";
          if (!num || !renderDigits(digitsEl, num)) {
            if (!lastVal) showError(root);
            return;
          }
          writeStore(window.sessionStorage, sessionKey, num);
          writeStore(window.localStorage, lastKey, num);
        })
        .catch(function (e) {
          console.warn(
            "[MoeCounter] 获取失败:",
            e && e.message ? e.message : e,
          );
          if (!lastVal) showError(root);
        })
        .then(function () {
          clearTimeout(timer);
        });
    }

    // ---- 贴片精灵模式：数字来自站点统计，字形来自 Moe-Counter 的 @demo 端点 ----
    // 服务端对 `@:id` 一律给 cache-control: no-store（每次页面加载都重拉），
    // 只对内置调试名 `demo` 特判成 max-age=31536000。@demo 返回的正是「10 个字形并排」的
    // SVG（<use x="cellW * d"> 顺序 0→9）⇒ 天生一张「URL 恒定 + 可缓存一年」的精灵图，
    // 靠 background-position 就能切出任一位数字。
    // 于是「数字零请求 + 字形首访一次、之后吃缓存」= 之后每次导航 0 个外部请求。
    var SPRITE_TIMEOUT = 6000; // 超时即回落，别让侧栏空等
    var SPRITE_MAX_H = 120; // 单个字形最大高度（px）：位数变化时高度不会忽大忽小

    // cellW / cellH = 单个字形的原始像素尺寸（取服务端 SVG 里 <image> 的宽高）
    function renderSprite(el, root, text, demoUrl, cellW, cellH) {
      if (!(cellW > 0) || !(cellH > 0)) return false;
      var aspect = cellW / cellH;
      var n = text.length;

      // 撑满可用宽度但不超过 SPRITE_MAX_H：位数再多也不会顶破侧栏
      var cs = window.getComputedStyle ? window.getComputedStyle(root) : null;
      var pad = cs
        ? parseFloat(cs.paddingLeft || 0) + parseFloat(cs.paddingRight || 0)
        : 0;
      var avail = (root.clientWidth || 315) - pad;
      if (!(avail > 0)) avail = 291;
      if (avail > 315) avail = 315; // 与原版 img 的 max-width 对齐
      var h = Math.min(SPRITE_MAX_H, avail / (n * aspect));
      if (!(h > 0)) h = SPRITE_MAX_H;

      el.style.setProperty("--moe-glyph-w", h * aspect + "px");
      el.style.setProperty("--moe-glyph-h", h + "px");
      el.style.setProperty("--moe-sprite", 'url("' + demoUrl + '")');
      // 数字本身是文本语义 ⇒ 整块当一张图报读，里面每位都 aria-hidden
      el.setAttribute("aria-label", text);

      var frag = document.createDocumentFragment();
      for (var i = 0; i < n; i++) {
        var span = document.createElement("span");
        span.className = "moe-cnt-glyph";
        span.setAttribute("aria-hidden", "true");
        // 第 d 位 = 精灵图里第 d 个字形，CSS 用 background-position 左移 d 格
        span.style.setProperty(
          "--moe-glyph-d",
          String(text.charCodeAt(i) - 48),
        );
        frag.appendChild(span);
      }
      el.innerHTML = "";
      el.appendChild(frag);
      return true;
    }

    function initSpriteMode(
      root,
      imgEl,
      digitsEl,
      spriteEl,
      api,
      name,
      theme,
      num,
    ) {
      var demoUrl = api + "/get/@demo?theme=" + encodeURIComponent(theme);
      var finished = false;
      var ctrl =
        typeof AbortController !== "undefined" ? new AbortController() : null;
      var timer = setTimeout(function () {
        if (ctrl) ctrl.abort();
        fallback();
      }, SPRITE_TIMEOUT);

      // 任一环节不顺：退回「服务端主题图」这条老路（组合逻辑与 1.5.23 完全一致）
      function fallback() {
        if (finished) return;
        finished = true;
        clearTimeout(timer);
        spriteEl.hidden = true;
        spriteEl.innerHTML = "";
        console.info("[MoeCounter] @demo 精灵图不可用，回落到服务端主题图");
        initThemeMode(root, imgEl, api, name, theme, num);
      }

      function start() {
        fetch(demoUrl, ctrl ? { signal: ctrl.signal } : undefined)
          .then(function (res) {
            if (!res.ok) throw new Error("HTTP " + res.status);
            return res.text();
          })
          .then(function (svg) {
            if (finished) return;
            clearTimeout(timer);
            // 直接读 <defs> 里第一个 <image> 的宽高 —— 比按 viewBox/10 推算更稳，
            // 也不依赖任何主题的长宽比（换主题不用改代码）
            var tag = /<image\b[^>]*>/.exec(svg);
            var w = tag && /\bwidth="([\d.]+)"/.exec(tag[0]);
            var h = tag && /\bheight="([\d.]+)"/.exec(tag[0]);
            if (!w || !h) throw new Error("拿不到字形尺寸");
            if (
              !renderSprite(
                spriteEl,
                root,
                num,
                demoUrl,
                parseFloat(w[1]),
                parseFloat(h[1]),
              )
            ) {
              throw new Error("渲染失败");
            }
            finished = true;
            root.setAttribute("data-state", "sprite");
            spriteEl.hidden = false;
            if (imgEl) imgEl.hidden = true;
            digitsEl.hidden = true;
          })
          .catch(function (e) {
            console.warn(
              "[MoeCounter] @demo 精灵图失败:",
              e && e.message ? e.message : e,
            );
            fallback();
          });
      }

      // 侧栏在移动端位于首屏之下 ⇒ 与原版 img 的 loading=lazy 等价，别抢带宽
      if (typeof IntersectionObserver === "undefined") {
        start();
        return;
      }
      var io = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              io.disconnect();
              start();
              return;
            }
          }
        },
        { rootMargin: "200px" },
      );
      io.observe(root);
    }

    function initMoeCounter() {
      var root = document.getElementById("moe-counter-root");
      if (!root) return;
      var imgEl = document.getElementById("moe-counter-img");
      var digitsEl = document.getElementById("moe-counter-digits");
      if (!digitsEl) return;

      // 归一化服务地址：兼容旧配置里「带 /get/@id?theme=... 后缀」的写法。
      // 不裁的话会拼成 .../get/@lqbby?theme=X/get/@lqbby?theme=X ——
      // 主题参数变成垃圾值，服务端回落默认主题，切 counter_theme 会静默失效。
      var api = String(root.getAttribute("data-api") || "")
        .trim()
        .replace(/\/get\/@.*$/i, "")
        .replace(/[?#].*$/, "")
        .replace(/\/+$/, "");
      var name = String(root.getAttribute("data-name") || "");
      var theme = String(root.getAttribute("data-theme") || "moebooru").trim();
      // 站点统计注入的数字：必须是正整数才用（num=0 会被服务端当成「无 num」→ 回落自增）
      var num = String(root.getAttribute("data-num") || "").trim();
      if (!/^\d+$/.test(num) || Number(num) <= 0) num = "";
      if (!api || !name) {
        showError(root);
        return;
      }

      if (theme === "native") {
        initNativeMode(root, imgEl, digitsEl, api, name, num);
        return;
      }

      // counter_source = site（num 有值）⇒ 走贴片精灵，顺带把「每次导航重拉主题图」彻底去掉
      var spriteEl = document.getElementById("moe-counter-sprite");
      if (num && spriteEl) {
        initSpriteMode(root, imgEl, digitsEl, spriteEl, api, name, theme, num);
        return;
      }

      initThemeMode(root, imgEl, api, name, theme, num);
    }

    // ---- 原版模式：加载服务端主题 SVG（自包含，含看板娘贴图）----
    function initThemeMode(root, imgEl, api, name, theme, num) {
      if (!imgEl) return;
      root.setAttribute("data-state", "theme");
      imgEl.hidden = false;
      imgEl.addEventListener("load", function () {
        root.setAttribute("data-state", "ready");
      });
      imgEl.addEventListener("error", function () {
        console.warn("[MoeCounter] 主题图片加载失败:", theme);
        showError(root);
      });
      imgEl.src =
        api +
        "/get/@" +
        encodeURIComponent(name) +
        "?theme=" +
        encodeURIComponent(theme) +
        (num ? "&num=" + num : "");
    }

    window.__themeLazyInit("moe-counter-root", initMoeCounter);
  })();
</script>

<style is:global>
  /* 类名统一 moe-cnt- 前缀，避免与主题既有规则冲突
     （is:global 是必需的：自绘模式的数字节点由 JS 动态创建，拿不到 Astro scoped 的 data-astro-cid-*） */
  .moe-cnt-root {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.75rem 0.6rem;
  }

  /* ---- 原版模式：主题 SVG ---- */
  .moe-cnt-img {
    display: block;
    width: 100%;
    max-width: 315px;
    height: auto;
    aspect-ratio: 315 / 100; /* 未加载前先占位，避免布局跳动 */
    margin: 0 auto;
    color: transparent; /* 加载失败时不显示 alt 文本破版 */
  }
  .moe-cnt-img[hidden] {
    display: none !important;
  }

  /* 原版 SVG 内部用 prefers-color-scheme 自降亮度；「站点暗色 + 系统亮色」这种
     错配场景它不会降，这里补一刀，保证深色卡片上不刺眼
     （贴片精灵的 SVG 同样带那段 media query ⇒ 两个模式要同一套补偿，别只改一处） */
  @media (prefers-color-scheme: light) {
    html.dark .moe-cnt-img,
    html.dark .moe-cnt-glyph {
      filter: brightness(0.62);
    }
  }

  /* ---- 贴片精灵模式：本地拼数字（字形来自 @demo 精灵图，一个 URL 用一年） ---- */
  .moe-cnt-sprite {
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .moe-cnt-sprite[hidden] {
    display: none !important;
  }

  .moe-cnt-glyph {
    width: var(--moe-glyph-w, 3rem);
    height: var(--moe-glyph-h, 6.6rem);
    background-image: var(--moe-sprite, none);
    background-repeat: no-repeat;
    /* 整张图 = 10 个等宽字形并排 ⇒ 按 10 倍字形宽铺开，再左移 d 格切出第 d 位 */
    background-size: calc(var(--moe-glyph-w, 3rem) * 10)
      var(--moe-glyph-h, 6.6rem);
    background-position: calc(
        var(--moe-glyph-w, 3rem) * var(--moe-glyph-d, 0) * -1
      )
      0;
  }

  /* ---- 自绘模式：数字方块 ---- */
  .moe-cnt-digits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem;
  }
  .moe-cnt-digits[hidden] {
    display: none !important;
  }

  .moe-cnt-digit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.7rem;
    height: 2.2rem;
    padding: 0 0.35rem;
    border-radius: 0.6rem;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--primary);
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--primary) 22%, transparent),
      color-mix(in oklab, var(--primary) 6%, transparent)
    );
    border: 1px solid color-mix(in oklab, var(--primary) 26%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, #fff 20%, transparent),
      0 2px 8px color-mix(in oklab, var(--primary) 13%, transparent);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
    animation: moe-cnt-in 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .moe-cnt-digit:hover {
    transform: translateY(-2px) scale(1.04);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, #fff 28%, transparent),
      0 6px 14px color-mix(in oklab, var(--primary) 24%, transparent);
  }

  .moe-cnt-digit.is-empty {
    min-width: 2.6rem;
    color: color-mix(in oklab, var(--deep-text) 42%, transparent);
  }

  /* ---- 说明与错误态 ---- */
  .moe-cnt-caption {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    line-height: 1;
    color: color-mix(in oklab, var(--deep-text) 62%, transparent);
  }

  .moe-cnt-caption-icon {
    font-size: 0.95rem;
  }

  .moe-cnt-root[data-state="error"] .moe-cnt-caption {
    display: none;
  }

  .moe-cnt-error {
    font-size: 0.75rem;
    line-height: 1;
    color: color-mix(in oklab, var(--deep-text) 55%, transparent);
  }
  .moe-cnt-error[hidden] {
    display: none !important;
  }

  @keyframes moe-cnt-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.86);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moe-cnt-digit {
      animation: none;
    }
  }
</style>
