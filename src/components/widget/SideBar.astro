---
import Announcement from "./Announcement.astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tags from "./Tags.astro";
import SidebarTOC from "./SidebarTOC.astro";

interface Props {
  class?: string;
  /** 当前页是否为带目录的页面（文章页），由 MainGridLayout 按路由传入 */
  showToc?: boolean;
  "th:classappend"?: string;
}

const className = Astro.props.class;
const showToc = Astro.props.showToc || false;
const thClassappend = Astro.props["th:classappend"] || "";
// 小组件分派片段的引用表达式：片段在 WidgetSwitch.astro 定义一次（全站一套），
// 这里只留一行引用，条目配置与索引以参数传入（index 用于 music/weather 的入场错峰）
const widgetSwitchReplace = "~{::widgetSwitch(${widget}, ${widgetStat.index})}";

/**
 * 吸顶前缀规则（上游 7e6c87c）：条目「未勾选吸顶」且它前面所有条目也都未勾选时，
 * 才归入不吸顶区；前面一旦出现过勾选吸顶的条目，后面的未勾选条目一律回退为吸顶。
 * 判定写作「前缀中未勾选吸顶的条目数 == 当前下标」——前缀规则下与「前面没有勾选项」等价。
 * 选择器 .?[] 内部只引用 #this，不触上下文变量，规避 SpringEL 7 在列表选择/投影内
 * 解析上下文变量抛 EL1008E 的坑（同 archives.astro 顶部注释）。
 */
const nonStickyExpr = `widget.sticky == false and widgets.subList(0, widgetStat.index).?[#this.sticky == false].size() == widgetStat.index`;
const nonStickyIf = `\${${nonStickyExpr}}`;
const stickyIf = `\${not (${nonStickyExpr})}`;
// 不吸顶区只可能是一段前缀，故「列表首项不吸顶」即代表该区有内容
const hasNonStickyIf = `\${widgets != null and not #lists.isEmpty(widgets) and widgets[0].sticky == false}`;
// 左栏目录卡片：目录位置配置为 left、且非两栏布局（两栏继续用 #toc-container 悬浮目录）
const tocEnabledExpr =
  "theme.config?.post == null or theme.config?.post?.toc?.enable_toc == null or theme.config?.post?.toc?.enable_toc";
const tocIf = showToc ? `\${tocOnLeft and (${tocEnabledExpr})}` : "false";
---

<aside
  id="sidebar"
  class:list={[className, "w-full"]}
  th:classappend={thClassappend}
>
  <div
    th:with="widgets=${theme.config?.sidebar?.widgetsConfig?.widgets}, tocOnLeft=${theme.config?.post?.toc?.position == 'left' and theme.config?.layout?.pageLayout?.layoutMode != 'two-column'}"
    th:remove="tag"
  >
    {
      /* ===== 不吸顶区：Profile / 公告（现有位置语义不变）+ 勾选「不吸顶」的组件 ===== */
    }
    <div
      th:if="${theme.config?.sidebar?.profile?.enable_profile != false and theme.config?.sidebar?.profile?.display_position != 'right'}"
      class="mb-4 flex w-full flex-col gap-4"
    >
      <Profile />
    </div>
    <div
      th:if="${theme.config?.sidebar?.profile?.enable_profile != false and theme.config?.sidebar?.profile?.display_position == 'right'}"
      class="mb-4 flex w-full flex-col gap-4"
      th:classappend="${theme.config?.layout?.pageLayout?.layoutMode == 'two-column' ? '' : 'xl:!hidden'}"
    >
      <Profile />
    </div>
    {
      /* 公告：非吸顶，Profile 之后、小组件之前；两栏布局时即使设置为右侧也显示在左侧 */
    }
    <div
      th:if="${theme.config?.sidebar?.announcement?.enable != false and (theme.config?.sidebar?.announcement?.position != 'right' or theme.config?.layout?.pageLayout?.layoutMode == 'two-column')}"
      class="mb-4 flex w-full flex-col gap-4"
    >
      <Announcement class="onload-animation" />
    </div>
    {
      /* 公告（position=right，三栏布局）：移动端在左侧栏兜底显示（桌面隐藏，由右侧栏渲染） */
    }
    <div
      th:if="${theme.config?.sidebar?.announcement?.enable != false and theme.config?.sidebar?.announcement?.position == 'right' and theme.config?.layout?.pageLayout?.layoutMode != 'two-column'}"
      class="mb-4 flex w-full flex-col gap-4"
      th:classappend="${'xl:!hidden'}"
    >
      <Announcement class="onload-animation" />
    </div>
    {/* 不吸顶的小组件：正常流，排在吸顶块之前，随页面一起滚走 */}
    <div class="mb-4 flex w-full flex-col gap-4" th:if={hasNonStickyIf}>
      <div
        class="contents"
        th:each="widget, widgetStat : ${widgets}"
        th:if={nonStickyIf}
      >
        <div th:replace={widgetSwitchReplace}></div>
      </div>
    </div>

    {/* ===== 吸顶区 ===== */}
    <div id="sidebar-sticky" class="sticky top-4 flex w-full flex-col gap-4">
      <div
        class="contents"
        th:each="widget, widgetStat : ${widgets}"
        th:if={stickyIf}
      >
        <div th:replace={widgetSwitchReplace}></div>
      </div>
      {/* 默认小组件（新安装主题未保存设置时显示） */}
      <div th:if="${widgets == null}" class="contents">
        <div class="contents"><Categories class="onload-animation" /></div>
        <div class="contents"><Tags class="onload-animation" /></div>
      </div>
      {
        /* 目录槽位（Swup 容器）：无条件渲染，显示条件写在内部 th:if 上。
           ⚠️ 容器必须在每个主题页存在（#82 守卫），漏了会让全站换页 abort */
      }
      <div id="sidebar-toc">
        <div th:remove="tag" th:if={tocIf}>
          <SidebarTOC />
        </div>
      </div>
    </div>
  </div>
</aside>
