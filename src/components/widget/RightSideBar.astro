---
import Announcement from "./Announcement.astro";
import Hitokoto from "./Hitokoto.astro";
import Profile from "./Profile.astro";
import SiteStats from "./SiteStats.astro";
import SidebarTOC from "./SidebarTOC.astro";

interface Props {
  class?: string;
  showToc?: boolean;
  "th:classappend"?: string;
}

const className = Astro.props.class;
const showToc = Astro.props.showToc || false;
const thClassappend = Astro.props["th:classappend"] || "";
// 小组件分派片段的引用表达式（与左栏同源）：片段在 WidgetSwitch.astro 定义一次，
// 条目配置与索引以参数传入（index 用于 music/weather 的入场错峰）
const widgetSwitchReplace = "~{::widgetSwitch(${widget}, ${widgetStat.index})}";

/**
 * 吸顶前缀规则（与左栏同源，详见 SideBar.astro 顶部注释）：不吸顶条目须排在列表最前，
 * 其后条目一律回退吸顶；这里只把 widgets 换成右栏的 rightWidgets。
 */
const nonStickyExpr = `widget.sticky == false and widgets.subList(0, widgetStat.index).?[#this.sticky == false].size() == widgetStat.index`;
const nonStickyIf = `\${${nonStickyExpr}}`;
const stickyIf = `\${not (${nonStickyExpr})}`;
const hasNonStickyIf = `\${widgets != null and not #lists.isEmpty(widgets) and widgets[0].sticky == false}`;
---

<aside
  id="right-sidebar"
  class:list={[className, "w-full", "onload-animation"]}
  th:classappend={thClassappend}
>
  <div
    th:with="widgets=${theme.config?.sidebar?.widgetsConfig?.rightWidgets}"
    th:remove="tag"
  >
    {
      /* ===== 不吸顶区：Profile / 公告（随页面滚动）+ 勾选「不吸顶」的组件 ===== */
    }
    {/* Profile：不吸顶，随页面滚动（两种布局模式一致） */}
    <div
      th:if="${theme.config?.sidebar?.profile?.enable_profile != false and theme.config?.layout?.pageLayout?.layoutMode != 'two-column' and theme.config?.sidebar?.profile?.display_position == 'right'}"
      class="hidden xl:flex w-full flex-col gap-4"
    >
      <Profile />
    </div>
    {/* 公告：非吸顶，Profile 之后、小组件之前 */}
    <div
      th:if="${theme.config?.sidebar?.announcement?.enable != false and theme.config?.sidebar?.announcement?.position == 'right'}"
      class="hidden xl:flex w-full flex-col gap-4"
    >
      <Announcement />
    </div>
    {/* 不吸顶的小组件：正常流，排在吸顶块之前 */}
    <div class="mb-4 flex w-full flex-col gap-4" th:if={hasNonStickyIf}>
      <div
        class="contents"
        th:each="widget, widgetStat : ${widgets}"
        th:if={nonStickyIf}
      >
        <div th:replace={widgetSwitchReplace}></div>
      </div>
    </div>

    {
      /* ===== 吸顶区：功能性小组件吸顶显示。
         ⚠️ 文章页「只留前 2 个」与限高都由 MainGridLayout 的 CSS
         :has(#right-sidebar-toc > *) 承担（侧栏已不是 Swup 容器，服务端裁剪会导致换页后残留上一页形态） */
    }
    <div
      id="right-sidebar-sticky"
      class="sticky top-4 flex w-full flex-col gap-4"
    >
      <div
        class="contents"
        th:each="widget, widgetStat : ${widgets}"
        th:if={stickyIf}
      >
        <div th:replace={widgetSwitchReplace}></div>
      </div>
      {/* 默认右侧小组件（新安装主题未保存设置时显示） */}
      <div th:if="${widgets == null}" class="contents">
        <div class="contents">
          <Hitokoto />
        </div>
        <div class="contents">
          <SiteStats />
        </div>
      </div>
      {
        /* 目录槽位（Swup 容器）：无条件渲染，显示条件写在内部 th:if 上。
           SidebarTOC 是左右两栏共用的目录卡片（含标题 + data-toc-scroll 滚动区）。
           ⚠️ 容器必须在每个主题页存在（#82 守卫），漏了会让全站换页 abort */
      }
      <div id="right-sidebar-toc">
        <div
          th:remove="tag"
          th:if={showToc
            ? "${theme.config?.post == null or theme.config?.post?.toc?.enable_toc == null or theme.config?.post?.toc?.enable_toc}"
            : "false"}
        >
          <SidebarTOC />
        </div>
      </div>
    </div>
  </div>
</aside>
