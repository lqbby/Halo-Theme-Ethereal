---
/*
  页脚随机友链（魔改）

  在页脚空白带排一行随机友情链接 + 「换一批」按钮。

  数据源 = Links 插件的 Finder：`linkFinder.random(N)` 返回「全量友链的乱序列表」
  （插件实现在 LinkPublicQueryServiceImpl#random：先随机取一页、再 Collections.shuffle），
  N 上限 100（插件侧 Assert 校验）。服务端把整池渲进 <template>，前端按视口挑 N 条渲染，
  点「换一批」在本地重抽 —— 全程零网络请求，也不依赖任何需要鉴权的 REST 接口。

  ⚠️ 本组件在 MainGridLayout 中被渲染两次（桌面版在 #swup-container 内、移动版在持久区），
     因此容器一律用 class 选择、绝不能加 id；脚本用 data-ffl-ready 做逐实例幂等守卫
     （Swup 换页后脚本会重新执行，见 scripts/assets/footer-friend-links.ts）。
  ⚠️ settings.yaml 的 footer.friendLinks.count 只影响宽屏条数；窄屏（<lg）固定只显示前 4 条，
     由 CSS 的 .footer-friend-chip--extra 控制，不做重抽（避免缩放窗口时整排链接乱跳）。
  ⚠️ 门控写在最外层 th:if、linkFinder 求值写在内层 th:with：同标签 th:if(3) 先于 th:with(4)
     执行，变量拿不到；且插件未装时 linkFinder 不存在，必须由外层 th:if 拦住不求值。
*/
---

<!-- 门控：魔改总开关 + Links 插件 + 逐项开关 -->
<div
  th:if="${(theme.config?.mods?.enable == null ? true : theme.config?.mods?.enable) and pluginFinder.available('PluginLinks') and theme.config?.footer?.friendLinks?.enable != false}"
  th:remove="tag"
>
  <!-- 作用域：一次求值友链池（乱序全量） -->
  <div th:with="fflPool=${linkFinder?.random(100)}" th:remove="tag">
    <div
      class="footer-friend-links"
      th:attr="data-friend-count=${theme.config?.footer?.friendLinks?.count != null ? theme.config?.footer?.friendLinks?.count : 8}"
    >
      <!-- 友链池：不直接展示，仅供脚本读取（<template> 内容不渲染、不进无障碍树） -->
      <template class="footer-friend-pool">
        <a
          th:each="ffl : ${fflPool}"
          th:if="${ffl?.spec != null and not #strings.isEmpty(ffl?.spec?.url) and not #strings.isEmpty(ffl?.spec?.displayName)}"
          class="footer-friend-source"
          th:href="${ffl.spec.url}"
          th:attr="data-friend-name=${ffl.spec.displayName},data-friend-logo=${ffl.spec.logo}"
        ></a>
      </template>

      <!-- 组件外壳：脚本就绪后才显示；无 JS 或池子为空时整块保持隐藏。
           DOM 顺序 = 标题 → 换一批 → 网格：标题与按钮占首行两端，网格整行铺开。
           ⚠️ 本块只做「填进身份行下方那条原有空白带」，四周间距全靠既有 padding，
              不新增顶部间距、也不改动身份行任何 class。 -->
      <div class="footer-friend-bar" hidden>
        <span class="footer-friend-title">
          <span
            class="footer-friend-title-icon icon-[material-symbols--diversity-3-rounded]"
            aria-hidden="true"></span>
          <span th:text="#{footer.friendLinks}">友情链接</span>
        </span>
        <button
          type="button"
          class="footer-friend-shuffle btn-regular"
          th:title="#{footer.friendLinksShuffle}"
          th:aria-label="#{footer.friendLinksShuffle}"
        >
          <span
            class="footer-friend-shuffle-icon icon-[material-symbols--refresh-rounded]"
            aria-hidden="true"></span>
        </button>
        <div class="footer-friend-list"></div>
      </div>
    </div>
  </div>
</div>

<!-- 渲染脚本：随组件走（页脚在 MainGridLayout 里渲染两份 → 本标签也会出现两次）。
     重复引入无害：同 URL 走缓存，且脚本内部按容器 data-ffl-ready 逐实例幂等，
     换页后由 Swup page:view 重新初始化被替换的那份。 -->
<script
  src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/footer-friend-links.js?v=${ASSET_VERSION}`}
  defer></script>
