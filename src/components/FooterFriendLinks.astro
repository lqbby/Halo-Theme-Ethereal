---
// 页脚友情链接卡片墙（**随机版**，2026-09-14 改造）。由 Footer.astro 渲染在页脚
// 分隔线之下、版权信息之上；整块是 <nav> 地标（aria-label 复用标题词条），
// 样式见文件末尾的 is:global 块。
//
// 数据链路（改动前必读）：
//   · **链接列表不再由 Thymeleaf 直出**。改为客户端调「Ethereal 配套」插件的随机
//     端点 GET /apis/api.recent-comments.halo.run/v1alpha1/friends/random?size=N，
//     由插件在服务端随机挑 N 条返回（见插件 EtherealFriendsRandomEndpoint）。
//     好处：① 每次进页/换页都是不同的一批；② 页脚体积与友链总数无关。
//   · 脚本 public/assets/footer-friends.js（源码 src/scripts/assets/footer-friends.ts），
//     由 MainGridLayout.astro 按同一开关条件下发（脚本本身幂等，见其头部注释）。
//
// 所以本模板只负责三件事：
//   1) 门控：插件在 + 总开关开，否则整块不输出；
//   2) 头部：标题 / 申请按钮 / **总数**（总数仍走 linkFinder 直出，无 JS 也准确）；
//   3) 输出**空**列表容器（带 data-hbf-endpoint / data-hbf-size）+ 「更多」箭头。
//
// ⚠️ 四条必须遵守的约束：
//   ① 门控顺序：th:if（优先级 300）先于同元素 th:with（400）执行 ⇒ 开关关闭时
//      hbfGroupedLinks 不会求值、也就不会触发一次链接查询。顺序不能调换。
//   ② hbfGroupedLinks 只用于**算总数**（url 过滤口径与旧版一致：网址为空 /
//      非 http、//、/ 开头的整条剔除）。旧版的「截断偏移 / 卡片渲染」逻辑已随
//      随机化一并删除，故不再需要 subList 切片。
//   ③ #aggregates.sum(...) 返回 BigDecimal，集合为空时返回 null（不是 0），
//      故 hbfTotal 必须自己空集合兜底。
//   ④ 一页里有**两份**页脚（桌面版在 #swup-container 内、移动版在外），本组件
//      两份都会渲染 ⇒ 脚本按 data-hbf-endpoint 去重、只发一次请求。
//
// 两种形态（2026-09-13 新增 compact）：
//   - 默认（standalone）：页脚分隔线之下的独立块，居中、纵向三行（标题/列表/更多）。
//   - compact=true：嵌进「卡片页脚」的顶行中间空白处。由 Footer.astro 传 prop 控制。
//     紧凑形态保留「小标题 + 申请按钮 + 内联胶囊列表」，CSS 变量收窄尺寸贴合卡片行高。
const { compact = false } = Astro.props as { compact?: boolean };

// 「Ethereal 配套」插件的随机友链端点（CustomEndpoint，GroupVersion 见插件源码）。
// 页面内静态路由，不随主题 base 变化（Halo 在站点根挂 /apis）。
const FRIENDS_ENDPOINT =
  "/apis/api.recent-comments.halo.run/v1alpha1/friends/random";
---

<nav
  th:if="${pluginFinder.available('PluginLinks') && pluginFinder.available('ethereal-companion') && theme.config?.footer?.friendLinks?.enable_friend_links == true}"
  class:list={["hbf-root w-full", compact && "hbf-compact"]}
  th:aria-label="#{footer.friendLinks.title}"
  aria-label="友情链接"
  th:classappend="${theme.config?.footer?.friendLinks?.is_home_only == true ? ' hbf-home-only' : ''}"
  th:with="
    hbfGroupedLinks = ${linkFinder.groupBy().![links.?[spec.url != null and (spec.url.startsWith('http') or spec.url.startsWith('//') or spec.url.startsWith('/'))]]},
    hbfTotal = ${#lists.isEmpty(hbfGroupedLinks) ? 0 : #aggregates.sum(hbfGroupedLinks.![size()])},
    hbfMaxItems = ${#strings.isEmpty(theme.config?.footer?.friendLinks?.max_items) ? 0 : #conversions.convert(theme.config?.footer?.friendLinks?.max_items, 'java.lang.Integer')}"
>
  <div class="hbf-head">
    <!-- 标题图标：与侧边栏「作者信息 → 社交媒体」按钮同款风格。
         社交按钮是 .btn-regular size-10 rounded-lg（淡色底 + 主题色图标），
         这里复用同两个变量 --btn-regular-bg / --btn-content，
         因此颜色与侧边栏天然一致，且深色模式由 :root.dark 自动切换。
         用内联 SVG + fill="currentColor"：Ethereal 不加载图标字体，
         <i class="fa ..."> 之类的写法在本主题永远不会显示。 -->
    <span class="hbf-head-icon" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
      >
        <path
          fill="currentColor"
          d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
        ></path>
      </svg>
    </span>
    <span class="hbf-title" th:text="#{footer.friendLinks.title}">友情链接</span
    >
    <!-- 申请按钮：固定跳转官方 Links 插件的 /links 路由，文案复用友链页的 i18n 词条。
         show_apply_btn 缺省视为开启（与主题其它可选开关的 != false 口径一致）；
         总开关 enable_friend_links 则用 == true 严格比较——它必须显式开启，
         避免「设置里存了 friendLinks 组但没存该字段」的老配置被误判为已开启。
         按钮文字已可见，不再加与之重复的 title。 -->
    <a
      class="hbf-apply"
      th:if="${theme.config?.footer?.friendLinks?.show_apply_btn != false}"
      th:href="@{/links}"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M12 5v14"></path>
        <path d="M5 12h14"></path>
      </svg>
      <span th:text="#{page.links.applyTitle}">申请友链</span>
    </a>
    <!-- 数量徽标：视觉上仍是原来的纯数字，数字对屏幕阅读器隐藏，
         改由 sr-only 文本念出完整口径（总数，而非本页显示条数）。 -->
    <span class="hbf-count">
      <span aria-hidden="true" th:text="${hbfTotal}">0</span>
      <span
        class="sr-only"
        th:text="#{footer.friendLinks.countLabel(${hbfTotal})}"
        >共 0 个友情链接</span
      >
    </span>
  </div>
  <!-- 列表容器：**刻意留空**，条目由 footer-friends.js 调配套插件的随机端点填入
       （见文件顶部说明）。三个属性是脚本的契约：
         · data-hbf-endpoint：端点地址（脚本靠它去重 + 发起请求）
         · data-hbf-size：随机条数；0 ⇒ 不带 size 参数，用插件侧配置的默认条数
         · th:if hbfTotal > 0：一条友链都没有时不输出空列表（头部仍显示，与旧版一致） -->
  <div
    class="hbf-list"
    th:if="${hbfTotal > 0}"
    data-hbf-endpoint={FRIENDS_ENDPOINT}
    th:data-hbf-size="${hbfMaxItems}"
  >
    <!-- 「更多」箭头：2026-09-13 起**并入胶囊行**（原来是独立一行）。
         作为 flex 行的最后一个子项，它会自动跟在最后一个胶囊后面，换行时也自然跟随。
         ⚠️ 它由**服务端**直出（条件 = 总数 > 随机条数），脚本只负责把随机条目
             insertBefore 到它前面 —— 所以 data-hbf-more 是必须的锚点，别删。 -->
    <a
      class="hbf-more-btn"
      data-hbf-more
      th:if="${hbfMaxItems > 0 and hbfTotal > hbfMaxItems}"
      th:href="@{/links}"
      th:title="#{footer.friendLinks.moreTitle(${hbfTotal})}"
      th:aria-label="#{footer.friendLinks.moreAria}"
    >
      <span class="hbf-more-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </span>
    </a>
  </div>
  <!-- 无 JS（或端点取不到）时的兜底入口：列表为空，但「全部友链」仍可达 -->
  <noscript>
    <p class="mt-2 text-xs text-50">
      <!-- 复用「更多」的无障碍词条（= 查看全部友链），不新增 i18n key -->
      <a th:href="@{/links}" th:text="#{footer.friendLinks.moreAria}"
        >查看全部友链</a
      >
    </p>
  </noscript>
</nav>

<style is:global>
  /* ===== 页脚友情链接卡片墙（.hbf- 前缀，全部复用主题变量，深浅色自动适配） ===== */
  .hbf-root {
    display: block;
    width: 100%;
    min-width: 0;
    /* 上方间距由页脚分隔线的 margin-bottom（my-10 = 2.5rem）提供：
       分隔线与本块是相邻块级兄弟，垂直 margin 会折叠，这里再写 margin-top 不生效，
       故不再声明。下方 0.5rem 与页脚内部行距对齐，让卡片墙融入页脚的行节奏。 */
    margin-bottom: 0.5rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* ---- 「仅在首页显示」：由 body.is-home 单一控制 ----
     body.is-home 由服务端输出首帧初值（Astro isHomePage），运行期每个 Swup
     page:view 由 syncHomeClass 按路径重算（见 utils/banner-sync.ts），
     因此首帧与无刷新换页都准确。非首页时卡片墙整块不显示。 */
  body:not(.is-home) .hbf-root.hbf-home-only {
    display: none;
  }

  /* ---- 标题行 ----
     三行共用同一条竖直中轴（head / list / more 全部居中），
     视觉上成为一个整体而非三块拼贴。 */
  .hbf-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 0.875rem;
  }
  .hbf-title {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--deep-text);
  }
  /* 标题图标：复用 --btn-regular-bg / --btn-content，与侧边栏社交按钮同款
     （同为淡色圆角方块 + 主题色图标），深色模式由 :root.dark 自动切换。 */
  .hbf-head-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.375rem;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
  }
  .hbf-head-icon svg {
    display: block;
    width: 1rem;
    height: 1rem;
  }
  .hbf-apply {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    height: 1.375rem;
    padding: 0 0.5rem;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .hbf-apply:hover {
    background: color-mix(in oklab, var(--primary) 24%, transparent);
  }
  .hbf-apply:active {
    transform: scale(0.96);
  }
  .hbf-apply svg {
    width: 0.6875rem;
    height: 0.6875rem;
  }
  .hbf-count {
    padding: 0.05rem 0.4rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 700;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    /* 与标题间距略大一点，避免「申请友链 14」被读成一个词组 */
    margin-left: 0.125rem;
  }

  /* ---- 卡片列表 ---- */
  .hbf-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* 与标题行的间距由 .hbf-head 的 margin-bottom 统一给出，
       这里不再写 margin-top（否则两处叠加、间距翻倍）。 */
    width: 100%;
  }
  .hbf-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 14rem;
    height: 2rem;
    padding: 0 0.625rem;
    border: 1px solid color-mix(in oklab, var(--primary) 15%, transparent);
    border-radius: 0.625rem;
    background: var(--card-bg);
    color: var(--deep-text);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .hbf-item:hover {
    background: var(--btn-card-bg-hover);
    border-color: color-mix(in oklab, var(--primary) 40%, transparent);
    color: var(--primary);
  }
  /* 悬浮位移接入主题 card-hover-lift 开关（后台「样式开关」+ 访客面板），
     颜色/描边反馈保留恒定，不受该开关影响 */
  @media (min-width: 768px) {
    body.card-hover-lift-enabled .hbf-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 14px
        color-mix(in oklab, var(--primary) 18%, transparent);
    }
  }
  /* logo 统一为正圆：源图长宽比五花八门（方形 / 长条 / 椭圆），
     统一裁成圆形才不会出现「有的圆有的扁」的杂乱感。
     圆形比圆角方块更弱化自身轮廓，让一排胶囊的「文字」成为视觉主角。 */
  .hbf-logo,
  .hbf-logo-ph {
    flex: 0 0 auto;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 9999px;
    background: var(--btn-regular-bg);
  }
  .hbf-logo {
    display: block;
    object-fit: cover;
  }
  .hbf-logo-ph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
  }
  .hbf-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- 「更多」：被 max_items 截断时显示的箭头，**并入胶囊行**（2026-09-13）
     它现在是 .hbf-list 的最后一个 flex 子项，不再是独立块 ⇒ 无外间距、
     尺寸与 .hbf-item 对齐（同高 2rem / compact 下 1.75rem），
     这样换行时它看起来就是「最后一个胶囊」。 */
  .hbf-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.1875rem;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.5rem;
    border: 1px dashed color-mix(in oklab, var(--primary) 32%, transparent);
    border-radius: 9999px;
    background: transparent;
    color: color-mix(in oklab, var(--primary) 80%, var(--deep-text));
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .hbf-more-btn:hover {
    background: color-mix(in oklab, var(--primary) 10%, transparent);
    border-color: color-mix(in oklab, var(--primary) 55%, transparent);
    color: var(--primary);
  }
  /* 箭头图标：悬停时轻微下移，暗示「向下/进入更多」 */
  .hbf-more-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }
  .hbf-more-icon svg {
    width: 100%;
    height: 100%;
  }
  .hbf-more-btn:hover .hbf-more-icon {
    transform: translateY(1px);
  }

  /* ---- 键盘焦点可见性：与主题其它交互元素一致（photos 页同款 outline） ---- */
  .hbf-item:focus-visible,
  .hbf-apply:focus-visible,
  .hbf-more-btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* ===== compact 形态：嵌进「卡片页脚」顶行中间空白（2026-09-13） =====
     设计目标：像「本来就在卡片里」，而不是「塞进来的一块」。
     手法：① 尺寸整体收一档（贴合卡片内 0.875rem 的行节奏）
           ② **三排统一居中**（标题行 / 胶囊行 / 箭头）—— 2026-09-13 LQ 明确要求，
              修改说明见下方注释（原先判断「卡片顶行是 flex 行、居中会漂浮」是错的：
              友链块自带 flex-1 撑满中间列，在它**自己的列宽内**居中反而更稳，
              真正造成漂浮感的是「上两排左对齐 + 箭头单独居中」那种轴不统一）
           ③ 去掉与卡片重复的纵向大留白，间距交给父级的 flex gap
           ④ 标题字号降到 0.8125rem、去掉强字重，退居「小标签」层级
     响应式：宽度靠 flex-1 + min-w-0 自适应；窄屏时由父级 flex-col 自然折到下一行。 */
  .hbf-compact {
    margin-bottom: 0;
    text-align: center;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .hbf-compact .hbf-head {
    justify-content: center;
    gap: 0.35rem;
  }
  .hbf-compact .hbf-head-icon {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 0.3125rem;
  }
  .hbf-compact .hbf-head-icon svg {
    width: 0.875rem;
    height: 0.875rem;
  }
  .hbf-compact .hbf-title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  /* 卡片内空间有限：申请按钮与数量徽标都缩小一档 */
  .hbf-compact .hbf-apply {
    height: 1.25rem;
    padding: 0 0.4375rem;
    font-size: 0.625rem;
  }
  .hbf-compact .hbf-apply svg {
    width: 0.625rem;
    height: 0.625rem;
  }
  .hbf-compact .hbf-count {
    font-size: 0.625rem;
    padding: 0.02rem 0.35rem;
  }
  .hbf-compact .hbf-list {
    justify-content: center;
    gap: 0.375rem;
  }
  .hbf-compact .hbf-item {
    height: 1.75rem;
    gap: 0.3125rem;
    max-width: 11rem;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    border-radius: 0.5rem;
  }
  .hbf-compact .hbf-logo,
  .hbf-compact .hbf-logo-ph {
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
  }
  /* 箭头与胶囊同高（它已并入 .hbf-list，高度需跟 .hbf-item 对齐） */
  .hbf-compact .hbf-more-btn {
    min-width: 1.75rem;
    height: 1.75rem;
  }
  /* 卡片内不再保留纵向大留白（standalone 版的 margin-bottom 是为独立块与列表拉开距离） */
  .hbf-compact .hbf-head {
    margin-bottom: 0.5rem;
  }
</style>
