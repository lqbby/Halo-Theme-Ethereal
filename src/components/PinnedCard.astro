---
/**
 * 置顶精选宽卡（PinnedCard）—— 列表页第 1 页的置顶文章专用形态。
 *
 * 设计来源：对齐 AIOVTUE 主题「周刊首篇」那种「左图右文宽卡 + 底部一行 meta」的信息结构
 * （40/60 分栏、整卡可点、hover 上浮 + 阴影），但**视觉全部用本主题的 token 重做**：
 *   · 表面 = card-base（--card-bg + --radius-large），环/光晕一律走 **box-shadow 而非 border**
 *     （加 border 会改盒模型尺寸；本仓历史坑见 PostList.astro 置顶高亮注释）；
 *   · 文字层级沿用 text-90 / text-75 / text-50 三档；
 *   · 置顶徽章沿用 PostMeta 的「pinboard 图标 + 主色 10% 底」语言；
 *   · 封面交互沿用 PostCard 的「遮罩变暗 + chevron 放大淡入」语言。
 *
 * ⚠️ 为什么不做成「网格里跨 2 列」：本主题有 3 种访客可切换的布局（列表/网格/瀑布流），
 *    瀑布流下卡片由 post-list-layout.js 绝对定位并写死 width/height 行内样式 ——
 *    跨列卡会与 JS 计算互相干扰。故本卡渲染在 #post-list-container **之外**
 *    （见 PostList.astro 的 .post-pinned-item），对三种布局与瀑布流 JS 零影响。
 *
 * ⚠️ 本组件依赖外层 th:each 提供的 `post` 变量（与 PostCard 同款契约）。
 */
import { imageSuffixThWith } from "../utils/image-suffix";
---

<article
  class="post-pinned-item onload-animation"
  th:with="pinnedCoverEmpty = ${#strings.isEmpty(post.spec.cover)}"
  th:style="|animation-delay: var(--content-delay)|"
>
  <!-- 整卡一个 <a>：可点区域最大化（与 AIOVTUE featured 卡同做法）。
       focus-visible 描边直接落在同一个元素上，无需 :has()。 -->
  <a
    class="post-pinned-card card-base group relative grid w-full overflow-hidden"
    th:href="@{${post.status.permalink}}"
    th:aria-label="${post.spec.title}"
    th:classappend="${pinnedCoverEmpty ? ' no-cover' : ' has-cover'}"
  >
    <!-- ① 封面（桌面在左，占 38% 宽；移动端在上，16:9） -->
    <span class="post-pinned-card-cover" th:unless="${pinnedCoverEmpty}">
      <span class="post-pinned-card-veil"></span>
      <span class="post-pinned-card-arrow">
        <span class="post-pinned-card-arrow-chip">
          <span
            class="icon-[material-symbols--chevron-right-rounded] text-4xl leading-none"
          ></span>
        </span>
      </span>
      <!-- 宽度 800：封面在本卡占列表宽度的约 38%（桌面可达 ~700 CSS px），
           请求 800 既够 1x 清晰、也不至于把原图整张拉下来；provider='none' 时
           util 会自动不加后缀（原图）。 -->
      <img
        th:src="|${post.spec.cover}${suffix}|"
        th:alt="${post.spec.title}"
        th:with={imageSuffixThWith("800")}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="post-pinned-card-img"
      />
    </span>
    <!-- ①' 无封面：主题色渐变占位（沿用 PostCard 的占位语言） -->
    <span
      class="post-pinned-card-cover post-pinned-card-cover-empty"
      th:if="${pinnedCoverEmpty}"
    >
      <span
        class="icon-[material-symbols--pinboard] text-5xl leading-none text-(--primary)"
      ></span>
    </span>

    <!-- ② 正文（桌面在右，占 62%） -->
    <span class="post-pinned-card-body">
      <span class="post-pinned-card-title" th:text="${post.spec.title}"
        >Post title</span
      >

      <span class="post-pinned-card-excerpt" th:text="${post.status.excerpt}"
        >Excerpt</span
      >

      <!-- ③ 底部一行：置顶徽章 + 日期 + 统计（置顶徽章位置对齐参考设计，
           样式沿用 PostMeta 的主色语言） -->
      <span
        class="post-pinned-card-foot"
        th:with="wordCount = ${pluginFinder != null and pluginFinder.available('extra-api', '3.*') ? extraApiStatsFinder.getPostWordCount({name: post.metadata.name}) : 0}"
      >
        <span class="post-pinned-badge">
          <span class="icon-[material-symbols--pinboard] text-base leading-none"
          ></span>
          <span class="leading-none" th:text="#{post.pinned}">置顶</span>
        </span>

        <span class="post-pinned-meta">
          <span
            class="icon-[material-symbols--calendar-today-outline-rounded] text-base leading-none"
          ></span>
          <span
            class="leading-none"
            th:text="${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}"
            >2026-01-01</span
          >
        </span>

        <span class="post-pinned-meta" th:if="${post.stats != null}">
          <span
            class="icon-[material-symbols--visibility-outline-rounded] text-base leading-none"
          ></span>
          <span class="leading-none" th:text="${post.stats.visit}">0</span>
        </span>

        <span class="post-pinned-meta" th:if="${post.stats != null}">
          <span class="icon-[mdi--comment-text-outline] text-base leading-none"
          ></span>
          <span class="leading-none" th:text="${post.stats.comment}">0</span>
        </span>

        <span class="post-pinned-meta" th:if="${wordCount > 0}">
          <span
            class="icon-[material-symbols--description-outline-rounded] text-base leading-none"
          ></span>
          <span class="leading-none" th:text="${wordCount}">0</span>
          <span class="post-pinned-meta-unit leading-none">字</span>
        </span>

        <!-- 右侧「阅读全文」：只在 hover 时亮起，与封面 chevron 呼应（桌面） -->
        <span class="post-pinned-readmore">
          <span class="leading-none" th:text="#{post.readMore}">阅读全文</span>
          <span
            class="icon-[material-symbols--arrow-right-alt-rounded] text-base leading-none"
          ></span>
        </span>
      </span>
    </span>
  </a>
</article>

<style is:global>
  /* ===== 置顶精选卡 =====
     ⚠️ 全部写在 .post-pinned-card 类下（组件级），不碰 #post-list-container 的既有置顶
     高亮规则 —— verify-pinned-card.mjs 对那几条有硬断言（清单/网格/瀑布流三种布局下
     描边光晕必须一致，且不得用 border）。本卡在容器之外，故可自由用 box-shadow 做环。 */
  .post-pinned-item {
    margin-bottom: 1rem;
  }

  .post-pinned-card {
    /* 桌面：左图右文 40/60（与参考设计一致）。
       封面是「填满左列」，列越窄裁得越狠 ⇒ 配合正文的高度节流，封面区域接近 4:3。 */
    grid-template-columns: minmax(0, 40%) minmax(0, 1fr);
    align-items: stretch;
    text-decoration: none;
    /* 环 + 光晕：box-shadow 不占盒模型空间（见文件头注释） */
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--primary) 30%, transparent),
      0 6px 22px color-mix(in oklab, var(--primary) 9%, transparent);
    transition:
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }

  /* hover：上浮 2px + 环加粗 + 光晕变亮（对齐参考设计的 translateY(-2px) + shadow） */
  .post-pinned-card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--primary) 55%, transparent),
      0 10px 30px color-mix(in oklab, var(--primary) 18%, transparent);
  }

  /* active：按下去「回位 + 微缩」，给出实体按压感 */
  .post-pinned-card:active {
    transform: translateY(0) scale(0.995);
    transition-duration: 0.08s;
  }

  /* 键盘可达：焦点环独立于鼠标 hover（a11y） */
  .post-pinned-card:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* ---- 封面 ---- */
  .post-pinned-card-cover {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 0;
  }
  .post-pinned-card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 低倍放大：hover 时放 1.05 仍不露边 */
    transform: scale(1.001);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .post-pinned-card:hover .post-pinned-card-img {
    transform: scale(1.05);
  }

  /* 遮罩：hover 变暗，让右侧文字与 chevron 更聚焦 */
  .post-pinned-card-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: transparent;
    transition: background 0.3s ease;
    pointer-events: none;
  }
  .post-pinned-card:hover .post-pinned-card-veil {
    background: rgb(0 0 0 / 0.3);
  }

  /* chevron：与 PostCard 封面同款「缩放淡入」语言。
     ⚠️ 但必须加一层半透明深色圆底 —— 纯白箭头在**浅色封面**上完全看不见
     （本主题 PostCard 的封面箭头就有这个毛病，浅图上一片白）。
     圆底也保证了白箭头在任意封面上都有对比度（对比度不依赖封面内容）。 */
  .post-pinned-card-arrow {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
    pointer-events: none;
  }
  .post-pinned-card-arrow-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.85rem;
    height: 2.85rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.42);
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.28);
    backdrop-filter: blur(2px);
  }
  .post-pinned-card:hover .post-pinned-card-arrow {
    opacity: 1;
    transform: scale(1);
  }

  .post-pinned-card-cover-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--primary) 22%, var(--card-bg)),
      color-mix(in oklab, var(--primary) 6%, var(--card-bg))
    );
  }

  /* ---- 正文 ----
     高度节流：卡片高度由正文决定，而封面是「填满左列」⇒ 正文越高、封面被裁得越狠
     （实测正文 239px 时封面区域 266×239 ≈ 1.11，16:9 的封面只剩中间 63% 宽，图上文字被切）。
     把内边距/行高收到 173px 左右后，封面区域 ≈ 1.54，接近 3:2 的自然比例。 */
  .post-pinned-card-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.15rem 1.5rem;
  }

  .post-pinned-card-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: var(--deep-text);
    transition: color 0.2s ease;
  }
  /* 标题随卡片 hover 变主色：与列表卡片的 hover 语言一致 */
  .post-pinned-card:hover .post-pinned-card-title {
    color: var(--primary);
  }

  .post-pinned-card-excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: color-mix(in oklab, var(--deep-text) 72%, transparent);
  }

  /* ---- 底部一行 ----
     上沿加一道极淡分隔线：正文与 meta 之间本来靠 margin-top:auto 撑开留白，
     加线后这段留白变成「有结构的页脚」，也让「置顶 + 日期 + 数据」一眼成组。 */
  .post-pinned-card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.85rem;
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in oklab, var(--deep-text) 9%, transparent);
    font-size: 0.78rem;
    color: color-mix(in oklab, var(--deep-text) 58%, transparent);
  }

  .post-pinned-badge {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
    border-radius: 0.375rem;
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    padding: 0.25rem 0.5rem;
    font-weight: 700;
    color: var(--primary);
  }

  .post-pinned-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .post-pinned-meta-unit {
    margin-left: -0.2rem;
    font-size: 0.9em;
  }

  /* 「阅读全文」：默认隐藏，hover/focus 时从底部淡入（把「可点」这件事说出来） */
  .post-pinned-readmore {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
    font-weight: 600;
    color: var(--primary);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .post-pinned-card:hover .post-pinned-readmore,
  .post-pinned-card:focus-visible .post-pinned-readmore {
    opacity: 1;
    transform: translateX(0);
  }

  /* ---- 移动端：改为上下结构（封面在上 16:9），与列表卡片一致 ---- */
  @media (max-width: 767.98px) {
    .post-pinned-card {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-pinned-card-cover {
      aspect-ratio: 16 / 9;
    }
    .post-pinned-card-body {
      padding: 1rem 1.15rem 1.15rem;
    }
    .post-pinned-card-title {
      font-size: 1.25rem;
      line-height: 1.45;
    }
    .post-pinned-card-excerpt {
      font-size: 0.85rem;
    }
    /* 触屏没有 hover：直接常显「阅读全文」，否则这个入口在移动端等于不存在 */
    .post-pinned-readmore {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- 减少动态效果：位移/缩放/遮罩过渡全部关闭（无障碍硬要求） ---- */
  @media (prefers-reduced-motion: reduce) {
    .post-pinned-card,
    .post-pinned-card-img,
    .post-pinned-card-veil,
    .post-pinned-card-arrow,
    .post-pinned-card-title,
    .post-pinned-readmore {
      transition: none !important;
    }
    .post-pinned-card:hover,
    .post-pinned-card:active {
      transform: none;
    }
    .post-pinned-card:hover .post-pinned-card-img,
    .post-pinned-card:hover .post-pinned-card-arrow {
      transform: none;
    }
    .post-pinned-card:hover .post-pinned-card-arrow {
      opacity: 1;
    }
  }
</style>
